def _venv_python_candidates() -> List[Path]:
    bin_dir = "Scripts" if os.name == "nt" else "bin"
    names = ("python.exe", "python") if os.name == "nt" else ("python", "python3")
    roots: List[Path] = []
    env = os.environ.get("QOJ_SUBMIT_VENV")
    if env:
        roots.append(Path(env))
    data = os.environ.get("XDG_DATA_HOME")
    if data:
        roots.append(Path(data) / "qoj-xcpc" / "venv")
    else:
        roots.append(Path.home() / ".local" / "share" / "qoj-xcpc" / "venv")
    roots.append(Path(__file__).resolve().parent / ".venv")
    found: List[Path] = []
    for root in roots:
        for name in names:
            found.append(root / bin_dir / name)
    return found


def _maybe_reexec_venv() -> None:
    if os.environ.get("QOJ_SUBMIT_NOVENV"):
        return
    try:
        current = Path(sys.executable).resolve()
    except OSError:
        current = Path(sys.executable)
    for venv_py in _venv_python_candidates():
        if not venv_py.is_file():
            continue
        try:
            if venv_py.resolve() == current:
                return
        except OSError:
            continue
        os.execv(str(venv_py), [str(venv_py), str(Path(__file__).resolve()), *sys.argv[1:]])


_maybe_reexec_venv()

