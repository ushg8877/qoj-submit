def _wait_debug_port(port: int, proc: subprocess.Popen, seconds: float = 20) -> bool:
    deadline = time.time() + seconds
    while time.time() < deadline:
        if proc.poll() is not None:
            return False
        try:
            _cdp_http_json(port, "/json/version")
            return True
        except Exception:
            time.sleep(0.25)
    return False


def _browser_binaries() -> List[Tuple[str, str]]:
    found: List[Tuple[str, str]] = []
    seen = set()
    firefox_paths = [
        "/usr/lib/firefox-esr/firefox",
        "/usr/lib/firefox/firefox",
        "/usr/bin/firefox-esr",
        "/usr/bin/firefox",
        _which("firefox-esr"),
        _which("firefox"),
    ]
    chrome_paths = [
        _which("chromium"),
        _which("chromium-browser"),
        _which("google-chrome-stable"),
        _which("google-chrome"),
        "/usr/bin/chromium",
        "/usr/bin/chromium-browser",
    ]
    ranked: List[Tuple[int, str, str]] = []
    for path in firefox_paths:
        if not path:
            continue
        p = str(Path(path))
        if not Path(p).exists() or p in seen:
            continue
        seen.add(p)
        snap = 1 if "snap" in str(Path(p).resolve()).lower() else 0
        ranked.append((snap, "firefox", p))
    ranked.sort()
    for _, kind, p in ranked:
        found.append((kind, p))
    for path in chrome_paths:
        if not path:
            continue
        p = str(Path(path))
        if Path(p).exists() and p not in seen:
            seen.add(p)
            found.append(("chromium", p))
    return found


