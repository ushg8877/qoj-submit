def is_codeforces(site: str) -> bool:
    host = (urlparse(site if "://" in (site or "") else f"https://{site}").hostname or site or "")
    return "codeforces" in host.lower()


def account_key(site: str) -> str:
    raw = (site or "").strip()
    if not raw:
        return ""
    if "://" not in raw:
        raw = "https://" + raw
    host = (urlparse(raw).hostname or raw).lower()
    if host.startswith("www."):
        host = host[4:]
    return host


def oj_label(site: str) -> str:
    return "Codeforces" if is_codeforces(site) else "QOJ"


def select_oj(name: str) -> str:
    cfg = load_global()
    site = resolve_site(name, cfg)
    cfg["site"] = site
    save_global(cfg)
    ok(f"已选择 {oj_label(site)}  ({site})")
    info("绑定比赛:  ./submit <比赛id>")
    if is_codeforces(site):
        info("Gym:           ./submit gym <比赛id>")
    return site


def cmd_oj(args: argparse.Namespace) -> None:
    name = getattr(args, "name", None)
    if not name:
        cfg = load_global()
        site = (cfg.get("site") or DEFAULT_SITE).rstrip("/")
        ok(f"当前 OJ: {oj_label(site)}  ({site})")
        info("切换:  ./submit qoj   或   ./submit cf")
        return
    select_oj(name)


def resolve_site(raw: Optional[str], cfg: Optional[dict] = None) -> str:
    text = (raw or "").strip().rstrip("/")
    if not text:
        return str((cfg or {}).get("site") or DEFAULT_SITE).rstrip("/")
    alias = SITE_ALIASES.get(text.lower())
    if alias:
        return alias
    if text.startswith("http://") or text.startswith("https://"):
        return text
    if "." in text:
        return "https://" + text
    die(f"未知 OJ: {raw}。可用 qoj / cf，或完整 URL")
    raise AssertionError


def get_account(cfg: dict, site: str) -> dict:
    key = account_key(site)
    acc = ((cfg.get("accounts") or {}).get(key) or {})
    if isinstance(acc, dict) and acc.get("cookie"):
        return dict(acc)
    top = account_key(cfg.get("site") or DEFAULT_SITE)
    if key == top and cfg.get("cookie"):
        return {
            "cookie": str(cfg.get("cookie") or ""),
            "user_agent": str(cfg.get("user_agent") or ""),
            "username": str(cfg.get("username") or ""),
        }
    return dict(acc) if isinstance(acc, dict) else {}


def save_account(cfg: dict, site: str, cookie: str, ua: str, username: str) -> None:
    key = account_key(site)
    accounts = cfg.setdefault("accounts", {})
    if not isinstance(accounts, dict):
        accounts = {}
        cfg["accounts"] = accounts
    accounts[key] = {
        "cookie": cookie,
        "user_agent": ua,
        "username": username,
    }
    cfg["site"] = site
    if not is_codeforces(site):
        cfg["cookie"] = cookie
        cfg["user_agent"] = ua
        cfg["username"] = username
    save_global(cfg)


def parse_cookie_input(raw: str) -> str:
    """Accept a Cookie header, or a JSON object (including 请求 Cookie)."""
    text = (raw or "").strip()
    if text.lower().startswith("cookie:"):
        text = text.split(":", 1)[1].strip()
    if not text:
        return ""
    if text[0] in "{[":
        try:
            data = json.loads(text)
        except json.JSONDecodeError as exc:
            die(f"Cookie JSON 解析失败: {exc}")
        if isinstance(data, list):
            pairs = []
            for item in data:
                if not isinstance(item, dict):
                    continue
                name = str(item.get("name") or "").strip()
                if name and "value" in item and item.get("value") is not None:
                    pairs.append(f"{name}={item['value']}")
            if not pairs:
                die("Cookie JSON 数组里没有 name/value")
            return "; ".join(pairs)
        if isinstance(data, dict) and len(data) == 1:
            only = next(iter(data.values()))
            if isinstance(only, dict) and any(
                k in only
                for k in ("UOJSESSID", "cf_clearance", "uoj_username", "JSESSIONID")
            ):
                data = only
        if not isinstance(data, dict):
            die("Cookie JSON 需要是对象，例如 {\"JSESSIONID\": \"...\"}")
        skip = {"请求 cookie", "request cookie", "cookie"}
        pairs = []
        for key, value in data.items():
            if str(key).strip().lower() in skip:
                continue
            if value is None or isinstance(value, (dict, list)):
                continue
            pairs.append(f"{key}={value}")
        if not pairs:
            die("Cookie JSON 里没有 JSESSIONID / UOJSESSID / cf_clearance 等字段")
        return "; ".join(pairs)
    return text


def cookie_names(header: str) -> Dict[str, str]:
    out: Dict[str, str] = {}
    for part in header.split(";"):
        part = part.strip()
        if not part or "=" not in part:
            continue
        name, value = part.split("=", 1)
        out[name.strip()] = value.strip()
    return out


def _network_error_kind(exc: BaseException) -> str:
    parts = [str(exc)]
    reason = getattr(exc, "reason", None)
    if reason is not None:
        parts.append(str(reason))
    text = " ".join(parts).lower()
    if "handshake" in text:
        return "handshake"
    if isinstance(exc, ssl.SSLError) or isinstance(reason, ssl.SSLError):
        return "handshake"
    if "ssl" in text and ("timed out" in text or "timeout" in text):
        return "handshake"
    if any(
        s in text
        for s in (
            "timed out",
            "timeout",
            "deadline",
            "temporarily",
            "connection reset",
            "connection aborted",
            "broken pipe",
            "unreachable",
        )
    ):
        return "timeout"
    return "other"


class Client:
    def __init__(self, site: str, cookie: str = "", user_agent: str = DEFAULT_UA, debug: bool = False):
        self.site = site.rstrip("/")
        self.user_agent = user_agent or DEFAULT_UA
        self.debug = debug
        self.cookies: Dict[str, str] = {}
        self._conn: Optional[http.client.HTTPSConnection] = None
        self._conn_host = ""
        self._rebuild_opener()
        if cookie:
            self.set_cookie_header(cookie)

    def _rebuild_opener(self) -> None:
        self._drop_conn()
        self._ssl_ctx = ssl.create_default_context()
        self._cffi = None
        self._used_cffi = False

    def _host_needs_impersonate(self, url: str) -> bool:
        host = (urlparse(url).hostname or urlparse(self.site).hostname or "").lower()
        return "codeforces" in host

    def _impersonate_candidates(self) -> List[str]:
        ua = self.user_agent or ""
        if re.search(r"Edg/", ua):
            return ["chrome", "chrome131"]
        if re.search(r"Chrome/", ua) and not re.search(r"Firefox/", ua):
            return ["chrome", "chrome131"]
        return ["firefox", "firefox133"]

    def _cffi_session(self):
        sess = getattr(self, "_cffi", None)
        if sess is not None:
            return sess
        try:
            from curl_cffi import requests as cffi_requests
        except ImportError:
            return None
        last: Optional[BaseException] = None
        for name in self._impersonate_candidates():
            try:
                self._cffi = cffi_requests.Session(impersonate=name)
                if self.debug:
                    print(f"DEBUG impersonate={name}", file=sys.stderr)
                return self._cffi
            except Exception as exc:
                last = exc
                continue
        if self.debug and last:
            print(f"DEBUG curl_cffi impersonate failed: {last}", file=sys.stderr)
        return None

    def _cffi_http_once(
        self,
        url: str,
        data: Optional[bytes],
        extra_headers: Optional[dict],
        method: str,
        sock_timeout: float,
        read_timeout: float,
        follow_redirects: bool = False,
    ) -> Optional[Tuple[int, str, bytes, str]]:
        session = self._cffi_session()
        if session is None:
            return None
        for key, value in self.cookies.items():
            if not key:
                continue
            try:
                session.cookies.set(key, value)
            except Exception:
                pass
        hdrs = {
            "User-Agent": self.user_agent,
            "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
            "Accept-Language": "en-US,en;q=0.9",
        }
        if extra_headers:
            hdrs.update({k: v for k, v in extra_headers.items() if k.lower() not in ("host", "connection")})
        follow = follow_redirects or (data is None and method.upper() == "GET")
        try:
            resp = session.request(
                method,
                url,
                data=data,
                headers=hdrs,
                timeout=(sock_timeout, read_timeout),
                allow_redirects=follow,
            )
        except TypeError:
            try:
                resp = session.request(
                    method,
                    url,
                    data=data,
                    headers=hdrs,
                    timeout=max(sock_timeout, read_timeout),
                    allow_redirects=follow,
                )
            except Exception as exc:
                raise OSError(str(exc)) from exc
        except Exception as exc:
            raise OSError(str(exc)) from exc
        try:
            for key, value in resp.cookies.items():
                if key and value:
                    self.cookies[key] = value
        except Exception:
            pass
        raw_set: List[str] = []
        headers = resp.headers
        if hasattr(headers, "get_list"):
            try:
                raw_set = list(headers.get_list("Set-Cookie") or [])
            except Exception:
                raw_set = []
        if not raw_set:
            single = headers.get("Set-Cookie") if headers is not None else None
            if single:
                raw_set = [single]
        for item in raw_set:
            jar = SimpleCookie()
            try:
                jar.load(item)
            except Exception:
                continue
            for name, morsel in jar.items():
                if morsel.value:
                    self.cookies[name] = morsel.value
        loc = ""
        if not follow:
            loc = headers.get("Location") or headers.get("location") or ""
        final = str(getattr(resp, "url", "") or url)
        self._last_url = final
        ctype = headers.get("Content-Type") or headers.get("content-type") or ""
        raw = resp.content or b""
        if raw[:2] == b"\x1f\x8b":
            try:
                raw = gzip.decompress(raw)
            except Exception:
                pass
        charset = "utf-8"
        m = re.search(r"charset=([^\s;]+)", ctype, re.I)
        if m:
            charset = m.group(1).strip().strip('"')
        elif getattr(resp, "encoding", None):
            charset = str(resp.encoding)
        self._used_cffi = True
        return int(resp.status_code), loc, raw, charset

    def _drop_conn(self) -> None:
        conn = getattr(self, "_conn", None)
        self._conn = None
        self._conn_host = ""
        if conn is not None:
            try:
                conn.close()
            except Exception:
                pass

    def _connection(self, parsed, timeout: float) -> http.client.HTTPSConnection:
        host = parsed.hostname or "qoj.ac"
        port = parsed.port or 443
        key = f"{host}:{port}"
        if self._conn is not None and self._conn_host == key:
            self._conn.timeout = timeout
            if getattr(self._conn, "sock", None) is not None:
                try:
                    self._conn.sock.settimeout(timeout)
                except Exception:
                    pass
            return self._conn
        self._drop_conn()
        conn = http.client.HTTPSConnection(host, port, timeout=timeout, context=self._ssl_ctx)
        self._conn = conn
        self._conn_host = key
        return conn

    def set_cookie_header(self, header: str) -> None:
        header = parse_cookie_input(header)
        self.cookies.update(cookie_names(header))

    def cookie_header(self) -> str:
        return "; ".join(f"{k}={v}" for k, v in self.cookies.items() if k)

    def _absorb_set_cookie(self, headers) -> None:
        raw_list = headers.get_all("Set-Cookie") if hasattr(headers, "get_all") else []
        if not raw_list:
            single = headers.get("Set-Cookie")
            raw_list = [single] if single else []
        for item in raw_list:
            jar = SimpleCookie()
            try:
                jar.load(item)
            except Exception:
                continue
            for name, morsel in jar.items():
                if morsel.value:
                    self.cookies[name] = morsel.value

    @staticmethod
    def _read_body(fp, limit: int = 8 * 1024 * 1024, deadline: Optional[float] = None) -> bytes:
        chunks: List[bytes] = []
        n = 0
        while n < limit:
            if deadline is not None and time.time() > deadline:
                raise TimeoutError("read deadline")
            piece = fp.read(min(65536, limit - n))
            if not piece:
                break
            chunks.append(piece)
            n += len(piece)
        return b"".join(chunks)

    def _http_once(
        self,
        url: str,
        data: Optional[bytes],
        extra_headers: Optional[dict],
        method: str,
        sock_timeout: float,
        read_timeout: float,
        follow_redirects: bool = False,
    ) -> Tuple[int, str, bytes, str]:
        if self._host_needs_impersonate(url):
            got = self._cffi_http_once(
                url, data, extra_headers, method, sock_timeout, read_timeout,
                follow_redirects=follow_redirects,
            )
            if got is not None:
                return got
        parsed = urlparse(url)
        path = parsed.path or "/"
        if parsed.query:
            path += "?" + parsed.query
        hdrs = {
            "Host": parsed.netloc,
            "User-Agent": self.user_agent,
            "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
            "Accept-Language": "en-US,en;q=0.9",
            "Accept-Encoding": "gzip",
            "Connection": "keep-alive",
        }
        cookie = self.cookie_header()
        if cookie:
            hdrs["Cookie"] = cookie
        if extra_headers:
            hdrs.update(extra_headers)
            if cookie and "Cookie" not in extra_headers:
                hdrs["Cookie"] = cookie
        last_err: Optional[BaseException] = None
        for reconnect in range(2):
            conn = self._connection(parsed, sock_timeout)
            try:
                conn.request(method, path, body=data, headers=hdrs)
                resp = conn.getresponse()
                status = resp.status
                loc = resp.getheader("Location") or ""
                ctype = resp.getheader("Content-Type") or ""
                cenc = (resp.getheader("Content-Encoding") or "").lower()
                self._absorb_set_cookie(resp.headers)
                raw = self._read_body(resp, deadline=time.time() + read_timeout)
                if cenc == "gzip" and raw:
                    try:
                        raw = gzip.decompress(raw)
                    except Exception:
                        pass
                charset = "utf-8"
                m = re.search(r"charset=([^\s;]+)", ctype, re.I)
                if m:
                    charset = m.group(1).strip().strip('"')
                self._last_url = url
                return status, loc, raw, charset
            except (BrokenPipeError, ConnectionResetError, RemoteDisconnected) as exc:
                last_err = exc
                self._drop_conn()
                if reconnect == 0:
                    continue
                raise
            except (ssl.SSLError, TimeoutError, socket.timeout, OSError):
                self._drop_conn()
                raise
        raise last_err or OSError("connection failed")

    def _request(
        self,
        url: str,
        data: Optional[bytes] = None,
        headers: Optional[dict] = None,
        method: Optional[str] = None,
        timeout: int = 25,
        retries: int = 1,
        fatal: bool = True,
        follow_redirects: bool = False,
    ) -> Tuple[int, str, str]:
        if not url.startswith("http"):
            url = urljoin(self.site + "/", url.lstrip("/"))
        attempts = max(1, retries + 1)
        last_err: Optional[BaseException] = None
        is_post = data is not None
        method = (method or ("POST" if is_post else "GET")).upper()
        sock_timeout = 12
        current = url
        send_data = data
        send_method = method
        send_post = is_post
        self._last_url = current
        for attempt in range(attempts):
            if self.debug:
                print(f"DEBUG {send_method} {current} (try {attempt + 1}/{attempts})", file=sys.stderr)
            read_timeout = 15 if send_post else max(12, timeout)
            redirects = 0
            try:
                while True:
                    status, loc, raw, encoding = self._http_once(
                        current, send_data, headers, send_method, sock_timeout, read_timeout,
                        follow_redirects=follow_redirects,
                    )
                    final = getattr(self, "_last_url", current) or current
                    if loc:
                        loc = urljoin(current, loc)
                    if status in (301, 302, 303, 307, 308) and loc:
                        if send_post and not follow_redirects:
                            try:
                                text = raw.decode(encoding, errors="replace")
                            except LookupError:
                                text = raw.decode("utf-8", errors="replace")
                            return status, loc, text
                        if redirects >= 5:
                            current = final
                            break
                        current = loc
                        send_method = "GET"
                        send_data = None
                        send_post = False
                        redirects += 1
                        continue
                    current = final
                    break
                try:
                    text = raw.decode(encoding, errors="replace")
                except LookupError:
                    text = raw.decode("utf-8", errors="replace")
                if _is_cloudflare_block(text) and fatal:
                    if "codeforces" in (urlparse(current).hostname or "").lower() and not getattr(
                        self, "_used_cffi", False
                    ):
                        die(
                            "命令行访问 Codeforces 被 Cloudflare 拦截。\n"
                            "请安装能模仿浏览器的库后重试:\n"
                            + _curl_cffi_install_hint()
                        )
                    die(
                        "被 Cloudflare 拦截。请重新执行 ./submit login"
                        "（必须用弹出的 Firefox 过验证，不要用自动化窗口）"
                    )
                return status, current, text
            except (ssl.SSLError, TimeoutError, IncompleteRead, socket.timeout, URLError, OSError) as exc:
                last_err = exc
                kind = _network_error_kind(exc)
                handshake_ok = kind == "handshake"
                can_retry = attempt + 1 < attempts and (
                    handshake_ok or (not send_post and kind in ("handshake", "timeout"))
                )
                if can_retry:
                    if handshake_ok:
                        info(f"TLS 握手超时，正在重试 ({attempt + 2}/{attempts})...")
                    self._rebuild_opener()
                    time.sleep(0.4 * (attempt + 1))
                    current = url
                    send_data = data
                    send_method = method
                    send_post = is_post
                    continue
                if not fatal:
                    raise TimeoutError(str(getattr(exc, "reason", exc))) from exc
                if is_post and not handshake_ok:
                    die(
                        "提交请求超时。代码可能已经交上去了，请先查，不要连点:\n"
                        "  ./submit status"
                    )
                if is_post:
                    die(
                        "提交时 TLS 握手一直超时。代码多半没交上去，请再试一次；\n"
                        "不确定的话先: ./submit status"
                    )
                die(f"网络错误: {getattr(exc, 'reason', exc)}")
        if not fatal:
            raise TimeoutError(str(last_err))
        die(f"请求失败: {url} ({last_err})")
        raise AssertionError

    def get(self, url: str, timeout: int = 15, retries: int = 0, fatal: bool = True) -> Tuple[int, str, str]:
        return self._request(url, timeout=timeout, retries=retries, fatal=fatal)

    def post_form(
        self,
        url: str,
        fields: dict,
        timeout: int = 25,
        referer: Optional[str] = None,
        follow_redirects: bool = False,
    ) -> Tuple[int, str, str]:
        data = urlencode(fields).encode("utf-8")
        headers = {
            "Content-Type": "application/x-www-form-urlencoded",
            "Origin": self.site,
        }
        if referer:
            headers["Referer"] = referer
        return self._request(
            url, data=data, headers=headers, timeout=timeout, retries=2,
            follow_redirects=follow_redirects,
        )

    def post_multipart(
        self,
        url: str,
        fields: Dict[str, str],
        files: Optional[Dict[str, Tuple[str, bytes, str]]] = None,
        timeout: int = 20,
        referer: Optional[str] = None,
        fatal: bool = True,
    ) -> Tuple[int, str, str]:
        boundary = "----XcpcQoj" + uuid.uuid4().hex
        chunks: List[bytes] = []

        def add_field(name: str, value: str) -> None:
            chunks.append(f"--{boundary}\r\n".encode("utf-8"))
            chunks.append(
                f'Content-Disposition: form-data; name="{name}"\r\n\r\n'.encode("utf-8")
            )
            chunks.append(value.encode("utf-8"))
            chunks.append(b"\r\n")

        def add_file(name: str, filename: str, content: bytes, ctype: str) -> None:
            chunks.append(f"--{boundary}\r\n".encode("utf-8"))
            chunks.append(
                (
                    f'Content-Disposition: form-data; name="{name}"; '
                    f'filename="{filename}"\r\n'
                    f"Content-Type: {ctype}\r\n\r\n"
                ).encode("utf-8")
            )
            chunks.append(content)
            chunks.append(b"\r\n")

        for key, value in fields.items():
            add_field(key, value)
        for key, (filename, content, ctype) in (files or {}).items():
            add_file(key, filename, content, ctype)
        chunks.append(f"--{boundary}--\r\n".encode("utf-8"))
        body = b"".join(chunks)
        headers = {
            "Content-Type": f"multipart/form-data; boundary={boundary}",
            "Origin": self.site,
        }
        if referer:
            headers["Referer"] = referer
        return self._request(url, data=body, headers=headers, timeout=timeout, retries=1, fatal=fatal)


def extract_token(page: str) -> str:
    patterns = [
        r'name=["\']_token["\'][^>]*value=["\']([^"\']+)["\']',
        r'value=["\']([^"\']+)["\'][^>]*name=["\']_token["\']',
        r'_token\s*:\s*["\']([^"\']+)["\']',
        r'name="_token"\s+value="([^"]+)"',
    ]
    for pat in patterns:
        m = re.search(pat, page, re.I)
        if m and m.group(1).strip():
            return htmlmod.unescape(m.group(1).strip())
    return extract_csrf(page)


def extract_csrf(page: str) -> str:
    patterns = [
        r'name=["\']csrf_token["\'][^>]*value=["\']([^"\']+)["\']',
        r'name=["\']csrfToken["\'][^>]*value=["\']([^"\']+)["\']',
        r'value=["\']([^"\']+)["\'][^>]*name=["\']csrf_token["\']',
        r'value=["\']([^"\']+)["\'][^>]*name=["\']csrfToken["\']',
        r'<meta[^>]+name=["\']X-Csrf-Token["\'][^>]+content=["\']([^"\']+)["\']',
        r'<meta[^>]+content=["\']([^"\']+)["\'][^>]+name=["\']X-Csrf-Token["\']',
        r'<meta[^>]+name=["\']csrf-token["\'][^>]+content=["\']([^"\']+)["\']',
        r'data-csrf=["\']([^"\']+)["\']',
        r'window\.(?:csrf(?:Token|_token)?|_csrf)\s*=\s*[\'"]([^\'"]+)[\'"]',
        r'csrf(?:_token|Token)?["\']?\s*[:=]\s*["\']([^"\']{16,128})["\']',
    ]
    for pat in patterns:
        m = re.search(pat, page or "", re.I)
        if m and m.group(1).strip() and "function" not in m.group(1).lower():
            return htmlmod.unescape(m.group(1).strip())
    return ""


def extract_alerts(page: str) -> str:
    parts: List[str] = []
    for pat in (
        r'class=["\'][^"\']*alert-danger[^"\']*["\'][^>]*>(.*?)</div>',
        r'class=["\'][^"\']*alert-warning[^"\']*["\'][^>]*>(.*?)</div>',
        r'class=["\'][^"\']*alert[^"\']*["\'][^>]*>(.*?)</div>',
    ):
        for m in re.finditer(pat, page or "", re.I | re.S):
            text = strip_html(m.group(1)).strip()
            if text and text not in parts and len(text) < 300:
                parts.append(text)
    return " / ".join(parts[:3])


def extract_submit_button(page: str) -> Tuple[str, str]:
    m = re.search(
        r"<(?:button|input)\b([^>]*name=[\"']submit-answer[\"'][^>]*)>",
        page or "",
        re.I,
    )
    if m:
        return "submit-answer", _html_attr(m.group(1), "value") or "answer"
    return "submit-answer", "answer"


def extract_username(page: str) -> str:
    """Read the logged-in handle from the navbar, not footer/announcement links.

    QOJ pages always contain /user/profile/Qingyu (site owner). The real account
    sits next to Logout / 登出 in the navigation bar.
    """
    handle = extract_cf_handle(page)
    if handle:
        return handle
    logout_at = [m.start() for m in re.finditer(r'href=["\'][^"\']*/logout["\']', page, re.I)]
    if not logout_at:
        logout_at = [m.start() for m in re.finditer(r">\s*(Logout|登出)\s*<", page, re.I)]
    best = ""
    best_dist = 10**9
    for pm in re.finditer(r"/user/profile/([^\"'/?#<\s]+)", page):
        for pos in logout_at:
            dist = abs(pm.start() - pos)
            if dist < best_dist:
                best_dist = dist
                best = pm.group(1)
    if best and best_dist < 2500:
        return htmlmod.unescape(best)

    nav = re.search(r"<nav\b[^>]*>(.*?)</nav>", page, re.I | re.S)
    if nav:
        names = re.findall(r"/user/profile/([^\"'/?#<\s]+)", nav.group(1))
        if names:
            return htmlmod.unescape(names[0])

    m = re.search(r'data-username=["\']([^"\']+)["\']', page, re.I)
    if m:
        return htmlmod.unescape(m.group(1))
    return ""


def _cf_login_form(page: str) -> bool:
    return bool(
        re.search(r'name=["\']handleOrEmail["\']', page or "", re.I)
        or re.search(r'id=["\']enterForm["\']', page or "", re.I)
    )


def _cf_enter_href(html: str) -> bool:
    """True if this snippet links to the login page /enter, not /contest/123/enter."""
    return bool(
        re.search(
            r"""href=["'](?:https?://[^/"']+)?/enter(?:["'?#]|$)""",
            html or "",
            re.I,
        )
    )


def extract_cf_handle(page: str) -> str:
    """Current user only. Public /profile/tourist links do not count."""
    if _cf_login_form(page):
        return ""
    chooser = _cf_lang_chooser(page)
    if chooser and _cf_enter_href(chooser):
        return ""
    m = re.search(r"""(?:^|[;\s{])handle\s*=\s*["']([^"']*)["']""", page or "")
    if m:
        name = htmlmod.unescape(m.group(1)).strip()
        if name and name.lower() not in ("null", "undefined", "anonymous", "guest"):
            return name
    if not chooser:
        return ""
    names = re.findall(
        r"""href=["'](?:https?://[^/"']+)?/profile/([^"'/?#]+)""",
        chooser,
        re.I,
    )
    names = [htmlmod.unescape(n) for n in names if n and n.lower() not in ("logout",)]
    return names[-1] if names else ""


def extract_cf_handle_from_url(url: str) -> str:
    m = re.search(r"/profile/([^/?#]+)", url or "", re.I)
    if not m:
        return ""
    name = htmlmod.unescape(m.group(1)).strip()
    if name.lower() in ("logout", "enter", "register"):
        return ""
    return name


def _cf_handle_from_firefox_profile(profile: Optional[Path]) -> str:
    if not profile or not profile.is_dir():
        return ""
    pat = re.compile(r"codeforces\.com/profile/([A-Za-z0-9_.-]+)", re.I)
    found: List[str] = []
    places = profile / "places.sqlite"
    if places.is_file():
        try:
            con = sqlite3.connect(f"file:{places}?mode=ro", uri=True, timeout=5)
            try:
                rows = con.execute(
                    "SELECT url FROM moz_places WHERE url LIKE '%codeforces.com/profile/%' "
                    "ORDER BY last_visit_date DESC LIMIT 30"
                ).fetchall()
            finally:
                con.close()
            for (url,) in rows:
                m = pat.search(str(url or ""))
                if m:
                    found.append(m.group(1))
        except sqlite3.Error:
            pass
    for rel in (
        "sessionstore.jsonlz4",
        "sessionstore.js",
        "sessionstore-backups/recovery.jsonlz4",
        "sessionstore-backups/previous.jsonlz4",
        "sessionstore-backups/recovery.baklz4",
    ):
        path = profile / rel
        if not path.is_file():
            continue
        try:
            blob = path.read_bytes()[:3_000_000]
        except OSError:
            continue
        for m in pat.finditer(blob.decode("latin-1", errors="ignore")):
            found.append(m.group(1))
    skip = {"logout", "enter", "register", "tourist"}
    names = [n for n in found if n and n.lower() not in skip]
    if not names:
        return ""
    return max(set(names), key=names.count)


def _cf_lang_chooser(page: str) -> str:
    m = re.search(
        r'class=["\'][^"\']*lang-chooser[^"\']*["\'][\s\S]{0,1200}',
        page or "",
        re.I,
    )
    return m.group(0) if m else ""


def looks_logged_in(page: str, url: str = "", expect: str = "") -> bool:
    host = (urlparse(url).hostname or "").lower()
    cf_page = "codeforces" in host or "codeforces" in (url or "").lower()
    if not cf_page and _cf_lang_chooser(page) and not re.search(
        r'id=["\']form-login["\']', page or "", re.I
    ):
        cf_page = True
    if cf_page:
        if _cf_login_form(page):
            return False
        handle = extract_cf_handle(page)
        if not handle:
            return False
        if expect and handle.lower() != expect.lower():
            return False
        return True
    if re.search(r'id=["\']form-login["\']', page, re.I) or re.search(
        r'id=["\']input-username["\']', page, re.I
    ):
        return False
    if "/login" in (url or "") and re.search(r"<title>[^<]*(Login|登录)", page, re.I):
        return False
    if re.search(r'href=["\'][^"\']*/logout["\']', page, re.I):
        return True
    if re.search(r">\s*(Logout|登出)\s*<", page, re.I):
        return True
    if expect and re.search(
        rf"/user/profile/{re.escape(expect)}(?:['\"/?#<\s]|$)", page
    ):
        return True
    return False


def _html_attr(attrs: str, name: str) -> str:
    m = re.search(
        rf'''(?:^|\s){re.escape(name)}\s*=\s*(?:["']([^"']*)["']|([^\s>]+))''',
        attrs or "",
        re.I,
    )
    if not m:
        return ""
    return htmlmod.unescape((m.group(1) or m.group(2) or "").strip())


def _parse_option_tags(inner: str) -> List[Tuple[str, str]]:
    options: List[Tuple[str, str]] = []
    for om in re.finditer(r"<option\b([^>]*)>(.*?)</option>", inner or "", re.I | re.S):
        attrs, label = om.group(1), strip_html(om.group(2))
        value = _html_attr(attrs, "value")
        if not value:
            value = label
        if "disabled" in attrs.lower() and not value:
            continue
        if value or label:
            options.append((value, label or value))
    return options


def _is_prog_lang_options(options: List[Tuple[str, str]]) -> bool:
    blob = " ".join(f"{v} {l}" for v, l in options).lower()
    return any(
        k in blob
        for k in ("c++", "python", "pypy", "java", "rust", "kotlin", "pascal", "haskell")
    )


def parse_select_options(page: str, name: str) -> List[Tuple[str, str]]:
    want = (name or "").lower()
    want_id = f"input-{want}"
    for sm in re.finditer(r"<select\b([^>]*)>(.*?)</select>", page, re.I | re.S):
        attrs, inner = sm.group(1), sm.group(2)
        nm = _html_attr(attrs, "name").lower()
        sid = _html_attr(attrs, "id").lower()
        if nm == want or sid in (want, want_id):
            return _parse_option_tags(inner)
    return []


def collect_language_options(page: str) -> Tuple[str, List[Tuple[str, str]]]:
    """Find the programming-language <select>, not the statement Languages dropdown."""
    preferred: List[Tuple[str, List[Tuple[str, str]]]] = []
    others: List[Tuple[str, List[Tuple[str, str]]]] = []
    for sm in re.finditer(r"<select\b([^>]*)>(.*?)</select>", page, re.I | re.S):
        attrs, inner = sm.group(1), sm.group(2)
        name = _html_attr(attrs, "name") or "answer_answer_language"
        opts = _parse_option_tags(inner)
        if not opts or not _is_prog_lang_options(opts):
            continue
        if name.lower() == "programtypeid":
            return name, opts
        if "answer" in name.lower() or "language" in name.lower():
            preferred.append((name, opts))
        else:
            others.append((name, opts))
    if preferred:
        preferred.sort(key=lambda x: (0 if "answer" in x[0].lower() else 1, x[0]))
        return preferred[0]
    if others:
        return others[0]
    radios: List[Tuple[str, str]] = []
    radio_name = "answer_answer_language"
    for im in re.finditer(r"<input\b([^>]*)>", page, re.I):
        attrs = im.group(1)
        if _html_attr(attrs, "type").lower() != "radio":
            continue
        name = _html_attr(attrs, "name")
        value = _html_attr(attrs, "value")
        if "language" in name.lower() and value:
            radio_name = name
            radios.append((value, value))
    if radios and _is_prog_lang_options(radios):
        return radio_name, radios
    return "answer_answer_language", []


def pick_language(options: List[Tuple[str, str]], suffix: str, explicit: Optional[str] = None) -> str:
    if not options:
        die("题目页没有语言选项，可能未登录或没有提交表单")
    cleaned = [
        (v, l) for v, l in options if "diagnostic" not in f"{v} {l}".lower()
    ]
    if cleaned:
        options = cleaned
    if explicit:
        want = norm_lang(explicit)
        for value, label in options:
            blob = norm_lang(f"{value} {label}")
            if want in (norm_lang(value), norm_lang(label), blob) or want in blob:
                return value
        names = ", ".join(f"{v} ({l})" if l != v else v for v, l in options)
        die(f"找不到语言 {explicit!r}。可选: {names}")
    prefer = EXT_LANG_PREFER.get(suffix.lower(), [])
    cpp_file = suffix.lower() in {".cpp", ".cc", ".cxx", ".c++"}
    ranked: List[Tuple[int, int, str]] = []
    for value, label in options:
        blob = norm_lang(f"{label} {value}")
        score = 10_000
        for i, pref in enumerate(prefer):
            if pref == blob or blob.startswith(pref) or pref in blob:
                score = i
                break
        if cpp_file and "c++" not in blob:
            score += 5_000
        ver = 0
        vm = re.search(r"(\d+)\.(\d+)", label or "")
        if vm:
            ver = -(int(vm.group(1)) * 100 + int(vm.group(2)))
        ranked.append((score, ver, value))
    ranked.sort()
    return ranked[0][2]


def language_label(options: List[Tuple[str, str]], value: str) -> str:
    for item, label in options:
        if item == value:
            text = (label or value).strip() or value
            if value.isdigit() and text != value:
                return f"{text}  ({value})"
            return text
    return value


def canonical_problem_url(url: str) -> str:
    parsed = urlparse(url)
    path = re.sub(r"/statement/[^/]+/?$", "", parsed.path or "")
    path = re.sub(r"/(?:statistics|hack)/?$", "", path)
    path = path.rstrip("/") or "/"
    return urlunparse((parsed.scheme, parsed.netloc, path, "", "", ""))


def problem_page_candidates(url: str, site: str, contest_id: str, problem_id: str) -> List[str]:
    base = canonical_problem_url(url)
    if not re.search(r"/problem/\d+$", base):
        if contest_id:
            base = f"{site.rstrip('/')}/contest/{contest_id}/problem/{problem_id}"
        else:
            base = f"{site.rstrip('/')}/problem/{problem_id}"
    out: List[str] = []
    for item in (
        base + "?tab=submit-answer",
        f"{base}/submit",
        base + "?tab=submit",
        f"{base}/statement/zh_cn",
        base,
        f"{base}/statement/default",
        f"{base}/statement/en",
        base + "?locale=en",
        f"{site.rstrip('/')}/problem/{problem_id}?tab=submit-answer",
        f"{site.rstrip('/')}/problem/{problem_id}/submit",
        f"{site.rstrip('/')}/problem/{problem_id}",
    ):
        if item not in out:
            out.append(item)
    return out


def iter_submit_hrefs(page: str, current_url: str) -> List[str]:
    found: List[str] = []

    def add(href: str) -> None:
        href = htmlmod.unescape(href or "").strip()
        if not href or href.startswith("javascript:"):
            return
        if href.startswith("#"):
            href = current_url.split("#")[0]
        else:
            href = urljoin(current_url, href).split("#")[0]
        if href not in found:
            found.append(href)

    for href in re.findall(r'href=["\']([^"\']*tab-submit-answer[^"\']*)["\']', page or "", re.I):
        add(href)
    for href in re.findall(r'href=["\']([^"\']+/submit(?:\?[^"\']*)?)["\']', page or "", re.I):
        add(href)
    for href, inner in re.findall(
        r'<a\b[^>]*href=["\']([^"\']+)["\'][^>]*>(.*?)</a>',
        page or "",
        re.I | re.S,
    ):
        text = strip_html(inner).strip().lower()
        if text in ("submit", "提交", "submit!"):
            add(href)
    return found


def extract_form_action(page: str, current_url: str) -> str:
    for m in re.finditer(r"<form\b([^>]*)>(.*?)</form>", page or "", re.I | re.S):
        attrs, body = m.group(1), m.group(2)
        if "submit-answer" not in body and "answer_answer" not in body:
            continue
        action = _html_attr(attrs, "action")
        if not action:
            return current_url.split("#")[0]
        return urljoin(current_url, action).split("#")[0]
    return ""


def parse_contest_problems(
    page: str, site: str, contest_id: str, kind: Optional[str] = None
) -> Dict[str, dict]:
    if is_codeforces(site):
        k = kind or ("gym" if "/gym/" in f"{site}/{page[:1500]}" else "contest")
        return parse_cf_contest_problems(page, site, contest_id, k)
    problems: Dict[str, dict] = {}
    row_re = re.compile(
        r"<tr\b[^>]*>\s*"
        r"<td\b[^>]*>\s*([A-Za-z]{1,2})\s*</td>\s*"
        r"<td\b[^>]*>\s*<a\b[^>]*href=[\"']([^\"']+)[\"'][^>]*>(.*?)</a>",
        re.I | re.S,
    )
    for letter, href, title_html in row_re.findall(page):
        href = htmlmod.unescape(href)
        m = re.search(rf"/contest/{contest_id}/problem/(\d+)", href)
        if not m:
            continue
        pid = m.group(1)
        url = canonical_problem_url(urljoin(site + "/", href))
        problems[letter.upper()] = {
            "id": pid,
            "title": strip_html(title_html) or pid,
            "url": url,
        }

    if problems:
        return problems

    link_re = re.compile(
        rf'href=["\']([^"\']*/contest/{contest_id}/problem/(\d+)[^"\']*)["\'][^>]*>(.*?)</a>',
        re.I | re.S,
    )
    seen = set()
    letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    idx = 0
    for href, pid, title_html in link_re.findall(page):
        if pid in seen:
            continue
        seen.add(pid)
        if idx >= len(letters):
            letter = f"P{idx + 1}"
        else:
            letter = letters[idx]
        idx += 1
        problems[letter] = {
            "id": pid,
            "title": strip_html(title_html) or pid,
            "url": canonical_problem_url(urljoin(site + "/", htmlmod.unescape(href))),
        }
    return problems


def parse_cf_contest_problems(
    page: str, site: str, contest_id: str, kind: str = "contest"
) -> Dict[str, dict]:
    problems: Dict[str, dict] = {}
    kind = kind if kind in ("contest", "gym") else "contest"
    cid = re.escape(str(contest_id))

    def add(letter: str, title_html: str = "") -> None:
        letter = (letter or "").upper()
        if not re.fullmatch(r"[A-Z]{1,2}\d*", letter):
            return
        title = strip_html(title_html)
        title = re.sub(rf"^{re.escape(letter)}\s*[.\-:]\s*", "", title, flags=re.I).strip()
        if not title or title.upper() == letter:
            title = letter
        prev = problems.get(letter)
        if prev and len(str(prev.get("title") or "")) >= len(title) and prev.get("title") != letter:
            return
        problems[letter] = {
            "id": letter,
            "title": title,
            "url": f"{site.rstrip('/')}/{kind}/{contest_id}/problem/{letter}",
        }

    link_re = re.compile(
        rf'href=["\'](?:https?://[^/"\']+)?/(?:{kind}|contest|gym)/{cid}'
        rf'/problem/([A-Za-z][A-Za-z0-9]*)(?:[/?#][^"\']*)?["\'][^>]*>(.*?)</a>',
        re.I | re.S,
    )
    for letter, title_html in link_re.findall(page or ""):
        add(letter, title_html)
    for letter in re.findall(
        rf'/(?:{kind}|contest|gym)/{cid}/problem/([A-Za-z][A-Za-z0-9]*)',
        page or "",
        re.I,
    ):
        add(letter)
    for letter in re.findall(
        rf'/problemset/problem/{cid}/([A-Za-z][A-Za-z0-9]*)',
        page or "",
        re.I,
    ):
        add(letter)
    return problems


