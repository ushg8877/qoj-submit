        warn("没有找到 firefox / chromium / chrome，请先: sudo apt install firefox")
        return None

    info("正在关闭上次登录残留的独立配置浏览器（不会关掉你日常用的 Firefox）...")
    _kill_stale_login_browsers()
    host = account_key(site) or "qoj.ac"
    needles = [host]
    if is_codeforces(site):
        needles = ["codeforces.com", "codeforces.org"]
    elif "qoj" in host:
        needles = [host, "qoj.ac"]

    httpd, captured = _start_ua_sniffer()
    temporary_profiles = []
    try:
        for kind, binary in binaries:
            port = _free_port()
            isolated = True
            if expected:
                profile = _account_browser_profile(kind, site, expected)
            else:
                # Every unnamed login starts a new session. Logging out of a
                # shared browser would invalidate another saved account server-side.
                root = _account_browser_profile(kind, site, "").parent
                root.mkdir(parents=True, exist_ok=True)
                temporary = tempfile.TemporaryDirectory(prefix=f"qoj-submit-profile-{kind}-", dir=root)
                temporary_profiles.append(temporary)
                profile = Path(temporary.name)
            sniff_url = f"http://127.0.0.1:{httpd.server_address[1]}/"
            ff_ua = _firefox_user_agent(binary, profile) if kind == "firefox" else DEFAULT_UA
            info(f"正在打开普通 {kind}")
            info(f"  程序: {binary}")
            info(f"  配置: {profile}")
            if expected:
                info("请在这个账号的独立窗口里完成验证并登录；成功后会自动保存")
            if is_codeforces(site):
                info("请在窗口里完成 Cloudflare，再点右上角 Enter 登录")
                info("不要关那个窗口，登录成功后脚本会自动继续")
                try:
                    import curl_cffi  # noqa: F401
                except ImportError:
                    warn(
                        "未安装 curl_cffi，命令行可能仍被 Cloudflare 拦截。请先:\n"
                        + _curl_cffi_install_hint()
                    )
            else:
                info("不要关那个窗口，登录成功后脚本会自动继续")
            try:
                proc, log_path = _start_real_browser(
                    kind, binary, site, profile, port, extra_url=sniff_url, isolated=isolated
                )
            except Exception as exc:
                warn(f"启动 {binary} 失败: {exc}")
                continue
            keep_browser = not isolated
            try:
                time.sleep(2.0)
                handed_off = keep_browser and proc.poll() is not None
                if proc.poll() is not None and not keep_browser:
                    tail = ""
                    try:
                        tail = log_path.read_text(encoding="utf-8", errors="replace")[-2000:]
                    except OSError:
                        pass
                    warn(f"{kind} 启动后立刻退出。日志:\n{tail or '(无)'}")
                    continue
                if handed_off:
                    info("已在现有 Firefox 中打开标签页")
                cdp_ok = False
                if kind != "firefox":
                    cdp_ok = _wait_debug_port(port, proc)
                deadline = time.time() + 900
                last_cookie, last_ua, last_html = "", captured.get("ua") or ff_ua, ""
                last_hint = 0.0
                while time.time() < deadline:
                    if proc.poll() is not None and not keep_browser:
                        tail = ""
                        try:
                            tail = log_path.read_text(encoding="utf-8", errors="replace")[-1500:]
                        except OSError:
                            pass
                        warn(f"{kind} 窗口已关闭。{tail}")
                        break
                    cookie = ua = html = ""
                    if cdp_ok:
                        try:
                            cookie, ua, html = _cdp_harvest(port)
                        except Exception:
                            cdp_ok = _wait_debug_port(port, proc, seconds=1)
                    if not cookie and kind == "firefox":
                        names = _firefox_sqlite_cookies(profile, needles)
                        cookie = "; ".join(f"{k}={v}" for k, v in names.items())
                    ua = ua or captured.get("ua") or last_ua or ff_ua
                    if cookie and not html and kind == "firefox":
                        try:
                            probe = Client(site, cookie=cookie, user_agent=ua)
                            probe_path = "/enter" if is_codeforces(site) else "/"
                            _, _, html = probe.get(probe_path, timeout=8, retries=0, fatal=False)
                            if html and _is_cloudflare_block(html):
                                html = ""
                        except Exception:
                            html = ""
                    if is_codeforces(site) and _cf_cookie_logged_in(cookie) and not expected:
                        ok(f"已检测到登录 ({account_key(site) or site})")
                        return cookie, ua, html
                    ready = bool(cookie) and _session_ready(cookie, html, site=site)
                    if expected:
                        ready = ready and extract_username(html) == expected
                    if ready:
                        last_cookie, last_ua, last_html = cookie, ua, html or last_html
                        ok(f"已检测到登录 ({account_key(site) or site})")
                        return cookie, ua, html
                    if cookie:
                        last_cookie, last_ua, last_html = cookie, ua, html or last_html
                    now = time.time()
                    if now - last_hint > 12:
                        names = cookie_names(cookie)
                        if is_codeforces(site):
                            if not names:
                                info(f"还没读到 Codeforces Cookie。当前配置: {profile}")
                            elif not names.get("X-User") and not names.get("X-User-Sha1"):
                                info("已读到 Cookie，但还没有登录态。请在窗口右上角点 Enter 登录")
                            else:
                                info("已读到登录 Cookie，正在确认…")
                        elif not (names.get("UOJSESSID") or names.get("__Host-UOJSESSID") or names.get("__Host-UOJREMEMBER")):
                            info("还没读到登录态。请在窗口里登录（含 Cloudflare）")
                        else:
                            info("已读到 Cookie，正在确认…")
                        last_hint = now
                    time.sleep(1.2)
                if _session_ready(last_cookie, last_html, site=site) and (not expected or extract_username(last_html) == expected):
                    return last_cookie, last_ua, last_html
            finally:
                if not keep_browser:
                    try:
                        proc.terminate()
                        try:
                            proc.wait(timeout=5)
                        except subprocess.TimeoutExpired:
                            proc.kill()
                            proc.wait(timeout=5)
                    except Exception:
                        pass
    finally:
        try:
            httpd.shutdown()
        except Exception:
            pass
        for temporary in temporary_profiles:
            temporary.cleanup()
    return None


def login_via_browser(site: str, expected: str = "") -> Tuple[str, str, str]:
    got = _login_real_browser(site, expected)
    if got:
        cookie, ua, html = got
        if is_codeforces(site):
            if looks_logged_in(html, url=site) or _cf_cookie_logged_in(cookie):
                info("已用普通浏览器完成登录")
                return cookie, ua, html
        elif _session_ready(cookie, html, site=site):
            info("已用普通浏览器完成登录")
            return cookie, ua, html
    hint = "python3 submit login cf" if is_codeforces(site) else "python3 submit login"
    die(
        f"未能用普通 Firefox 登录。请关掉弹出窗口后重试:\n"
        f"  {hint}\n"
        "不要用带“自动化控制”提示的窗口。"
    )
    raise AssertionError


def _finalize_login(
    cfg: dict,
    site: str,
    cookie: str,
    ua: str,
    debug: bool,
    fallback_user: str = "",
    expected: str = "",
) -> None:
    cookie = parse_cookie_input(cookie)
    names = cookie_names(cookie)
    client = Client(site, cookie=cookie, user_agent=ua, debug=debug)
    if is_codeforces(site):
        status, url, page = client.get("/enter", fatal=False)
        if _is_cloudflare_block(page):
            try:
                status, url, page = client.get("/", fatal=False)
            except Exception:
                pass
        logged = looks_logged_in(page, url) or _cf_cookie_logged_in(cookie)
        if not logged:
            die(
                "还没有登录 Codeforces。请在弹出窗口右上角点 Enter 登录后，再执行:\n"
                "  python3 submit login cf"
            )
        if _is_cloudflare_block(page) and logged:
            warn("命令行页面仍像 Cloudflare，但浏览器 Cookie 已是登录态，先保存会话")
        username = extract_cf_handle(page) or extract_cf_handle_from_url(url) or fallback_user or ""
        if not username:
            try:
                _, purl, ppage = client.get("/profile", fatal=False)
                username = (
                    extract_cf_handle(ppage)
                    or extract_cf_handle_from_url(purl)
                    or username
                )
            except Exception:
                pass
        if expected and username != expected:
            die(f"实际登录账号是 {username or '(未知)'}，与目标 {expected} 不符；未保存")
        if not username:
            die("未能识别登录账号，未保存会话；请检查网页导航栏")
        save_account(cfg, site, client.cookie_header() or cookie, ua, username)
        ok(f"已登录 {username or '(未知用户)'} @ {site}")
        info(f"配置保存在 {global_config_path()}")
        return
    expect = names.get("uoj_username") or fallback_user or ""
    status, url, page = client.get("/")
    if not looks_logged_in(page, url, expect=expect):
        extra = "/enter" if is_codeforces(site) else "/login"
        status, url, page = client.get(extra)
        if not looks_logged_in(page, url, expect=expect):
            die(
                "浏览器里看起来已经登录，但命令行请求仍未带上会话。\n"
                "请再试一次 ./submit login，或确认弹出的窗口里确实登录成功。"
            )
    username = extract_username(page) or expect or ""
    if expected and username != expected:
        die(f"实际登录账号是 {username or '(未知)'}，与目标 {expected} 不符；未保存")
    if not username:
        die("未能识别登录账号，未保存会话；请检查网页导航栏")
    save_account(cfg, site, client.cookie_header() or cookie, ua, username)
    ok(f"已登录 {username or '(未知用户)'} @ {site}")
    info(f"配置保存在 {global_config_path()}")


def _read_multiline_cookie() -> str:
    print("Cookie（粘贴一行 header 或 JSON；输入空行结束）:")
    lines: List[str] = []
    while True:
        try:
            line = input()
        except EOFError:
            break
        if not line.strip() and lines:
            break
        if not line.strip() and not lines:
            return ""
        lines.append(line)
        blob = "\n".join(lines).strip()
        if blob.startswith("{") and blob.count("{") <= blob.count("}"):
            try:
                json.loads(blob)
                break
            except json.JSONDecodeError:
                continue
        if blob.startswith("[") and blob.count("[") <= blob.count("]"):
            try:
                json.loads(blob)
                break
            except json.JSONDecodeError:
                continue
    return "\n".join(lines).strip()


def _prompt_cookie_login(site: str) -> Tuple[str, str]:
    if is_codeforces(site):
        print(
            "Codeforces 请用你平时能打开的浏览器登录，再把 Cookie 贴进来\n"
            "（插件自带的 Firefox 会被 Cloudflare 卡住）。\n"
            "\n"
            "  1. 打开 https://codeforces.com 并登录\n"
            "  2. F12 → Network → 刷新 → 点开任意 codeforces.com 请求\n"
            "  3. 复制 Request Headers 里的整段 Cookie\n"
            "     不要用 document.cookie，会缺 HttpOnly（如 JSESSIONID）\n"
            "  4. 同一请求里再复制 User-Agent\n"
        )
    else:
        print("手动粘贴 Cookie。有 cf_clearance 时必须同时提供同一浏览器的 User-Agent。")
    cookie = _read_multiline_cookie()
    if not cookie:
        die("没有读到 Cookie")
    ua_in = input("User-Agent（与 Cookie 同一浏览器；直接回车则用已保存的）: ").strip()
    return cookie, ua_in


def cmd_login(args: argparse.Namespace) -> None:
    cfg = load_global()
    if getattr(args, "oj", None) or args.site:
        site = resolve_site(args.site or args.oj)
    else:
        site = (cfg.get("site") or DEFAULT_SITE).rstrip("/")
    info(f"登录 {oj_label(site)}  ({site})")
    ua = args.user_agent or get_account(cfg, site).get("user_agent") or cfg.get("user_agent") or DEFAULT_UA
    expected = getattr(args, "account", None) or ""
    cookie = args.cookie
    if args.cookie_file:
        cookie = Path(args.cookie_file).read_text(encoding="utf-8").strip()

    want_browser = bool(getattr(args, "browser", False))
    if not cookie and not args.username and (want_browser or not args.manual):
        prev = get_account(cfg, site).get("username") or ""
        if prev:
            info(f"本地 {account_key(site)} 当前账号是 {prev}；新登录使用独立会话")
        cookie, ua, html = login_via_browser(site, expected)
        fallback = (
            extract_cf_handle(html)
            or extract_username(html)
            or cookie_names(cookie).get("uoj_username")
            or ""
        )
        _finalize_login(cfg, site, cookie, ua, args.debug, fallback_user=fallback, expected=expected)
        return

    if not cookie and not args.username:
        cookie, ua_in = _prompt_cookie_login(site)
        if ua_in:
            ua = ua_in
        elif is_codeforces(site) and ua == DEFAULT_UA:
            die("Codeforces 必须粘贴与 Cookie 同一浏览器的 User-Agent")
    if cookie:
        cookie = parse_cookie_input(cookie)
        names = cookie_names(cookie)
        if "cf_clearance" in names and ua == DEFAULT_UA:
            die(
                "Cookie 里有 cf_clearance，但 User-Agent 还是脚本默认值。\n"
                "请粘贴同一浏览器的 User-Agent，或加上 --user-agent"
            )
        if not is_codeforces(site) and not any(names.get(n) for n in QOJ_SESSION_COOKIE_NAMES):
            warn("没有看到 UOJSESSID / uoj_remember_token，登录可能失败")
        if is_codeforces(site) and "JSESSIONID" not in names:
            die(
                "这段 Cookie 里没有 JSESSIONID，还没带上 Codeforces 登录态。\n"
                "请用 F12 → Network → 点开任意 codeforces.com 请求 → Request Headers 里的 Cookie。\n"
                "不要从 Application/存储面板或 document.cookie 导出（会缺 HttpOnly）。"
            )
        _finalize_login(
            cfg,
            site,
            cookie,
            ua,
            args.debug,
            fallback_user=names.get("uoj_username") or "",
            expected=expected,
        )
        return

    if is_codeforces(site):
        die("Codeforces 请用窗口登录:  python3 submit login cf")

    username = args.username or input("用户名: ").strip()
    password = args.password or getpass.getpass("密码: ")
    if not username or not password:
        die("用户名和密码不能为空")
    client = Client(site, user_agent=ua, debug=args.debug)
    status, url, page = client.get("/login")
    token = extract_token(page)
    if not token:
        warn("没有解析到 CSRF token，仍尝试登录")
    hashed = md5_hex(password)
    fields = {
        "_token": token,
        "login": "",
        "username": username,
        "password": hashed,
    }
    status, url, resp = client.post_form("/login", fields, referer=urljoin(site, "/login"))
    if resp.strip() != "ok":
        fields["password"] = hmac_md5_hex(token, password)
        status, url, resp = client.post_form("/login", fields, referer=urljoin(site, "/login"))
    if resp.strip() != "ok":
        fields["password"] = password
        status, url, resp = client.post_form("/login", fields, referer=urljoin(site, "/login"))
    if resp.strip() != "ok":
        die(
            "用户名密码登录失败（QOJ 有 Cloudflare）。请改用窗口登录:\n"
            f"  python submit login\n服务器返回: {resp.strip()[:200]!r}"
        )
    status, url, home = client.get("/")
    handle = extract_username(home) or username
    if expected and handle != expected:
        die(f"实际登录账号 {handle} 与目标 {expected} 不符；未保存")
    save_account(cfg, site, client.cookie_header(), ua, handle)
    ok(f"已登录 {handle} @ {site}")
    info(f"配置保存在 {global_config_path()}")


