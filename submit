def parse_contest_ref(
    raw: str, cfg: dict, site_override: Optional[str] = None
) -> Tuple[str, str, str]:
    text = (raw or "").strip()
    m = re.search(r"(https?://[^/]+)/(contest|gym)/(\d+)", text)
    if m:
        return m.group(1).rstrip("/"), m.group(3), m.group(2)
    if re.fullmatch(r"\d+", text):
        if site_override:
            site = resolve_site(site_override, cfg)
        else:
            site = (cfg.get("site") or DEFAULT_SITE).rstrip("/")
        return site, text, "contest"
    die("请输入比赛 UID，例如 1234 或 https://codeforces.com/contest/2044")
    raise AssertionError


def bind_contest(
    raw: str,
    *,
    site: Optional[str] = None,
    kind: Optional[str] = None,
    template: bool = False,
    debug: bool = False,
    quiet: bool = False,
) -> dict:
    cfg = load_global()
    site, contest_id, parsed_kind = parse_contest_ref(raw, cfg, site)
    kind = kind or parsed_kind or "contest"
    if kind not in ("contest", "gym"):
        kind = "contest"
    if is_codeforces(site):
        contest_url = f"{site}/{kind}/{contest_id}"
    else:
        contest_url = f"{site}/contest/{contest_id}"
        kind = "contest"
    client = make_client(cfg, {"site": site}, debug=debug)
    status, url, page = client.get(contest_url)
    expect = get_account(cfg, site).get("username") or ""
    if not looks_logged_in(page, url, expect=expect) and (
        "/login" in url or "/enter" in url
    ):
        hint = "python3 submit login cf" if is_codeforces(site) else "python3 submit login"
        die(f"未登录或 Cookie 失效，请先 {hint}")

    problems = parse_contest_problems(page, site, contest_id, kind)
    if not problems:
        hint = "python3 submit login cf" if is_codeforces(site) else "python3 submit login"
        die(f"没有解析到题目。请确认已经登录（{hint}），且比赛 UID 正确")
    name = parse_contest_name(page, site, contest_id)
    if not name or _is_junk_contest_name(name):
        name = f"Contest {contest_id}"
    username = extract_username(page) or expect
    data = {
        "site": site,
        "contest_id": contest_id,
        "contest_url": contest_url,
        "kind": kind,
        "name": name,
        "username": username,
        "problems": problems,
    }
    dest_dir = Path.cwd()
    contest_path = dest_dir / CONTEST_FILE
    save_json(contest_path, data)
    cfg["site"] = site
    cfg["contest"] = data
    save_global(cfg)
    copied = copy_self_to(dest_dir)
    if template:
        _write_templates(dest_dir, problems.keys())
    if not quiet:
        ok(f"已绑定比赛: {name}")
        info(f"UID: {contest_id}  {contest_url}")
        info(f"配置: {contest_path}")
        if copied:
            info(f"提交命令: {copied}")
        _print_problems(problems)
        print()
        info("接下来:  python3 submit a.cpp")
    return data


