def resolve_source(name: str) -> Path:
    path = Path(name)
    if path.is_file():
        return path
    if path.suffix:
        die(f"文件不存在: {name}")
    for ext in EXT_CANDIDATES:
        cand = Path(name + ext)
        if cand.is_file():
            return cand
        cand = Path(name.lower() + ext)
        if cand.is_file():
            return cand
        cand = Path(name.upper() + ext)
        if cand.is_file():
            return cand
    die(f"找不到源文件 {name} / {name}.cpp / {name}.py ...")
    raise AssertionError


def _problem_sort_key(letter: str):
    text = str(letter or "").upper()
    m = re.fullmatch(r"([A-Z]+)(\d*)", text)
    if not m:
        return (text, 0)
    return (m.group(1), int(m.group(2) or 0))


def resolve_problem_letter(token: str, problems: dict) -> Optional[str]:
    """c1 → C1 if that problem exists, otherwise C."""
    keys = {str(k).upper(): k for k in problems}
    want = (token or "").strip().upper()
    if not want:
        return None
    if want in keys:
        return keys[want]
    m = re.fullmatch(r"([A-Z]{1,2})(\d+)", want)
    if m and m.group(1) in keys:
        return keys[m.group(1)]
    return None


def letter_from_filename(path: Path, problems: dict, explicit: Optional[str]) -> str:
    names = ", ".join(sorted(problems, key=_problem_sort_key))
    if explicit:
        letter = resolve_problem_letter(explicit, problems)
        if not letter:
            die(f"没有题目 {explicit.strip().upper()}。已有: {names}")
        return letter
    stem = path.stem
    hit = resolve_problem_letter(stem, problems)
    if hit:
        return hit
    m = re.match(r"^([A-Za-z]{1,2}\d*)(?:$|[^A-Za-z0-9])", stem)
    if m:
        hit = resolve_problem_letter(m.group(1), problems)
        if hit:
            return hit
    m = re.match(r"^([A-Za-z])(\d+)", stem)
    if m:
        hit = resolve_problem_letter(m.group(1) + m.group(2), problems)
        if hit:
            return hit
    m = re.match(r"^([A-Za-z])", stem)
    if not m:
        die("无法从文件名判断题号，请使用 a.cpp / c1.cpp，或加 --problem A")
    letter = resolve_problem_letter(m.group(1), problems)
    if not letter:
        die(
            f"文件 {path.name} 对应题目 {m.group(1).upper()}，但本场没有这题。\n"
            f"已有: {names}"
        )
    return letter


def submissions_list_urls(
    contest: dict,
    problem_id: Optional[str] = None,
    site_wide: bool = False,
) -> List[str]:
    username = contest.get("username") or ""
    site = (contest.get("site") or "").rstrip("/")
    contest_url = contest["contest_url"].rstrip("/")
    params = {}
    if username:
        params["submitter"] = username
    if problem_id:
        params["problem_id"] = problem_id
    q = ("?" + urlencode(params)) if params else ""
    urls = [contest_url + "/submissions" + q]
    if site_wide and site:
        urls.append(site + "/submissions" + q)
    if problem_id:
        params2 = dict(params)
        params2.pop("problem_id", None)
        q2 = ("?" + urlencode(params2)) if params2 else ""
        urls.append(contest_url + "/submissions" + q2)
    out: List[str] = []
    for item in urls:
        if item not in out:
            out.append(item)
    return out


def fetch_submission_rows(
    client: Client,
    contest: dict,
    problem_id: Optional[str] = None,
    timeout: int = 10,
    retries: int = 0,
    site_wide: bool = False,
) -> List[dict]:
    last_err: Optional[BaseException] = None
    for url in submissions_list_urls(contest, problem_id, site_wide=site_wide):
        try:
            status, final, page = client.get(url, timeout=timeout, retries=retries, fatal=False)
            validate_submission_page(status, final, page)
        except (TimeoutError, OSError) as exc:
            last_err = exc
            continue
        rows = [
            row for row in parse_submission_rows(page)
            if _submission_row_matches(row, contest, problem_id)
        ]
        return rows
    if last_err:
        raise last_err
    return []


def parse_cf_submission_rows(page: str) -> List[dict]:
    rows: List[dict] = []
    seen = set()
    for tm in re.finditer(r"<tr\b([^>]*)>(.*?)</tr>", page or "", re.I | re.S):
        attrs, inner = tm.group(1), tm.group(2)
        sid = _html_attr(attrs, "data-submission-id")
        if not sid:
            sm = re.search(r"/(?:contest|gym)/\d+/submission/(\d+)", inner)
            if not sm:
                sm = re.search(r"/submission/(\d+)", inner)
            sid = sm.group(1) if sm else ""
        if not sid or sid in seen:
            continue
        seen.add(sid)
        pm = re.search(r"/problem/([A-Za-z][A-Za-z0-9]*)", inner)
        letter = pm.group(1).upper() if pm else ""
        status = ""
        vm = re.search(
            r'class=["\'][^"\']*verdict-[^"\']*["\'][^>]*>(.*?)</',
            inner,
            re.I | re.S,
        )
        if vm:
            status = strip_html(vm.group(1))
        if not status:
            status = _uoj_status_text(inner) or "?"
        cells = [strip_html(td) for td in re.findall(r"<td\b[^>]*>(.*?)</td>", inner, re.I | re.S)]
        rows.append({
            "id": sid,
            "problem": letter,
            "problem_id": letter,
            "contest_id": "",
            "submitter": "",
            "status": status,
            "cells": cells,
            "submit_ts": _parse_submit_clock(cells),
            "submit_time": submission_time_text(inner),
            "url_path": f"/submission/{sid}",
        })
    return rows


def fetch_cf_submission_rows(
    client: Client,
    contest: dict,
    problem_id: Optional[str] = None,
    timeout: int = 8,
    retries: int = 0,
    fallback: bool = True,
) -> List[dict]:
    contest_url = str(contest.get("contest_url") or "").rstrip("/")
    handle = contest.get("username") or ""
    urls = [contest_url + "/my"]
    if fallback and handle:
        urls.append(contest_url + "/status?" + urlencode({"handle": handle}))
    last_err: Optional[BaseException] = None
    want = str(problem_id or "").upper()
    for url in urls:
        try:
            status, final, page = client.get(url, timeout=timeout, retries=retries, fatal=False)
            validate_submission_page(status, final, page)
        except (TimeoutError, OSError) as exc:
            last_err = exc
            continue
        rows = parse_cf_submission_rows(page)
        if want:
            rows = [r for r in rows if str(r.get("problem_id") or "").upper() == want]
        return rows
    if last_err:
        raise last_err
    return []


def latest_ids(client: Client, contest: dict, problem_id: Optional[str] = None) -> List[str]:
    return [
        r["id"]
        for r in fetch_submission_rows(client, contest, problem_id, site_wide=True)
    ]


def is_new_submission_id(sid: str, before: Optional[List[str]]) -> bool:
    # None means the pre-submit list could not be read; [] means it was empty.
    return before is not None and sid.isdigit() and (not before or int(sid) > max(int(x) for x in before))


def wait_for_new_sid(
    client: Client,
    contest: dict,
    problem_id: str,
    before: Optional[List[str]],
    seconds: float = 4,
) -> Optional[str]:
    if before is None:
        return None
    info("正在核对新提交记录...")
    deadline = time.monotonic() + seconds
    fetch = fetch_cf_submission_rows if is_codeforces(contest.get("site") or "") else fetch_submission_rows
    while time.monotonic() < deadline:
        remaining = deadline - time.monotonic()
        try:
            kwargs = {"fallback": False} if is_codeforces(contest.get("site") or "") else {"site_wide": False}
            rows = fetch(client, contest, problem_id, timeout=min(8, remaining), retries=0, **kwargs)
            for row in rows:
                if is_new_submission_id(row["id"], before):
                    return row["id"]
        except (TimeoutError, OSError):
            pass
        remaining = deadline - time.monotonic()
        if remaining > 0:
            time.sleep(min(1, remaining))
    return None


def format_ago(ts: float) -> str:
    try:
        delta = int(time.time() - ts)
    except (TypeError, OverflowError, OSError):
        return "?"
    if delta < 0:
        return "刚刚"
    if delta < 5:
        return "刚刚"
    if delta < 60:
        return f"{delta} 秒前"
    if delta < 3600:
        return f"{delta // 60} 分钟前"
    if delta < 86400:
        hours, minutes = divmod(delta // 60, 60)
        if minutes:
            return f"{hours} 小时 {minutes} 分钟前"
        return f"{hours} 小时前"
    days = delta // 86400
    return f"{days} 天前"


def file_mtime(path: Path) -> str:
    try:
        return format_ago(path.stat().st_mtime)
    except OSError:
        return "?"


def cached_last_submit(contest: dict, problem_id: str) -> Tuple[str, Optional[float]]:
    rec = (contest.get("last_submit") or {}).get(str(problem_id)) or {}
    sid = str(rec.get("sid") or "")
    try:
        ts = float(rec["ts"]) if rec.get("ts") is not None else None
    except (TypeError, ValueError):
        ts = None
    return sid, ts


def remember_submit(contest_path: Path, contest: dict, problem_id: str, sid: str) -> None:
    rec = contest.setdefault("last_submit", {})
    rec[str(problem_id)] = {"sid": str(sid), "ts": time.time()}
    if contest_path.name == CONTEST_FILE:
        try:
            save_json(contest_path, contest)
        except OSError:
            pass
    cfg = load_global()
    cached = cfg.get("contest")
    if isinstance(cached, dict) and str(cached.get("contest_id")) == str(contest.get("contest_id")):
        cfg["contest"] = contest
        save_global(cfg)


def confirm_or_abort(prompt: str = "确认提交? [Y/n] ") -> None:
    try:
        ans = input(prompt).strip().lower()
    except EOFError:
        ans = ""
    if ans in ("n", "no", "q", "quit"):
        die("已取消")


def _load_submit_context(
    client: Client,
    contest: dict,
    problem: dict,
    expect: str,
    on_fetch=None,
) -> Tuple[str, int, str, str, List[str], bool, str, Optional[float]]:
    if is_codeforces(contest.get("site") or ""):
        submit_url = str(contest["contest_url"]).rstrip("/") + "/submit"
        if on_fetch:
            on_fetch("submit")
        last: Tuple[int, str, str] = (0, submit_url, "")
        for attempt in range(2):
            if attempt:
                time.sleep(0.4)
            try:
                status, url, page = client.get(
                    submit_url, timeout=20, retries=0, fatal=False
                )
            except (TimeoutError, OSError):
                continue
            last = (status, url, page)
            if _is_cloudflare_block(page):
                continue
            if not looks_logged_in(page, url, expect=expect) and "/enter" in (url or ""):
                die("未登录或 Cookie 已过期。请先: python3 submit login cf")
            if extract_csrf(page) or extract_token(page):
                return submit_url, status, url, page, [], False, "", None
        status, url, page = last
        if _is_cloudflare_block(page):
            die("被 Cloudflare 拦截。请重新: python3 submit login cf")
        if not looks_logged_in(page, url, expect=expect) and "/enter" in (url or ""):
            die("未登录或 Cookie 已过期。请先: python3 submit login cf")
        return submit_url, status, url, page, [], False, "", None
    problem_url, status, url, page = _fetch_problem_submit_page(
        client, contest, problem, on_fetch=on_fetch
    )
    if _is_cloudflare_block(page):
        die("被 Cloudflare 拦截。请重新: python3 submit login")
    if not looks_logged_in(page, url, expect=expect) and "/login" in (url or ""):
        die("未登录或 Cookie 已过期。请先: python3 submit login")
    if status != 200 or not _has_submit_form(page):
        die("未找到有效提交表单，请检查比赛权限或重新登录")
    return problem_url, status, url, page, [], False, "", None


def _submit_codeforces(
    client: Client,
    contest_path: Path,
    contest: dict,
    letter: str,
    problem: dict,
    code: str,
    suffix: str,
    explicit_lang: Optional[str],
    problem_url: str,
    url: str,
    page: str,
    before: Optional[List[str]],
    chosen_lang: Optional[str] = None,
) -> Optional[str]:
    csrf = extract_csrf(page) or extract_token(page)
    if not csrf:
        die("没有拿到 CSRF token。请先: python3 submit login cf")
    opts = parse_select_options(page, "programTypeId")
    parsed_field, parsed_opts = collect_language_options(page)
    if parsed_opts:
        opts = parsed_opts
    if chosen_lang and (not opts or any(v == chosen_lang for v, _ in opts)):
        lang = chosen_lang
    elif opts:
        lang = pick_language(opts, suffix, explicit_lang)
    else:
        lang = pick_language(list(DEFAULT_CF_LANGS), suffix, explicit_lang)
    ftaa = ""
    bfaa = ""
    fm = re.search(r"window\._ftaa\s*=\s*['\"]([^'\"]*)['\"]", page or "")
    bm = re.search(r"window\._bfaa\s*=\s*['\"]([^'\"]*)['\"]", page or "")
    if fm:
        ftaa = fm.group(1)
    if bm:
        bfaa = bm.group(1)
    fields = {
        "csrf_token": csrf,
        "action": "submitSolutionFormSubmitted",
        "submittedProblemIndex": letter,
        "contestId": str(contest.get("contest_id") or ""),
        "programTypeId": lang,
        "source": code,
        "tabSize": "4",
        "sourceFile": "",
        "sourceCodeConfirmed": "true",
        "_tta": "594",
    }
    if ftaa:
        fields["ftaa"] = ftaa
    if bfaa:
        fields["bfaa"] = bfaa
    post_url = problem_url.split("?")[0] + "?csrf_token=" + csrf
    info("正在提交...")
    try:
        status, resp_url, resp = client.post_form(
            post_url, fields, referer=url or problem_url, follow_redirects=False, fatal=False
        )
    except TimeoutError:
        warn("提交响应超时，正在查是否已经交上去（不要重复提交）...")
        status, resp_url, resp = 0, "", ""
    err = extract_cf_error(resp)
    if err:
        die(f"提交被拒绝: {err}")
    if "/enter" in (resp_url or ""):
        die("提交时登录已失效，请 python3 submit login cf")
    ok_submit = False
    if status in (301, 302, 303) and "/my" in (resp_url or ""):
        ok_submit = True
    if status == 200 and "/my" in (resp_url or ""):
        ok_submit = True
    if "submitted successfully" in (resp or "").lower():
        ok_submit = True
    sid = ""
    rows = parse_cf_submission_rows(resp)
    want = str(letter or "").upper()
    if want:
        rows = [r for r in rows if str(r.get("problem_id") or "").upper() == want]
    for row in rows:
        if is_new_submission_id(row["id"], before):
            sid = row["id"]
            break
    if not sid and not ok_submit:
        sid = wait_for_new_sid(client, contest, letter, before, seconds=20)
    board = str(contest["contest_url"]).rstrip("/") + "/my"
    if not ok_submit and not sid:
        die(
            "没有确认提交成功。\n"
            f"HTTP {status}  {resp_url}\n"
            f"请先 python3 submit status 或打开 {board}"
        )
    if sid:
        remember_submit(contest_path, contest, str(problem.get("id") or letter), sid)
        ok(f"已提交 #{sid}  {letter}")
    else:
        ok(f"已提交 {letter}")
    info(f"评测结果见 {board}")
    return sid or None


def extract_cf_error(page: str) -> str:
    texts: List[str] = []
    for pat in (
        r'class=["\']error[^"\']*["\'][^>]*>(.*?)</(?:span|div|td)',
        r'for=["\']error["\'][^>]*>(.*?)</',
        r'<span[^>]*class=["\'][^"\']*error[^"\']*["\'][^>]*>(.*?)</span>',
    ):
        for m in re.finditer(pat, page or "", re.I | re.S):
            text = strip_html(m.group(1)).strip()
            if text and text not in texts and len(text) < 300:
                texts.append(text)
    blob = " / ".join(texts[:3])
    if "submitted successfully" in (page or "").lower():
        return ""
    return blob


def cmd_submit(args: argparse.Namespace) -> None:
    if not getattr(args, "no_wait", False) and getattr(args, "wait", 300) <= 0:
        die("--wait 必须大于 0；不等待请使用 --no-wait")
    cfg = load_global()
    if getattr(args, "contest", None):
        bind_contest(str(args.contest), debug=bool(args.debug), quiet=True)
    contest_path, contest = require_contest()
    problems = contest.get("problems") or {}
    if not problems:
        die("比赛配置里没有题目。请先: python3 submit 1234")
    src = resolve_source(args.file)
    letter = letter_from_filename(src, problems, args.problem)
    problem = problems[letter]
    suffix = src.suffix.lower()
    try:
        code = src.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        code = src.read_text(encoding="gbk")
    if not code.strip():
        die(f"{src.name} 是空文件")

    if is_codeforces(contest.get("site") or ""):
        lang_field, options = "programTypeId", list(DEFAULT_CF_LANGS)
    else:
        lang_field, options = "answer_answer_language", list(DEFAULT_QOJ_LANGS)
    lang = pick_language(options, suffix, args.lang)

    try:
        mtime = src.stat().st_mtime
    except OSError:
        mtime = 0.0
    cached_sid, cached_ts = cached_last_submit(contest, problem["id"])

    def print_card() -> None:
        print(paint("== submit ==", "1"), flush=True)
        print(f"  contest  {contest_display_name(contest)}", flush=True)
        print(f"  problem  {letter}  {problem['title']}  (#{problem['id']})", flush=True)
        print(f"  file     {src}", flush=True)
        print(f"  mtime    {file_mtime(src)}", flush=True)
        print(f"  lang     {language_label(options, lang)}", flush=True)

    if args.dry_run:
        print_card()
        if cached_ts is not None and mtime and mtime <= cached_ts + 1:
            warn(f"文件上次修改早于上次提交 #{cached_sid or '?'}，可能是旧代码")
        warn("dry-run，没有真正提交")
        return

    client = make_client(cfg, contest, debug=args.debug)
    expect = get_account(cfg, contest.get("site") or "").get("username") or contest.get("username") or ""
    contest["username"] = expect
    chosen_lang = lang
    before = [cached_sid] if cached_sid else []
    box: dict = {"data": None, "exc": None}

    def _prefetch() -> None:
        try:
            box["data"] = _load_submit_context(client, contest, problem, expect)
            box["loaded_at"] = time.monotonic()
        except BaseException as exc:
            box["exc"] = exc

    worker = threading.Thread(target=_prefetch, daemon=True)
    worker.start()
    print_card()
    if cached_ts is not None and mtime and mtime <= cached_ts + 1:
        warn(f"文件上次修改早于上次提交 #{cached_sid or '?'}，可能是旧代码")
    if not getattr(args, "yes", False):
        confirm_or_abort()
    if worker.is_alive():
        info("正在打开提交页...")
    worker.join()
    if box["exc"] is not None:
        exc = box["exc"]
        if isinstance(exc, SystemExit):
            raise exc
        if not isinstance(exc, (TimeoutError, OSError)):
            raise exc
        box["data"] = None
    if box["data"] is None or time.monotonic() - box.get("loaded_at", 0) > 60:
        info("正在打开提交页...")
        client._rebuild_opener()
        try:
            box["data"] = _load_submit_context(client, contest, problem, expect)
        except (TimeoutError, OSError) as exc:
            die(f"获取提交表单失败，尚未发送代码: {exc}")
    problem_url, status, url, page, _hist, _list_timeout, _list_sid, _list_ts = box["data"]
    if is_codeforces(contest.get("site") or "") and not (
        extract_csrf(page) or extract_token(page)
    ):
        info("提交页未就绪，正在重试...")
        client._rebuild_opener()
        problem_url, status, url, page, _hist, _list_timeout, _list_sid, _list_ts = (
            _load_submit_context(client, contest, problem, expect)
        )
    if not is_codeforces(contest.get("site") or ""):
        current_user = extract_username(page) or expect
        if not current_user:
            die("无法确定提交账号，请重新运行 ./submit login")
        contest["username"] = current_user
    info("正在读取提交前记录...")
    try:
        fetch_rows = fetch_cf_submission_rows if is_codeforces(contest.get("site") or "") else fetch_submission_rows
        baseline = fetch_rows(client, contest, str(problem["id"]), retries=1)
        before = [row["id"] for row in baseline]
    except (TimeoutError, OSError):
        before = None
        warn("提交前记录暂不可用，将依据服务器提交响应确认结果")
    fresh_name = parse_contest_name(
        page, contest.get("site") or "", str(contest.get("contest_id") or "")
    )
    cur_name = str(contest.get("name") or "").strip()
    if _is_junk_contest_name(cur_name):
        contest["name"] = (
            fresh_name
            if fresh_name and not _is_junk_contest_name(fresh_name)
            else f"Contest {contest.get('contest_id') or ''}".strip()
        )
        save_json(contest_path, contest)
    if is_codeforces(contest.get("site") or ""):
        opts = parse_select_options(page, "programTypeId")
        _, parsed_opts = collect_language_options(page)
        if parsed_opts:
            opts = parsed_opts
        if opts:
            options = opts
            if any(v == chosen_lang for v, _ in opts):
                lang = chosen_lang
            else:
                lang = pick_language(options, suffix, args.lang)
        sid = _submit_codeforces(
            client,
            contest_path,
            contest,
            letter,
            problem,
            code,
            suffix,
            args.lang,
            problem_url,
            url,
            page,
            before,
            chosen_lang=lang,
        )
        finish_submission(client, contest_path, contest, problem, sid, before, args)
        return
    sid = _submit_qoj(client, contest_path, contest, problem, code, suffix, args.lang,
                problem_url, url, page, before, chosen_lang=lang)
    finish_submission(client, contest_path, contest, problem, sid, before, args)


def _submit_qoj(client, contest_path, contest, problem, code, suffix, explicit_lang,
                problem_url, url, page, before, chosen_lang=None):
    form = next((m.group(0) for m in re.finditer(r"<form\b[^>]*>.*?</form>", page, re.I | re.S)
                 if _has_submit_form(m.group(0))), "")
    if not form:
        die("未找到提交表单，尚未发送代码")
    token = extract_token(form) or extract_token(page)
    if not token:
        die("未找到提交 token，尚未发送代码")
    if "answer_Anna_language" in form or "answer_Bruno_language" in form:
        die("这是交互/通信题（Anna/Bruno），请到网页提交")
    post_url = extract_form_action(form, url or problem_url) or problem_url
    if urlparse(post_url).netloc != urlparse(client.site).netloc:
        die("提交表单跳到了其他站点，尚未发送代码")
    lang_field, options = collect_language_options(form)
    if not options:
        lang_field, options = "answer_answer_language", list(DEFAULT_QOJ_LANGS)
    lang = chosen_lang if chosen_lang and any(v == chosen_lang for v, _ in options) else pick_language(options, suffix, explicit_lang)
    fields = {}
    for attrs in re.findall(r"<input\b([^>]*)>", form, re.I | re.S):
        name = _html_attr(attrs, "name")
        if name and _html_attr(attrs, "type").lower() == "hidden" and not re.search(r"\bdisabled(?:\s|=|$)", attrs, re.I):
            fields[name] = _html_attr(attrs, "value")
    btn_name, btn_val = extract_submit_button(form)
    fields.update({"_token": token, lang_field: lang, "answer_answer_upload_type": "editor",
                   "answer_answer_editor": code, btn_name: btn_val})
    info("正在提交...")
    status, response_url, response = 0, "", ""
    try:
        status, response_url, response = client.post_multipart(
            post_url, fields, files={"answer_answer_file": ("", b"", "application/octet-stream")},
            referer=url or post_url, timeout=30, fatal=False)
    except (TimeoutError, OSError):
        warn("提交响应中断，正在核对记录；不会重复发送代码")
        client._rebuild_opener()
    if "/login" in response_url:
        die("提交时登录已失效，请运行 ./submit login")
    errors = re.findall(r'<div\b[^>]*class=["\'][^"\']*alert-danger[^"\']*["\'][^>]*>(.*?)</div>', response, re.I | re.S)
    if errors and status < 500:
        die("提交被拒绝: " + " / ".join(strip_html(x) for x in errors))
    board = str(contest["contest_url"]).rstrip("/") + "/submissions"
    target = urlparse(response_url)
    same_site = target.netloc == urlparse(client.site).netloc
    direct = re.fullmatch(r"/(?:contest/\d+/)?submission/(\d+)/?", target.path) if same_site else None
    sid = direct.group(1) if direct and 200 <= status < 400 else None
    acknowledged = same_site and status in (301, 302, 303) and target.path.rstrip("/") == urlparse(board).path
    if not sid and not acknowledged:
        sid = wait_for_new_sid(client, contest, str(problem["id"]), before, seconds=20)
    if sid:
        remember_submit(contest_path, contest, str(problem["id"]), sid)
        ok(f"已提交 #{sid}")
    elif acknowledged:
        ok("服务器已接收提交")
    else:
        die(f"暂时无法确认提交结果（HTTP {status}）。请先 ./submit status 或打开 {board} 核对，避免重复提交")
    info(f"评测结果见 {board}")
    return sid


def finish_submission(client, contest_path, contest, problem, sid, before, args):
    if getattr(args, "no_wait", False):
        return
    deadline = time.monotonic() + getattr(args, "wait", 300)
    try:
        if not sid:
            sid = wait_for_new_sid(client, contest, str(problem["id"]), before,
                                   seconds=max(0, deadline - time.monotonic()))
            if sid:
                remember_submit(contest_path, contest, str(problem["id"]), sid)
        if not sid:
            warn("提交已接收，但未能确定本次提交 ID；请先 status 核对，再用 watch <ID> 跟踪")
            return
        watch_submission(client, contest, sid, timeout=max(0, deadline - time.monotonic()))
    except KeyboardInterrupt:
        warn("已停止等待，提交仍在服务器评测；可用 status 查看")


def fetch_submission_verdict(client, contest, sid, timeout=10):
    deadline = time.monotonic() + timeout
    cf = is_codeforces(contest.get("site") or "")
    fetch = fetch_cf_submission_rows if cf else fetch_submission_rows
    kwargs = {"fallback": False} if cf else {"site_wide": False}
    rows = fetch(client, contest, timeout=timeout, retries=0, **kwargs)
    for row in rows:
        if row["id"] == sid:
            return short_verdict(row["status"])
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        return "UNKNOWN"
    # Older submissions may have moved beyond the first page.
    base = contest["contest_url"] if cf else contest["site"]
    status, url, page = client.get(base.rstrip("/") + "/submission/" + sid,
                                    timeout=remaining, retries=0, fatal=False)
    validate_submission_page(status, url, page)
    head, _ = _split_submission_html(page)
    parser = parse_cf_submission_rows if cf else parse_submission_rows
    for row in parser(head):
        if row["id"] == sid:
            return short_verdict(row["status"])
    # Do not infer an overall result from individual test results.
    return short_verdict(_uoj_status_text(head))


def watch_submission(client, contest: dict, sid: str, timeout: float = 300) -> bool:
    sid = str(sid).lstrip("#")
    if not sid.isdigit():
        die("提交 ID 必须是数字")
    final = {"AC", "WA", "TLE", "MLE", "RE", "CE", "OLE", "JE", "PC", "RF",
             "DGS", "PE", "NO_OUTPUT", "CANCELLED", "SKIPPED", "HACKED", "REJECT"}
    deadline = time.monotonic() + timeout
    last, failed = None, False
    info(f"正在等待 #{sid} 的评测结果（Ctrl+C 停止等待）")
    while time.monotonic() < deadline:
        try:
            verdict = fetch_submission_verdict(client, contest, sid,
                                               timeout=min(10, max(0.1, deadline - time.monotonic())))
            failed = False
            if verdict != last:
                print(f"#{sid}  {verdict_color(verdict)}", flush=True)
                last = verdict
            if verdict in final:
                return True
        except (TimeoutError, OSError):
            if not failed:
                warn("查询暂时失败，将继续核对评测状态，不会重复提交")
            failed = True
        remaining = deadline - time.monotonic()
        if remaining > 0:
            time.sleep(min(2, remaining))
    warn(f"等待超时，#{sid} 尚未取得最终结果；可用 ./submit watch {sid} 继续查询")
    return False


def cmd_watch(args: argparse.Namespace) -> None:
    if args.wait <= 0:
        die("--wait 必须大于 0")
    cfg = load_global()
    _, contest = require_contest()
    contest = dict(contest)
    contest["username"] = get_account(cfg, contest.get("site") or "").get("username") or contest.get("username") or ""
    client = make_client(cfg, contest, debug=args.debug)
    try:
        watch_submission(client, contest, str(args.id).lstrip("#"), timeout=args.wait)
    except KeyboardInterrupt:
        warn("已停止等待；可用 status 查看评测结果")


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="submit",
        description="QOJ / Codeforces 命令行提交: ./submit a.cpp",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""例子:
  python3 submit login
  python3 submit login cf
  python3 submit qoj
  python3 submit cf
  python3 submit 1234
  python3 submit 2044
  python3 submit a.cpp
  python3 submit status
""",
    )
    p.add_argument("--debug", action="store_true", help="打印 HTTP 请求")
    p.add_argument("--version", action="version", version=f"{APP_NAME} {VERSION}")
    sub = p.add_subparsers(dest="cmd")

    pl = sub.add_parser("login", help="弹出登录窗口（推荐）")
    pl.add_argument("oj", nargs="?", default=None, help="qoj 或 cf，默认当前选择的 OJ")
    pl.add_argument("--site", default=None, help="OJ 地址，默认 https://qoj.ac")
    pl.add_argument("--cookie", default=None, help="Cookie 字符串")
    pl.add_argument("--cookie-file", default=None, help="包含 Cookie 的文件")
    pl.add_argument("--user-agent", default=None, help="浏览器 User-Agent")
    pl.add_argument("-u", "--username", default=None)
    pl.add_argument("-p", "--password", default=None)
    pl.add_argument("--manual", action="store_true", help="改用手动粘贴 Cookie")
    pl.add_argument("--browser", action="store_true", help="强制弹出浏览器窗口登录")
    pl.add_argument("--account", default=None, help="目标用户名；使用独立浏览器配置保存该账号")
    pa = sub.add_parser("accounts", help="列出当前站点保存的账号（* 为当前账号）")
    pa.add_argument("oj", nargs="?", default=None, help="qoj / cf / 站点")
    pac = sub.add_parser("account", help="切换已保存的账号")
    pac.add_argument("username")
    pac.add_argument("--site", default=None, help="qoj / cf / 站点")

    po = sub.add_parser("logout", help="退出本地登录，以便换账号")
    po.add_argument("oj", nargs="?", default=None, help="qoj 或 cf")
    who = sub.add_parser("whoami", help="立即显示本地账号")
    who.add_argument("--check", action="store_true", help="联网验证登录状态")
    who.add_argument("--timeout", type=float, default=15, help="在线验证总预算（秒），默认 15")

    pj = sub.add_parser("oj", help="选择或查看当前 OJ（qoj / cf）")
    pj.add_argument("name", nargs="?", default=None, help="qoj 或 cf")

    pi = sub.add_parser("init", aliases=["contest"], help="用比赛 UID 绑定比赛")
    pi.add_argument("url", help="比赛 UID 或 URL，例如 1234 或 https://codeforces.com/contest/2044")
    pi.add_argument("--site", default=None, help="qoj / cf / 完整站点")
    pi.add_argument("--template", action="store_true", help="生成 a.cpp b.cpp ... 模板")

    pp = sub.add_parser("problems", aliases=["list"], help="列出题目、自己的状态和通过队伍数（QOJ ICPC）")
    pp.add_argument("--sort-by-solved", action="store_true", help="按通过队伍数降序排序，同数按题号排序")
    pp.add_argument("--offline", action="store_true", help="只显示本地题目列表，不读取榜单")

    ps = sub.add_parser("status", help="自己在本场的全部提交：ID、题号、状态、提交时间")
    ps.add_argument("-n", "--limit", type=int, default=0, help="最多显示多少条，默认 0 表示全部")

    pw = sub.add_parser("watch", help="跟踪一次提交")
    pw.add_argument("id", help="提交号")
    pw.add_argument("--wait", type=int, default=300)

    return p


def looks_like_submit_target(arg: str) -> bool:
    if arg.startswith("-"):
        return False
    commands = {
        "login", "logout", "init", "contest", "problems", "list", "status",
        "watch", "whoami", "accounts", "account", "help", "cf", "codeforces", "gym", "qoj", "oj",
    }
    if arg in commands:
        return False
    path = Path(arg)
    if path.suffix.lower() in EXT_LANG_PREFER or path.suffix.lower() in EXT_CANDIDATES:
        return True
    if path.exists():
        return True
    if re.fullmatch(r"[A-Za-z][A-Za-z0-9_\-]*", arg) and len(arg) <= 32:
        return True
    return False


def main(argv: Optional[List[str]] = None) -> None:
    argv = list(sys.argv[1:] if argv is None else argv)
    parser = build_parser()
    debug = False
    if "--debug" in argv:
        debug = True
        argv = [a for a in argv if a != "--debug"]

    if not argv or argv[0] in ("-h", "--help", "help"):
        parser.print_help()
        return

    if looks_like_submit_target(argv[0]):
        sp = argparse.ArgumentParser(prog="submit")
        sp.add_argument("file")
        sp.add_argument("-p", "--problem", default=None, help="题号，如 A")
        sp.add_argument("-l", "--lang", default=None, help="语言，如 C++20")
        sp.add_argument("-c", "--contest", default=None, help="比赛 UID")
        sp.add_argument("-y", "--yes", action="store_true", help="不询问，直接提交")
        sp.add_argument("-n", "--no-wait", action="store_true", help="提交后不等待结果")
        sp.add_argument("--wait", type=int, default=300)
        sp.add_argument("--dry-run", action="store_true")
        args = sp.parse_args(argv)
        args.debug = debug
        cmd_submit(args)
        return

    if argv[0] in ("cf", "codeforces", "gym", "qoj"):
        alias = "gym" if argv[0] == "gym" else ("cf" if argv[0] in ("cf", "codeforces") else "qoj")
        kind = "gym" if argv[0] == "gym" else "contest"
        rest = argv[1:]
        if not rest:
            if argv[0] == "gym":
                die("用法: ./submit gym <比赛id>")
            select_oj(alias)
            return
        if not re.fullmatch(r"\d+", rest[0]):
            die("用法: ./submit cf <比赛id>   或   ./submit gym <比赛id>")
        uid = rest[0]
        rest = rest[1:]
        template = "--template" in rest
        rest = [a for a in rest if a != "--template"]
        bind_contest(uid, site=resolve_site(alias), kind=kind, template=template, debug=debug)
        if rest and looks_like_submit_target(rest[0]):
            sp = argparse.ArgumentParser(prog="submit")
            sp.add_argument("file")
            sp.add_argument("-p", "--problem", default=None)
            sp.add_argument("-l", "--lang", default=None)
            sp.add_argument("-y", "--yes", action="store_true")
            sp.add_argument("-n", "--no-wait", action="store_true")
            sp.add_argument("--wait", type=int, default=300)
            sp.add_argument("--dry-run", action="store_true")
            args = sp.parse_args(rest)
            args.debug = debug
            args.contest = None
            cmd_submit(args)
        return

    if re.fullmatch(r"\d+", argv[0]):
        uid = argv[0]
        rest = argv[1:]
        template = "--template" in rest
        rest = [a for a in rest if a != "--template"]
        bind_contest(uid, template=template, debug=debug)
        if rest and looks_like_submit_target(rest[0]):
            sp = argparse.ArgumentParser(prog="submit")
            sp.add_argument("file")
            sp.add_argument("-p", "--problem", default=None)
            sp.add_argument("-l", "--lang", default=None)
            sp.add_argument("-y", "--yes", action="store_true")
            sp.add_argument("-n", "--no-wait", action="store_true")
            sp.add_argument("--wait", type=int, default=300)
            sp.add_argument("--dry-run", action="store_true")
            args = sp.parse_args(rest)
            args.debug = debug
            args.contest = None
            cmd_submit(args)
        return

    args = parser.parse_args(argv)
    args.debug = bool(getattr(args, "debug", False) or debug)
    if args.cmd == "login":
        args.debug = debug
        cmd_login(args)
    elif args.cmd == "accounts":
        cmd_accounts(args)
    elif args.cmd == "account":
        cmd_account(args)
    elif args.cmd == "logout":
        cmd_logout(args)
    elif args.cmd == "whoami":
        cmd_whoami(args)
    elif args.cmd == "oj":
        cmd_oj(args)
    elif args.cmd in ("init", "contest"):
        cmd_init(args)
    elif args.cmd in ("problems", "list"):
        cmd_problems(args)
    elif args.cmd == "status":
        cmd_status(args)
    elif args.cmd == "watch":
        cmd_watch(args)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
