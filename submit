def _qoj_standings_value(page: str, name: str, default=None):
    """Read JSON assignments without executing the page's JavaScript."""
    decoder = json.JSONDecoder()
    for script in re.findall(r"<script\b[^>]*>(.*?)</script>", page, re.I | re.S):
        for match in re.finditer(rf"(?<![\w.$])(?:var\s+|let\s+|const\s+)?{re.escape(name)}\s*=\s*(?!=)", script):
            source = script[match.end():]
            try:
                value, _ = decoder.raw_decode(source)
                return value
            except ValueError:
                quoted = re.match(r"'([^'\\]*)'", source)
                if quoted:
                    return quoted.group(1)
                continue
    return default


def parse_qoj_problem_standings(page: str, contest: dict) -> dict:
    problem_ids = _qoj_standings_value(page, "problems")
    scores = _qoj_standings_value(page, "score")
    if scores == []:
        scores = {}
    if _qoj_standings_value(page, "contest_type") != "ICPC":
        raise OSError("未找到 ICPC 榜单数据，当前榜单类型暂不支持")
    if not isinstance(problem_ids, list) or not isinstance(scores, dict):
        raise OSError("未找到完整榜单数据")
    partial = bool(_qoj_standings_value(page, "icpc_partial_scores", False))
    username = str(contest.get("username") or "")
    if not username:
        raise OSError("无法确定当前账号，请运行 ./submit login")

    def item_at(row, index):
        if isinstance(row, dict):
            return row.get(str(index))
        if isinstance(row, list):
            return row[index] if index < len(row) else None
        raise OSError("榜单的队伍成绩格式异常")

    def accepted(item):
        return item[0] == item[4] or (not partial and item[0] == 97)

    result = {}
    for index, pid in enumerate(problem_ids):
        solved = 0
        for row in scores.values():
            item = item_at(row, index)
            if item is None:
                continue
            if not isinstance(item, list) or len(item) < 6:
                raise OSError("榜单的题目成绩格式异常")
            solved += int(accepted(item))
        own = item_at(scores.get(username, {}), index)
        state = ""
        if own is not None:
            if not isinstance(own[3], int) or own[3] < 0:
                raise OSError("榜单的罚时次数格式异常")
            if own[5] == 1:
                pending = own[7] if partial and len(own) > 7 else own[3] + 1
                state = f"?({pending})"
            elif accepted(own):
                state = f"+({own[3]})"
            else:
                state = f"-({own[3] + 1})"
        result[str(pid)] = {"status": state, "solved": solved}
    known_ids = {str(p["id"]) for p in (contest.get("problems") or {}).values()}
    if not known_ids <= result.keys():
        raise OSError("榜单题目与本地题目列表不一致，请重新绑定比赛")
    return result


def fetch_qoj_problem_standings(client: Client, contest: dict) -> dict:
    endpoint = str(contest["contest_url"]).rstrip("/") + "/standings"
    status, url, page = client.get(endpoint, timeout=15, retries=1, fatal=False)
    if re.search(r"/(?:login|enter)(?:[/?#]|$)", url):
        raise OSError("登录已失效，请运行 ./submit login")
    if _is_cloudflare_block(page):
        raise OSError("榜单被 Cloudflare 拦截，请重新登录")
    if status != 200:
        raise OSError(f"榜单 HTTP {status}")
    return parse_qoj_problem_standings(page, contest)


