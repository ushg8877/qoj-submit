def parse_contest_ref(raw: str, cfg: dict, site_override: Optional[str] = None) -> Tuple[str, str]:
    text = (raw or "").strip()
    m = re.search(r"(https?://[^/]+)/contest/(\d+)", text)
    if m:
        return m.group(1).rstrip("/"), m.group(2)
    if re.fullmatch(r"\d+", text):
        site = (site_override or cfg.get("site") or DEFAULT_SITE).rstrip("/")
        return site, text
    die("请输入比赛 UID，例如 1234")
    raise AssertionError


def bind_contest(
    raw: str,
    *,
    site: Optional[str] = None,
    template: bool = False,
    debug: bool = False,
    quiet: bool = False,
) -> dict:
    cfg = load_global()
    site, contest_id = parse_contest_ref(raw, cfg, site)
    contest_url = f"{site}/contest/{contest_id}"
    client = make_client(cfg, {"site": site}, debug=debug)
    status, url, page = client.get(contest_url)
    if not looks_logged_in(page, url, expect=cfg.get("username") or "") and "/login" in url:
        die("未登录或 Cookie 失效，请先 python3 submit login")

    problems = parse_contest_problems(page, site, contest_id)
    if not problems:
        die("没有解析到题目。请确认已经登录，且比赛 UID 正确")
    name = parse_contest_name(page) or f"Contest {contest_id}"
    username = extract_username(page) or cfg.get("username") or ""
    data = {
        "site": site,
        "contest_id": contest_id,
        "contest_url": contest_url,
        "name": name,
        "username": username,
        "problems": problems,
    }
    dest_dir = Path.cwd()
    contest_path = dest_dir / CONTEST_FILE
    save_json(contest_path, data)
    cfg["site"] = site
    cfg["contest"] = data
    save_global(cfg)
    copied = copy_self_to(dest_dir)
    if template:
        _write_templates(dest_dir, problems.keys())
    if not quiet:
        ok(f"已绑定比赛: {name}")
        info(f"UID: {contest_id}  {contest_url}")
        info(f"配置: {contest_path}")
        if copied:
            info(f"提交命令: {copied}")
        _print_problems(problems)
        print()
        info("接下来:  python3 submit a.cpp")
    return data


