    else:
        dest = Path.home() / ".local" / "share" / "qoj-xcpc" / "firefox-profile"
    dest.mkdir(parents=True, exist_ok=True)
    return dest


def _unlock_browser_profile(profile: Path) -> None:
    if not profile.is_dir():
        return
    for name in (
        "lock",
        "parent.lock",
        ".parentlock",
        "SingletonLock",
        "SingletonSocket",
        "SingletonCookie",
    ):
        path = profile / name
        try:
            if path.is_file() or path.is_symlink():
                path.unlink()
        except OSError:
            pass


def _proc_cmdline(pid: int) -> str:
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return ""
    return raw.replace(b"\0", b" ").decode("utf-8", "replace").strip()


def _proc_comm(pid: int) -> str:
    try:
        return Path(f"/proc/{pid}/comm").read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return ""


def _is_self_login_process(pid: int, me: int, my_exe: str) -> bool:
    if pid <= 1 or pid == me or pid == os.getppid():
        return True
    cmd = _proc_cmdline(pid)
    if not cmd:
        return False
    try:
        exe = os.readlink(f"/proc/{pid}/exe")
    except OSError:
        exe = ""
    blob = f"{exe} {cmd}".replace("\\", "/")
    if my_exe:
        try:
            if exe and Path(exe).resolve() == Path(my_exe).resolve() and "submit" in cmd:
                return True
        except OSError:
            pass
    if "qoj-xcpc/venv" in blob and "submit" in cmd:
        return True
    return False


def _is_stale_login_browser(pid: int) -> bool:
    comm = _proc_comm(pid)
    cmd = _proc_cmdline(pid)
    blob = f"{comm} {cmd}"
    if comm in ("geckodriver", "chromedriver") or "geckodriver" in cmd or "chromedriver" in cmd:
        return True
    if "qoj-submit-profile" in blob:
        return True
    if "qoj-xcpc/firefox-profile" in blob or "qoj-xcpc/chromium-profile" in blob:
        return True
    if "--marionette" in cmd:
        return True
    return False


def _kill_stale_login_browsers() -> None:
    if os.name == "nt" or not Path("/proc").is_dir():
        return
    warn("正在结束上次登录残留的 geckodriver / 独立配置 Firefox（不会关掉你日常用的 Firefox）")
    me = os.getpid()
    try:
        my_exe = os.readlink(f"/proc/{me}/exe")
    except OSError:
        my_exe = sys.executable
    targets: List[int] = []
    try:
        names = os.listdir("/proc")
    except OSError:
        return
    for name in names:
        if not name.isdigit():
            continue
        pid = int(name)
        if _is_self_login_process(pid, me, my_exe):
            continue
        if _is_stale_login_browser(pid):
            targets.append(pid)
    for pid in targets:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    if targets:
        time.sleep(0.8)
        for pid in targets:
            try:
                os.kill(pid, 0)
            except OSError:
                continue
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
        time.sleep(0.4)


def _start_ua_sniffer() -> Tuple[object, dict]:
    from http.server import BaseHTTPRequestHandler, HTTPServer

    captured = {"ua": ""}

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            captured["ua"] = self.headers.get("User-Agent") or captured["ua"]
            body = (
                "<html><body style='font-family:sans-serif;padding:2em'>"
                "<p>已记录浏览器 User-Agent。请回到 <b>QOJ 登录</b> 标签页完成验证并登录。</p>"
                "</body></html>"
            ).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *_args):
            return

    httpd = HTTPServer(("127.0.0.1", 0), Handler)
    threading.Thread(target=httpd.serve_forever, daemon=True).start()
    return httpd, captured


def _start_real_browser(
    kind: str, binary: str, site: str, profile: Path, port: int, extra_url: str = ""
) -> Tuple[subprocess.Popen, Path]:
    profile.mkdir(parents=True, exist_ok=True)
    _unlock_browser_profile(profile)
    url = site.rstrip("/") + "/logout"
    env = os.environ.copy()
    log_path = profile / "launch.log"
    if kind == "firefox":
        env["MOZ_NO_REMOTE"] = "1"
        env["MOZ_DISABLE_AUTO_SAFE_MODE"] = "1"
        cmd = [binary, "-no-remote", "--profile", str(profile), url]
    else:
        cmd = [
            binary,
            f"--remote-debugging-port={port}",
            "--remote-debugging-address=127.0.0.1",
            f"--user-data-dir={profile}",
            "--no-first-run",
            "--no-default-browser-check",
            "--disable-dev-shm-usage",
            "--no-sandbox",
            "--new-window",
            url,
        ]
    if extra_url:
        cmd.append(extra_url)
    logf = open(log_path, "wb")
    proc = subprocess.Popen(
        cmd,
        stdout=logf,
        stderr=subprocess.STDOUT,
        start_new_session=True,
        env=env,
    )
    return proc, log_path


def _login_real_browser(site: str) -> Optional[Tuple[str, str, str]]:
    if not _linux_display_ok():
        warn("当前没有图形界面。请在虚拟机桌面终端运行 python3 submit login")
        return None
    binaries = _browser_binaries()
    if not binaries:
        warn("没有找到 firefox / chromium / chrome，请先: sudo apt install firefox")
        return None

    info("正在关闭上次登录残留的 Firefox / geckodriver ...")
    _kill_stale_login_browsers()
    _clear_qoj_session_cookies(_firefox_profile_dir())
    _clear_qoj_session_cookies(Path.home() / ".local" / "share" / "qoj-xcpc" / "chromium-profile")

    httpd, captured = _start_ua_sniffer()
    try:
        for kind, binary in binaries:
            port = _free_port()
            if kind == "firefox":
                profile = _firefox_profile_dir()
            else:
                profile = Path.home() / ".local" / "share" / "qoj-xcpc" / "chromium-profile"
            sniff_url = f"http://127.0.0.1:{httpd.server_address[1]}/"
            ff_ua = _firefox_user_agent(binary, profile) if kind == "firefox" else DEFAULT_UA
            info(f"正在打开普通 {kind}")
            info(f"  程序: {binary}")
            info(f"  配置: {profile}")
            info("会先退出窗口里的旧账号。请在登录页登录要换的账号（含 Cloudflare）")
            try:
                proc, log_path = _start_real_browser(
                    kind, binary, site, profile, port, extra_url=sniff_url
                )
            except Exception as exc:
                warn(f"启动 {binary} 失败: {exc}")
                continue
            try:
                time.sleep(2.0)
                if proc.poll() is not None:
                    tail = ""
                    try:
                        tail = log_path.read_text(encoding="utf-8", errors="replace")[-2000:]
                    except OSError:
                        pass
                    warn(f"{kind} 启动后立刻退出。日志:\n{tail or '(无)'}")
                    continue
                cdp_ok = False
                if kind != "firefox":
                    cdp_ok = _wait_debug_port(port, proc)
                deadline = time.time() + 900
                last_cookie, last_ua, last_html = "", captured.get("ua") or ff_ua, ""
                seen_logged_out = False
                names0 = _firefox_sqlite_cookies(profile) if kind == "firefox" else {}
                if not names0.get("UOJSESSID") and not names0.get("uoj_username"):
                    seen_logged_out = True
                last_hint = 0.0
                while time.time() < deadline:
                    if proc.poll() is not None:
                        tail = ""
                        try:
                            tail = log_path.read_text(encoding="utf-8", errors="replace")[-1500:]
                        except OSError:
                            pass
                        warn(f"{kind} 窗口已关闭。{tail}")
                        break
                    cookie = ua = html = ""
                    if cdp_ok:
                        try:
                            cookie, ua, html = _cdp_harvest(port)
                        except Exception:
                            cdp_ok = _wait_debug_port(port, proc, seconds=1)
                    if not cookie and kind == "firefox":
                        names = _firefox_sqlite_cookies(profile)
                        cookie = "; ".join(f"{k}={v}" for k, v in names.items())
                    ua = ua or captured.get("ua") or last_ua or ff_ua
                    ready = bool(cookie) and _session_ready(cookie, html)
                    if ready and seen_logged_out:
                        last_cookie, last_ua, last_html = cookie, ua, html or last_html
                        ok("已检测到新的 QOJ 登录")
                        return cookie, ua, html
                    if ready and not seen_logged_out:
                        now = time.time()
                        if now - last_hint > 8:
                            info("窗口里还是旧账号。请点 Logout，再登录新账号")
                            last_hint = now
                    else:
                        seen_logged_out = True
                        if cookie:
                            last_cookie, last_ua, last_html = cookie, ua, html or last_html
                    time.sleep(1.2)
                if seen_logged_out and _session_ready(last_cookie, last_html):
                    return last_cookie, last_ua, last_html
            finally:
                try:
                    proc.terminate()
                except Exception:
                    pass
    finally:
        try:
            httpd.shutdown()
        except Exception:
            pass
    return None


def login_via_browser(site: str) -> Tuple[str, str, str]:
    got = _login_real_browser(site)
    if got:
        cookie, ua, html = got
        if cookie_names(cookie).get("UOJSESSID") or looks_logged_in(html):
            info("已用普通浏览器完成登录")
            return cookie, ua, html
    die(
        "未能用普通 Firefox 登录。请关掉弹出的 QOJ 窗口后重试:\n"
        "  python3 submit login\n"
        "不要用带“自动化控制”提示的窗口。"
    )
