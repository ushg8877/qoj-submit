def _browser_binaries() -> List[Tuple[str, str]]:
    found: List[Tuple[str, str]] = []
    seen = set()
    firefox_paths = [
        "/usr/lib/firefox-esr/firefox",
        "/usr/lib/firefox/firefox",
        "/usr/bin/firefox-esr",
        "/usr/bin/firefox",
        _which("firefox-esr"),
        _which("firefox"),
    ]
    chrome_paths = [
        _which("chromium"),
        _which("chromium-browser"),
        _which("google-chrome-stable"),
        _which("google-chrome"),
        "/usr/bin/chromium",
        "/usr/bin/chromium-browser",
    ]
    ranked: List[Tuple[int, str, str]] = []
    for path in firefox_paths:
        if not path:
            continue
        p = str(Path(path))
        if not Path(p).exists() or p in seen:
            continue
        seen.add(p)
        snap = 1 if "snap" in str(Path(p).resolve()).lower() else 0
        ranked.append((snap, "firefox", p))
    ranked.sort()
    for _, kind, p in ranked:
        found.append((kind, p))
    for path in chrome_paths:
        if not path:
            continue
        p = str(Path(path))
        if Path(p).exists() and p not in seen:
            seen.add(p)
            found.append(("chromium", p))
    return found


def _firefox_profile_dir() -> Path:
    snap_common = Path.home() / "snap" / "firefox" / "common"
    if snap_common.is_dir():
        dest = snap_common / "qoj-submit-profile"
    else:
        dest = Path.home() / ".local" / "share" / "qoj-xcpc" / "firefox-profile"
    dest.mkdir(parents=True, exist_ok=True)
    return dest


def _firefox_profile_roots(binary: str = "") -> List[Path]:
    snap = Path.home() / "snap" / "firefox" / "common" / ".mozilla" / "firefox"
    native = Path.home() / ".mozilla" / "firefox"
    blob = (binary or "").lower()
    try:
        if binary:
            blob += " " + str(Path(binary).resolve()).lower()
    except OSError:
        pass
    if "snap" in blob or (snap / "profiles.ini").is_file():
        return [snap, native]
    return [native, snap]


def _parse_firefox_profiles_ini(root: Path) -> Optional[Path]:
    ini = root / "profiles.ini"
    if not ini.is_file():
        return None
    try:
        text = ini.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None
    sections: List[dict] = []
    cur: dict = {}
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("[") and line.endswith("]"):
            if cur:
                sections.append(cur)
            cur = {"_name": line[1:-1]}
            continue
        if "=" in line and cur:
            key, value = line.split("=", 1)
            cur[key.strip()] = value.strip()
    if cur:
        sections.append(cur)

    def resolve(path: str, relative: bool) -> Optional[Path]:
        dest = root / path if relative else Path(path)
        if dest.is_dir() and "qoj-submit-profile" not in str(dest):
            return dest
        return None

    for sec in sections:
        if sec.get("Default") == "1" and sec.get("Path"):
            found = resolve(sec["Path"], sec.get("IsRelative", "1") != "0")
            if found:
                return found
    for sec in sections:
        if str(sec.get("_name") or "").startswith("Install") and sec.get("Default"):
            found = resolve(sec["Default"], True)
            if found:
                return found
    for sec in sections:
        if sec.get("Path"):
            found = resolve(sec["Path"], sec.get("IsRelative", "1") != "0")
            if found:
                return found
    return None


def _iter_firefox_profiles(binary: str = "") -> List[Path]:
    seen = set()
    out: List[Path] = []
    for root in _firefox_profile_roots(binary):
        guessed = _parse_firefox_profiles_ini(root)
        if guessed and guessed not in seen:
            seen.add(guessed)
            out.append(guessed)
        if not root.is_dir():
            continue
        try:
            kids = list(root.iterdir())
        except OSError:
            continue
        for child in kids:
            if not child.is_dir() or "qoj-submit-profile" in child.name:
                continue
            if not (child / "cookies.sqlite").is_file():
                continue
            if child in seen:
                continue
            seen.add(child)
            out.append(child)
    return out


def _firefox_default_profile(binary: str = "", host: str = "") -> Optional[Path]:
    profiles = _iter_firefox_profiles(binary)
    if not profiles:
        return None
    needles = [host] if host else []
    if host and "codeforces" in host:
        needles = ["codeforces.com", "codeforces.org"]
    best = None
    best_score = -1
    for profile in profiles:
        names = _firefox_sqlite_cookies(profile, needles or None) if needles else {}
        score = 0
        if names.get("X-User") or names.get("X-User-Sha1"):
            score += 3
        if names.get("JSESSIONID"):
            score += 2
        if names.get("cf_clearance"):
            score += 1
        if any(names.get(n) for n in QOJ_SESSION_COOKIE_NAMES):
            score += 3
        if score > best_score:
            best_score = score
            best = profile
    if best_score > 0:
        return best
    return profiles[0]


def _unlock_browser_profile(profile: Path) -> None:
    if not profile.is_dir():
        return
    for name in (
        "lock",
        "parent.lock",
        ".parentlock",
        "SingletonLock",
        "SingletonSocket",
        "SingletonCookie",
    ):
        path = profile / name
        try:
            if path.is_file() or path.is_symlink():
                path.unlink()
        except OSError:
            pass


def _proc_cmdline(pid: int) -> str:
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return ""
    return raw.replace(b"\0", b" ").decode("utf-8", "replace").strip()


def _proc_comm(pid: int) -> str:
    try:
        return Path(f"/proc/{pid}/comm").read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return ""


def _is_self_login_process(pid: int, me: int, my_exe: str) -> bool:
    if pid <= 1 or pid == me or pid == os.getppid():
        return True
    cmd = _proc_cmdline(pid)
    if not cmd:
        return False
    try:
        exe = os.readlink(f"/proc/{pid}/exe")
    except OSError:
        exe = ""
    blob = f"{exe} {cmd}".replace("\\", "/")
    if my_exe:
        try:
            if exe and Path(exe).resolve() == Path(my_exe).resolve() and "submit" in cmd:
                return True
        except OSError:
            pass
    if "qoj-xcpc/venv" in blob and "submit" in cmd:
        return True
    return False


def _is_stale_login_browser(pid: int) -> bool:
    comm = _proc_comm(pid)
    cmd = _proc_cmdline(pid)
    blob = f"{comm} {cmd}"
    if comm in ("geckodriver", "chromedriver") or "geckodriver" in cmd or "chromedriver" in cmd:
        return True
    if "qoj-submit-profile" in blob:
        return True
    if "qoj-xcpc/firefox-profile" in blob or "qoj-xcpc/chromium-profile" in blob:
        return True
    if "--marionette" in cmd:
        return True
    return False


def _kill_stale_login_browsers() -> None:
    if os.name == "nt" or not Path("/proc").is_dir():
        return
    warn("正在结束上次登录残留的 geckodriver / 独立配置 Firefox（不会关掉你日常用的 Firefox）")
    me = os.getpid()
    try:
        my_exe = os.readlink(f"/proc/{me}/exe")
    except OSError:
        my_exe = sys.executable
    targets: List[int] = []
    try:
        names = os.listdir("/proc")
    except OSError:
        return
    for name in names:
        if not name.isdigit():
            continue
        pid = int(name)
        if _is_self_login_process(pid, me, my_exe):
            continue
        if _is_stale_login_browser(pid):
            targets.append(pid)
    for pid in targets:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    if targets:
        time.sleep(0.8)
        for pid in targets:
            try:
                os.kill(pid, 0)
            except OSError:
                continue
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
        time.sleep(0.4)


def _start_ua_sniffer() -> Tuple[object, dict]:
    from http.server import BaseHTTPRequestHandler, HTTPServer

    captured = {"ua": ""}

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            captured["ua"] = self.headers.get("User-Agent") or captured["ua"]
            body = (
                "<html><body style='font-family:sans-serif;padding:2em'>"
                "<p>已记录浏览器 User-Agent。请回到登录标签页完成验证并登录。</p>"
                "</body></html>"
            ).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *_args):
            return

    httpd = HTTPServer(("127.0.0.1", 0), Handler)
    threading.Thread(target=httpd.serve_forever, daemon=True).start()
    return httpd, captured


def _start_real_browser(
    kind: str,
    binary: str,
    site: str,
    profile: Path,
    port: int,
    extra_url: str = "",
    isolated: bool = True,
) -> Tuple[subprocess.Popen, Path]:
    if isolated:
        profile.mkdir(parents=True, exist_ok=True)
        _unlock_browser_profile(profile)
    if is_codeforces(site):
        url = site.rstrip("/") + "/enter"
    else:
        url = site.rstrip("/") + "/"
    env = os.environ.copy()
    log_path = (profile / "launch.log") if isolated else Path(tempfile.gettempdir()) / "qoj-cf-firefox.log"
    if kind == "firefox" and not isolated:
        env.pop("MOZ_NO_REMOTE", None)
        cmd = [binary, "--new-window", url]
    elif kind == "firefox":
        env["MOZ_NO_REMOTE"] = "1"
        env["MOZ_DISABLE_AUTO_SAFE_MODE"] = "1"
        cmd = [binary, "-no-remote", "--profile", str(profile), url]
    else:
        cmd = [
            binary,
            f"--remote-debugging-port={port}",
            "--remote-debugging-address=127.0.0.1",
            f"--user-data-dir={profile}",
            "--no-first-run",
            "--no-default-browser-check",
            "--disable-dev-shm-usage",
            "--no-sandbox",
            "--new-window",
            url,
        ]
    if extra_url:
        cmd.append(extra_url)
    if is_codeforces(site):
        cmd.append(site.rstrip("/") + "/profile")
    logf = open(log_path, "wb")
    proc = subprocess.Popen(
        cmd,
        stdout=logf,
        stderr=subprocess.STDOUT,
        start_new_session=True,
        env=env,
    )
    return proc, log_path


def _account_browser_profile(kind: str, site: str, username: str) -> Path:
    # Hash path components: usernames and custom hosts may contain slashes.
    ident = hashlib.sha256((account_key(site) + "\0" + username).encode()).hexdigest()[:24]
    snap_common = Path.home() / "snap" / "firefox" / "common"
    if kind == "firefox" and snap_common.is_dir():
        root = snap_common
    else:
        root = Path.home() / ".local" / "share" / "qoj-xcpc"
    return root / f"qoj-submit-profile-{kind}-{ident}"


