def resolve_source(name: str) -> Path:
    path = Path(name)
    if path.is_file():
        return path
    if path.suffix:
        die(f"文件不存在: {name}")
    for ext in EXT_CANDIDATES:
        cand = Path(name + ext)
        if cand.is_file():
            return cand
        cand = Path(name.lower() + ext)
        if cand.is_file():
            return cand
        cand = Path(name.upper() + ext)
        if cand.is_file():
            return cand
    die(f"找不到源文件 {name} / {name}.cpp / {name}.py ...")
    raise AssertionError


def letter_from_filename(path: Path, problems: dict, explicit: Optional[str]) -> str:
    if explicit:
        letter = explicit.strip().upper()
        if letter not in problems:
            die(f"没有题目 {letter}。已有: {', '.join(sorted(problems, key=lambda x: (len(x), x)))}")
        return letter
    stem = path.stem
    m = re.match(r"^([A-Za-z])", stem)
    if not m:
        die("无法从文件名判断题号，请使用 a.cpp / b.cpp，或加 --problem A")
    letter = m.group(1).upper()
    if letter not in problems:
        die(
            f"文件 {path.name} 对应题目 {letter}，但本场没有这题。\n"
            f"已有: {', '.join(sorted(problems, key=lambda x: (len(x), x)))}"
        )
    return letter


def submissions_list_urls(
    contest: dict,
    problem_id: Optional[str] = None,
    site_wide: bool = False,
) -> List[str]:
    username = contest.get("username") or ""
    site = (contest.get("site") or "").rstrip("/")
    contest_url = contest["contest_url"].rstrip("/")
    params = {}
    if username:
        params["submitter"] = username
    if problem_id:
        params["problem_id"] = problem_id
    q = ("?" + urlencode(params)) if params else ""
    urls = [contest_url + "/submissions" + q]
    if site_wide and site:
        urls.append(site + "/submissions" + q)
    if problem_id:
        params2 = dict(params)
        params2.pop("problem_id", None)
        q2 = ("?" + urlencode(params2)) if params2 else ""
        urls.append(contest_url + "/submissions" + q2)
    out: List[str] = []
    for item in urls:
        if item not in out:
            out.append(item)
    return out


def fetch_submission_rows(
    client: Client,
    contest: dict,
    problem_id: Optional[str] = None,
    timeout: int = 10,
    retries: int = 0,
    site_wide: bool = False,
) -> List[dict]:
    last_err: Optional[BaseException] = None
    for url in submissions_list_urls(contest, problem_id, site_wide=site_wide):
        try:
            _, _, page = client.get(url, timeout=timeout, retries=retries, fatal=False)
        except (TimeoutError, OSError) as exc:
            last_err = exc
            continue
        rows = [
            row for row in parse_submission_rows(page)
            if _submission_row_matches(row, contest, problem_id)
        ]
        if rows:
            return rows
    if last_err:
        raise last_err
    return []


def latest_ids(client: Client, contest: dict, problem_id: Optional[str] = None) -> List[str]:
    return [
        r["id"]
        for r in fetch_submission_rows(client, contest, problem_id, site_wide=True)
    ]


def wait_for_new_sid(
    client: Client,
    contest: dict,
    problem_id: str,
    before: List[str],
    seconds: float = 8,
) -> Optional[str]:
    info("正在确认提交号...")
    known = set(before)
    deadline = time.time() + seconds
    last_talk = 0.0
    while time.time() < deadline:
        try:
            after = latest_ids(client, contest, problem_id)
        except (TimeoutError, OSError):
            time.sleep(0.8)
            continue
        for item in after:
            if item not in known:
                return item
        now = time.time()
        if now - last_talk > 5:
            info("还没有看到新提交，继续查...")
            last_talk = now
        time.sleep(0.6)
    return None


def format_ago(ts: float) -> str:
    try:
        delta = int(time.time() - ts)
    except (TypeError, OverflowError, OSError):
        return "?"
    if delta < 0:
        return "刚刚"
    if delta < 5:
        return "刚刚"
    if delta < 60:
        return f"{delta} 秒前"
    if delta < 3600:
        return f"{delta // 60} 分钟前"
    if delta < 86400:
        hours, minutes = divmod(delta // 60, 60)
        if minutes:
            return f"{hours} 小时 {minutes} 分钟前"
        return f"{hours} 小时前"
    days = delta // 86400
    return f"{days} 天前"


def file_mtime(path: Path) -> str:
    try:
        return format_ago(path.stat().st_mtime)
    except OSError:
        return "?"


def cached_last_submit(contest: dict, problem_id: str) -> Tuple[str, Optional[float]]:
    rec = (contest.get("last_submit") or {}).get(str(problem_id)) or {}
    sid = str(rec.get("sid") or "")
    try:
        ts = float(rec["ts"]) if rec.get("ts") is not None else None
    except (TypeError, ValueError):
        ts = None
    return sid, ts


def remember_submit(contest_path: Path, contest: dict, problem_id: str, sid: str) -> None:
    rec = contest.setdefault("last_submit", {})
    rec[str(problem_id)] = {"sid": str(sid), "ts": time.time()}
    if contest_path.name == CONTEST_FILE:
        try:
            save_json(contest_path, contest)
        except OSError:
            pass
    cfg = load_global()
    cached = cfg.get("contest")
    if isinstance(cached, dict) and str(cached.get("contest_id")) == str(contest.get("contest_id")):
        cfg["contest"] = contest
        save_global(cfg)


def confirm_or_abort(prompt: str = "确认提交? [Y/n] ") -> None:
    try:
        ans = input(prompt).strip().lower()
    except EOFError:
        ans = ""
    if ans in ("n", "no", "q", "quit"):
        die("已取消")


def _load_submit_context(
    client: Client,
    contest: dict,
    problem: dict,
    expect: str,
    on_fetch=None,
) -> Tuple[str, int, str, str, List[str], bool, str, Optional[float]]:
    problem_url, status, url, page = _fetch_problem_submit_page(
        client, contest, problem, on_fetch=on_fetch
    )
    if _is_cloudflare_block(page):
        die("被 Cloudflare 拦截。请重新: python3 submit login")
    if not looks_logged_in(page, url, expect=expect) and "/login" in (url or ""):
        die("未登录或 Cookie 已过期。请先: python3 submit login")
    before: List[str] = []
    last_sid, last_ts = "", None
    list_timeout = False
    try:
        if on_fetch:
            on_fetch("submissions")
        rows = fetch_submission_rows(client, contest, problem["id"])
        before = [r["id"] for r in rows]
        if rows:
            last_sid = rows[0]["id"]
            last_ts = rows[0].get("submit_ts")
    except (TimeoutError, OSError):
        list_timeout = True
    return problem_url, status, url, page, before, list_timeout, last_sid, last_ts


def cmd_submit(args: argparse.Namespace) -> None:
    cfg = load_global()
    if getattr(args, "contest", None):
        bind_contest(str(args.contest), debug=bool(args.debug), quiet=True)
    contest_path, contest = require_contest()
    problems = contest.get("problems") or {}
    if not problems:
        die("比赛配置里没有题目。请先: python3 submit 1234")
    src = resolve_source(args.file)
    letter = letter_from_filename(src, problems, args.problem)
    problem = problems[letter]
    suffix = src.suffix.lower()
    try:
        code = src.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        code = src.read_text(encoding="gbk")
    if not code.strip():
        die(f"{src.name} 是空文件")

    lang_field, options = "answer_answer_language", list(DEFAULT_QOJ_LANGS)
    lang = pick_language(options, suffix, args.lang)

    try:
        mtime = src.stat().st_mtime
    except OSError:
        mtime = 0.0
    cached_sid, cached_ts = cached_last_submit(contest, problem["id"])

    print(paint("== submit ==", "1"), flush=True)
    print(f"  contest  {contest.get('name')}", flush=True)
    print(f"  problem  {letter}  {problem['title']}  (#{problem['id']})", flush=True)
    print(f"  file     {src}", flush=True)
    print(f"  mtime    {file_mtime(src)}", flush=True)
    print(f"  lang     {lang}", flush=True)
    warned_stale = False
    if cached_ts is not None and mtime and mtime <= cached_ts + 1:
        warn(f"文件上次修改早于上次提交 #{cached_sid or '?'}，可能是旧代码")
        warned_stale = True
    if args.dry_run:
        warn("dry-run，没有真正提交")
        return

    client = make_client(cfg, contest, debug=args.debug)
    expect = contest.get("username") or cfg.get("username") or ""
    talk = {"on": False}

    def on_fetch(what: str) -> None:
        if not talk["on"]:
            return
        if what == "submissions":
            info("正在读取提交记录...")
        else:
            info(f"正在打开 {what}")

    box: dict = {"data": None, "exc": None}

    def _prefetch() -> None:
        try:
            box["data"] = _load_submit_context(
                client, contest, problem, expect, on_fetch=on_fetch
            )
        except BaseException as exc:
            box["exc"] = exc

    worker = threading.Thread(target=_prefetch, daemon=True)
    worker.start()
    if not getattr(args, "yes", False):
        confirm_or_abort()
    talk["on"] = True
    if worker.is_alive():
        info("正在打开提交页...")
    worker.join()
    if box["exc"] is not None:
        exc = box["exc"]
        if isinstance(exc, SystemExit):
            raise exc
        raise exc
    problem_url, status, url, page, before, list_timeout, list_sid, list_ts = box["data"]
    if list_timeout:
        warn("拉取提交列表超时，仍继续提交")
    if not warned_stale and list_ts is not None and mtime and mtime <= list_ts + 1:
        warn(f"文件上次修改早于上次提交 #{list_sid or '?'}，可能是旧代码")
    token = extract_token(page)
    if not token:
        die("没有拿到 CSRF token，页面可能不是提交页")
    if re.search(r'name=["\']answer_Anna_language["\']', page):
        die("这是交互/通信题（Anna/Bruno），请到网页提交")
    parsed_field, parsed_opts = collect_language_options(page)
    if parsed_opts:
        lang_field, options = parsed_field, parsed_opts
        lang = pick_language(options, suffix, args.lang)
    btn_name, btn_val = extract_submit_button(page)

    post_candidates: List[str] = []
    for item in (
        problem_url,
        url.split("#")[0] if url else "",
        extract_form_action(page, url or problem_url),
        canonical_problem_url(problem_url) + "?tab=submit-answer",
        canonical_problem_url(problem_url) + "/submit",
        (url or problem_url).split("#")[0],
    ):
        item = (item or "").split("#")[0]
        if item and item not in post_candidates:
            post_candidates.append(item)

    info("正在提交...")
    fields = {
        "_token": token,
        lang_field: lang,
        "answer_answer_upload_type": "editor",
        "answer_answer_editor": code,
        btn_name: btn_val,
    }
    files = {
        "answer_answer_file": ("", b"", "application/octet-stream"),
    }
    status, resp_url, resp = 0, "", ""
    used_post = post_candidates[0]
    timed_out = False
    for post_url in post_candidates:
        used_post = post_url
        info(f"POST {post_url}")
        try:
            status, resp_url, resp = client.post_multipart(
                post_url, fields, files=files, referer=url or post_url, fatal=False
            )
        except TimeoutError:
            warn("提交响应超时，正在查是否已经交上去（不要重复提交）...")
            client._rebuild_opener()
            timed_out = True
            status, resp_url, resp = 0, "", ""
            break
        bounced = status in (301, 302, 303) and "/statement/" in (resp_url or "")
        if bounced:
            warn("这个地址会跳回题面，换 Submit 地址再试")
            continue
        break
    else:
        die(
            "提交一直被重定向到题面页。QOJ 需要先打开题目再点 Submit。\n"
            "请把浏览器地址栏在点击 Submit 之后的完整 URL 发过来。"
        )
    url = resp_url
    if not timed_out:
        info(f"服务器已响应 HTTP {status}")
        alert = extract_alerts(resp)
        if alert:
            die(f"提交被拒绝: {alert}")
        if "/login" in (url or ""):
            die("提交时登录已失效，请 python3 submit login")
        if status in (301, 302, 303) and "/statement/" in (url or ""):
            die(
                "提交被重定向到题面页，请求没有当成交题处理。\n"
                "请在浏览器打开题目，点 Submit 确认能交，然后 ./submit status"
            )
        if status >= 400:
            die(f"提交 HTTP {status}  {url}")

    sid = None
    loc_sid = re.search(r"/submission/(\d+)", url or "")
    if loc_sid:
        sid = loc_sid.group(1)
    from_resp = [r["id"] for r in parse_submission_rows(resp)]
    if not sid and ("/submissions" in (url or "") or "/submission/" in (url or "")):
        for item in from_resp:
            if item not in before:
                sid = item
                break
        if not sid and from_resp:
            sid = from_resp[0]
    if not sid:
        sid = wait_for_new_sid(
            client, contest, problem["id"], before, seconds=20 if timed_out else 8
        )

    if sid and sid not in before:
        board = f"{contest['contest_url'].rstrip('/')}/submissions"
        ok(f"已提交 #{sid}")
        remember_submit(contest_path, contest, problem["id"], sid)
        info(f"评测结果见 {board}")
        return
    if sid and sid in before:
        die(
            f"没有交上去。提交列表还是原来的 #{sid}。\n"
            f"最终 URL: {url}\n"
            f"标题: {_page_title(resp) or '(无)'}\n"
            "请 ./submit status 核对，不要连续重复提交。"
        )
    die(
        "没有交上去（提交响应超时或没有新的提交记录）。\n"
        f"HTTP {status}  {url}\n"
        f"标题: {_page_title(resp) or '(无)'}\n"
        "请先 ./submit status 核对，不要连续重复提交。"
    )


