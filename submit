def color_enabled() -> bool:
    if os.environ.get("NO_COLOR"):
        return False
    if os.environ.get("FORCE_COLOR"):
        return True
    return sys.stdout.isatty()


def paint(text: str, code: str) -> str:
    if not color_enabled():
        return text
    return f"\033[{code}m{text}\033[0m"


def info(msg: str) -> None:
    print(paint("[i] ", "36") + msg, flush=True)


def ok(msg: str) -> None:
    print(paint("[ok] ", "32") + msg, flush=True)


def warn(msg: str) -> None:
    print(paint("[!] ", "33") + msg, flush=True)


def die(msg: str, code: int = 1) -> None:
    print(paint("[x] ", "31") + msg, file=sys.stderr, flush=True)
    raise SystemExit(code)


def verdict_color(text: str) -> str:
    low = text.lower()
    if any(x in low for x in ("accepted", "正确", "ac")) and "not" not in low:
        return paint(text, "32;1")
    if any(x in low for x in ("waiting", "judging", "pending", "等待", "评测", "排队")):
        return paint(text, "33")
    return paint(text, "31")


def xdg_config_dir() -> Path:
    if os.name == "nt":
        base = os.environ.get("APPDATA") or str(Path.home() / "AppData" / "Roaming")
        return Path(base) / APP_NAME
    xdg = os.environ.get("XDG_CONFIG_HOME")
    if xdg:
        return Path(xdg) / APP_NAME
    return Path.home() / ".config" / APP_NAME


def global_config_path() -> Path:
    return xdg_config_dir() / "config.json"


def find_contest_file(start: Optional[Path] = None) -> Optional[Path]:
    cur = (start or Path.cwd()).resolve()
    for path in [cur, *cur.parents]:
        candidate = path / CONTEST_FILE
        if candidate.is_file():
            return candidate
        if path.parent == path:
            break
    return None


def load_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        die(f"找不到配置文件: {path}")
    except json.JSONDecodeError as exc:
        die(f"配置文件不是合法 JSON: {path} ({exc})")
    return {}


def save_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def load_global() -> dict:
    path = global_config_path()
    if not path.is_file():
        return {}
    return load_json(path)


def save_global(data: dict) -> None:
    save_json(global_config_path(), data)


def strip_html(text: str) -> str:
    text = re.sub(r"<[^>]+>", " ", text)
    text = htmlmod.unescape(text)
    return re.sub(r"\s+", " ", text).strip()


def norm_lang(text: str) -> str:
    text = htmlmod.unescape(text).lower()
    text = re.sub(r"\([^)]*\)", "", text)
    return re.sub(r"[^a-z0-9+]+", "", text)


def parse_cookie_input(raw: str) -> str:
    """Accept a Cookie header, or a JSON object (including 请求 Cookie)."""
    text = (raw or "").strip()
    if text.lower().startswith("cookie:"):
        text = text.split(":", 1)[1].strip()
    if not text:
        return ""
    if text[0] in "{[":
        try:
            data = json.loads(text)
        except json.JSONDecodeError as exc:
            die(f"Cookie JSON 解析失败: {exc}")
        if isinstance(data, dict) and len(data) == 1:
            only = next(iter(data.values()))
            if isinstance(only, dict) and any(
                k in only for k in ("UOJSESSID", "cf_clearance", "uoj_username")
            ):
                data = only
        if not isinstance(data, dict):
            die("Cookie JSON 需要是对象，例如 {\"UOJSESSID\": \"...\"}")
        skip = {"请求 cookie", "request cookie", "cookie"}
        pairs = []
        for key, value in data.items():
            if str(key).strip().lower() in skip:
                continue
            if value is None or isinstance(value, (dict, list)):
                continue
            pairs.append(f"{key}={value}")
        if not pairs:
            die("Cookie JSON 里没有 UOJSESSID / cf_clearance 等字段")
        return "; ".join(pairs)
    return text


def cookie_names(header: str) -> Dict[str, str]:
    out: Dict[str, str] = {}
    for part in header.split(";"):
        part = part.strip()
        if not part or "=" not in part:
            continue
        name, value = part.split("=", 1)
        out[name.strip()] = value.strip()
    return out


def _network_error_kind(exc: BaseException) -> str:
    parts = [str(exc)]
    reason = getattr(exc, "reason", None)
    if reason is not None:
        parts.append(str(reason))
    text = " ".join(parts).lower()
    if "handshake" in text:
        return "handshake"
    if isinstance(exc, ssl.SSLError) or isinstance(reason, ssl.SSLError):
        return "handshake"
    if "ssl" in text and ("timed out" in text or "timeout" in text):
        return "handshake"
    if any(
        s in text
        for s in (
            "timed out",
            "timeout",
            "deadline",
            "temporarily",
            "connection reset",
            "connection aborted",
            "broken pipe",
            "unreachable",
        )
    ):
        return "timeout"
    return "other"


class Client:
    def __init__(self, site: str, cookie: str = "", user_agent: str = DEFAULT_UA, debug: bool = False):
        self.site = site.rstrip("/")
        self.user_agent = user_agent or DEFAULT_UA
        self.debug = debug
        self.cookies: Dict[str, str] = {}
        self._conn: Optional[http.client.HTTPSConnection] = None
        self._conn_host = ""
        self._rebuild_opener()
        if cookie:
            self.set_cookie_header(cookie)

    def _rebuild_opener(self) -> None:
        self._drop_conn()
        self._ssl_ctx = ssl.create_default_context()

    def _drop_conn(self) -> None:
        conn = getattr(self, "_conn", None)
        self._conn = None
        self._conn_host = ""
        if conn is not None:
            try:
                conn.close()
            except Exception:
                pass

    def _connection(self, parsed, timeout: float) -> http.client.HTTPSConnection:
        host = parsed.hostname or "qoj.ac"
        port = parsed.port or 443
        key = f"{host}:{port}"
        if self._conn is not None and self._conn_host == key:
            self._conn.timeout = timeout
            if getattr(self._conn, "sock", None) is not None:
                try:
                    self._conn.sock.settimeout(timeout)
                except Exception:
                    pass
            return self._conn
        self._drop_conn()
        conn = http.client.HTTPSConnection(host, port, timeout=timeout, context=self._ssl_ctx)
        self._conn = conn
        self._conn_host = key
        return conn

    def set_cookie_header(self, header: str) -> None:
        header = parse_cookie_input(header)
        self.cookies.update(cookie_names(header))

    def cookie_header(self) -> str:
        return "; ".join(f"{k}={v}" for k, v in self.cookies.items() if k)

    def _absorb_set_cookie(self, headers) -> None:
        raw_list = headers.get_all("Set-Cookie") if hasattr(headers, "get_all") else []
        if not raw_list:
            single = headers.get("Set-Cookie")
            raw_list = [single] if single else []
        for item in raw_list:
            jar = SimpleCookie()
            try:
                jar.load(item)
            except Exception:
                continue
            for name, morsel in jar.items():
                if morsel.value:
                    self.cookies[name] = morsel.value

    @staticmethod
    def _read_body(fp, limit: int = 8 * 1024 * 1024, deadline: Optional[float] = None) -> bytes:
        chunks: List[bytes] = []
        n = 0
        while n < limit:
            if deadline is not None and time.time() > deadline:
                raise TimeoutError("read deadline")
            piece = fp.read(min(65536, limit - n))
            if not piece:
                break
            chunks.append(piece)
            n += len(piece)
        return b"".join(chunks)

    def _http_once(
        self,
        url: str,
        data: Optional[bytes],
        extra_headers: Optional[dict],
        method: str,
        sock_timeout: float,
        read_timeout: float,
    ) -> Tuple[int, str, bytes, str]:
        parsed = urlparse(url)
        path = parsed.path or "/"
        if parsed.query:
            path += "?" + parsed.query
        hdrs = {
            "Host": parsed.netloc,
            "User-Agent": self.user_agent,
            "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
            "Accept-Language": "en-US,en;q=0.9",
            "Accept-Encoding": "gzip",
            "Connection": "keep-alive",
        }
        cookie = self.cookie_header()
        if cookie:
            hdrs["Cookie"] = cookie
        if extra_headers:
            hdrs.update(extra_headers)
            if cookie and "Cookie" not in extra_headers:
                hdrs["Cookie"] = cookie
        last_err: Optional[BaseException] = None
        for reconnect in range(2):
            conn = self._connection(parsed, sock_timeout)
            try:
                conn.request(method, path, body=data, headers=hdrs)
                resp = conn.getresponse()
                status = resp.status
                loc = resp.getheader("Location") or ""
                ctype = resp.getheader("Content-Type") or ""
                cenc = (resp.getheader("Content-Encoding") or "").lower()
                self._absorb_set_cookie(resp.headers)
                raw = self._read_body(resp, deadline=time.time() + read_timeout)
                if cenc == "gzip" and raw:
                    try:
                        raw = gzip.decompress(raw)
                    except Exception:
                        pass
                charset = "utf-8"
                m = re.search(r"charset=([^\s;]+)", ctype, re.I)
                if m:
                    charset = m.group(1).strip().strip('"')
                return status, loc, raw, charset
            except (BrokenPipeError, ConnectionResetError, RemoteDisconnected) as exc:
                last_err = exc
                self._drop_conn()
                if reconnect == 0:
                    continue
                raise
            except (ssl.SSLError, TimeoutError, socket.timeout, OSError):
                self._drop_conn()
                raise
        raise last_err or OSError("connection failed")

    def _request(
        self,
        url: str,
        data: Optional[bytes] = None,
        headers: Optional[dict] = None,
        method: Optional[str] = None,
        timeout: int = 25,
        retries: int = 1,
        fatal: bool = True,
    ) -> Tuple[int, str, str]:
        if not url.startswith("http"):
            url = urljoin(self.site + "/", url.lstrip("/"))
        attempts = max(1, retries + 1)
        last_err: Optional[BaseException] = None
        is_post = data is not None
        method = (method or ("POST" if is_post else "GET")).upper()
        sock_timeout = 20 if is_post else 15
        current = url
        send_data = data
        send_method = method
        send_post = is_post
        for attempt in range(attempts):
            if self.debug:
                print(f"DEBUG {send_method} {current} (try {attempt + 1}/{attempts})", file=sys.stderr)
            read_timeout = 8 if send_post else max(10, timeout)
            redirects = 0
            try:
                while True:
                    status, loc, raw, encoding = self._http_once(
                        current, send_data, headers, send_method, sock_timeout, read_timeout
                    )
                    if loc:
                        loc = urljoin(current, loc)
                    if status in (301, 302, 303, 307, 308) and loc:
                        if send_post:
                            try:
                                text = raw.decode(encoding, errors="replace")
                            except LookupError:
                                text = raw.decode("utf-8", errors="replace")
                            return status, loc, text
                        if redirects >= 5:
                            break
                        current = loc
                        send_method = "GET"
                        send_data = None
                        send_post = False
                        redirects += 1
                        continue
                    break
                try:
                    text = raw.decode(encoding, errors="replace")
                except LookupError:
                    text = raw.decode("utf-8", errors="replace")
                if _is_cloudflare_block(text):
                    die(
                        "被 Cloudflare 拦截。请重新执行 ./submit login"
                        "（必须用弹出的 Firefox 过验证，不要用自动化窗口）"
                    )
                return status, current, text
            except (ssl.SSLError, TimeoutError, IncompleteRead, socket.timeout, URLError, OSError) as exc:
                last_err = exc
                kind = _network_error_kind(exc)
                handshake_ok = kind == "handshake"
                can_retry = attempt + 1 < attempts and (
                    handshake_ok or (not send_post and kind in ("handshake", "timeout"))
                )
                if can_retry:
                    if handshake_ok:
                        info(f"TLS 握手超时，正在重试 ({attempt + 2}/{attempts})...")
                    self._rebuild_opener()
                    time.sleep(0.4 * (attempt + 1))
                    current = url
                    send_data = data
                    send_method = method
                    send_post = is_post
                    continue
                if not fatal:
                    raise TimeoutError(str(getattr(exc, "reason", exc))) from exc
                if is_post and not handshake_ok:
                    die(
                        "提交请求超时。代码可能已经交上去了，请先查，不要连点:\n"
                        "  ./submit status"
                    )
                if is_post:
                    die(
                        "提交时 TLS 握手一直超时。代码多半没交上去，请再试一次；\n"
                        "不确定的话先: ./submit status"
                    )
                die(f"网络错误: {getattr(exc, 'reason', exc)}")
        if not fatal:
            raise TimeoutError(str(last_err))
        die(f"请求失败: {url} ({last_err})")
        raise AssertionError

    def get(self, url: str, timeout: int = 15, retries: int = 0, fatal: bool = True) -> Tuple[int, str, str]:
        return self._request(url, timeout=timeout, retries=retries, fatal=fatal)

    def post_form(self, url: str, fields: dict, timeout: int = 25, referer: Optional[str] = None) -> Tuple[int, str, str]:
        data = urlencode(fields).encode("utf-8")
        headers = {
            "Content-Type": "application/x-www-form-urlencoded",
            "Origin": self.site,
        }
        if referer:
            headers["Referer"] = referer
        return self._request(url, data=data, headers=headers, timeout=timeout, retries=2)

    def post_multipart(
        self,
        url: str,
        fields: Dict[str, str],
        files: Optional[Dict[str, Tuple[str, bytes, str]]] = None,
        timeout: int = 20,
        referer: Optional[str] = None,
        fatal: bool = True,
    ) -> Tuple[int, str, str]:
        boundary = "----XcpcQoj" + uuid.uuid4().hex
        chunks: List[bytes] = []

        def add_field(name: str, value: str) -> None:
            chunks.append(f"--{boundary}\r\n".encode("utf-8"))
            chunks.append(
                f'Content-Disposition: form-data; name="{name}"\r\n\r\n'.encode("utf-8")
            )
            chunks.append(value.encode("utf-8"))
            chunks.append(b"\r\n")

        def add_file(name: str, filename: str, content: bytes, ctype: str) -> None:
            chunks.append(f"--{boundary}\r\n".encode("utf-8"))
            chunks.append(
                (
                    f'Content-Disposition: form-data; name="{name}"; '
                    f'filename="{filename}"\r\n'
                    f"Content-Type: {ctype}\r\n\r\n"
                ).encode("utf-8")
            )
            chunks.append(content)
            chunks.append(b"\r\n")

        for key, value in fields.items():
            add_field(key, value)
        for key, (filename, content, ctype) in (files or {}).items():
            add_file(key, filename, content, ctype)
        chunks.append(f"--{boundary}--\r\n".encode("utf-8"))
        body = b"".join(chunks)
        headers = {
            "Content-Type": f"multipart/form-data; boundary={boundary}",
            "Origin": self.site,
        }
        if referer:
            headers["Referer"] = referer
        return self._request(url, data=body, headers=headers, timeout=timeout, retries=1, fatal=fatal)


def extract_token(page: str) -> str:
    patterns = [
        r'name=["\']_token["\'][^>]*value=["\']([^"\']+)["\']',
        r'value=["\']([^"\']+)["\'][^>]*name=["\']_token["\']',
        r'_token\s*:\s*["\']([^"\']+)["\']',
        r'name="_token"\s+value="([^"]+)"',
    ]
    for pat in patterns:
        m = re.search(pat, page, re.I)
        if m and m.group(1).strip():
            return htmlmod.unescape(m.group(1).strip())
    return ""


def extract_alerts(page: str) -> str:
    parts: List[str] = []
    for pat in (
        r'class=["\'][^"\']*alert-danger[^"\']*["\'][^>]*>(.*?)</div>',
        r'class=["\'][^"\']*alert-warning[^"\']*["\'][^>]*>(.*?)</div>',
        r'class=["\'][^"\']*alert[^"\']*["\'][^>]*>(.*?)</div>',
    ):
        for m in re.finditer(pat, page or "", re.I | re.S):
            text = strip_html(m.group(1)).strip()
            if text and text not in parts and len(text) < 300:
                parts.append(text)
    return " / ".join(parts[:3])


def extract_submit_button(page: str) -> Tuple[str, str]:
    m = re.search(
        r"<(?:button|input)\b([^>]*name=[\"']submit-answer[\"'][^>]*)>",
        page or "",
        re.I,
    )
    if m:
        return "submit-answer", _html_attr(m.group(1), "value") or "answer"
    return "submit-answer", "answer"


def extract_username(page: str) -> str:
    """Read the logged-in handle from the navbar, not footer/announcement links.

    QOJ pages always contain /user/profile/Qingyu (site owner). The real account
    sits next to Logout / 登出 in the navigation bar.
    """
    logout_at = [m.start() for m in re.finditer(r'href=["\'][^"\']*/logout["\']', page, re.I)]
    if not logout_at:
        logout_at = [m.start() for m in re.finditer(r">\s*(Logout|登出)\s*<", page, re.I)]
    best = ""
    best_dist = 10**9
    for pm in re.finditer(r"/user/profile/([^\"'/?#<\s]+)", page):
        for pos in logout_at:
            dist = abs(pm.start() - pos)
            if dist < best_dist:
                best_dist = dist
                best = pm.group(1)
    if best and best_dist < 2500:
        return htmlmod.unescape(best)

    nav = re.search(r"<nav\b[^>]*>(.*?)</nav>", page, re.I | re.S)
    if nav:
        names = re.findall(r"/user/profile/([^\"'/?#<\s]+)", nav.group(1))
        if names:
            return htmlmod.unescape(names[0])

    m = re.search(r'data-username=["\']([^"\']+)["\']', page, re.I)
    if m:
        return htmlmod.unescape(m.group(1))
    return ""


def looks_logged_in(page: str, url: str = "", expect: str = "") -> bool:
    if re.search(r'id=["\']form-login["\']', page, re.I) or re.search(
        r'id=["\']input-username["\']', page, re.I
    ):
        return False
    if "/login" in (url or "") and re.search(r"<title>[^<]*(Login|登录)", page, re.I):
        return False
    if re.search(r'href=["\'][^"\']*/logout["\']', page, re.I):
        return True
    if re.search(r">\s*(Logout|登出)\s*<", page, re.I):
        return True
    if expect and re.search(
        rf"/user/profile/{re.escape(expect)}(?:['\"/?#<\s]|$)", page
    ):
        return True
    return False


def _html_attr(attrs: str, name: str) -> str:
    m = re.search(
        rf'''(?:^|\s){re.escape(name)}\s*=\s*(?:["']([^"']*)["']|([^\s>]+))''',
        attrs or "",
        re.I,
    )
    if not m:
        return ""
    return htmlmod.unescape((m.group(1) or m.group(2) or "").strip())


def _parse_option_tags(inner: str) -> List[Tuple[str, str]]:
    options: List[Tuple[str, str]] = []
    for om in re.finditer(r"<option\b([^>]*)>(.*?)</option>", inner or "", re.I | re.S):
        attrs, label = om.group(1), strip_html(om.group(2))
        value = _html_attr(attrs, "value")
        if not value:
            value = label
        if "disabled" in attrs.lower() and not value:
            continue
        if value or label:
            options.append((value, label or value))
    return options


def _is_prog_lang_options(options: List[Tuple[str, str]]) -> bool:
    blob = " ".join(f"{v} {l}" for v, l in options).lower()
    return any(
        k in blob
        for k in ("c++", "python", "pypy", "java", "rust", "kotlin", "pascal", "haskell")
    )


def parse_select_options(page: str, name: str) -> List[Tuple[str, str]]:
    want = (name or "").lower()
    want_id = f"input-{want}"
    for sm in re.finditer(r"<select\b([^>]*)>(.*?)</select>", page, re.I | re.S):
        attrs, inner = sm.group(1), sm.group(2)
        nm = _html_attr(attrs, "name").lower()
        sid = _html_attr(attrs, "id").lower()
        if nm == want or sid in (want, want_id):
            return _parse_option_tags(inner)
    return []


def collect_language_options(page: str) -> Tuple[str, List[Tuple[str, str]]]:
    """Find the programming-language <select>, not the statement Languages dropdown."""
    preferred: List[Tuple[str, List[Tuple[str, str]]]] = []
    others: List[Tuple[str, List[Tuple[str, str]]]] = []
    for sm in re.finditer(r"<select\b([^>]*)>(.*?)</select>", page, re.I | re.S):
        attrs, inner = sm.group(1), sm.group(2)
        name = _html_attr(attrs, "name") or "answer_answer_language"
        opts = _parse_option_tags(inner)
        if not opts or not _is_prog_lang_options(opts):
            continue
        if "answer" in name.lower() or "language" in name.lower():
            preferred.append((name, opts))
        else:
            others.append((name, opts))
    if preferred:
        preferred.sort(key=lambda x: (0 if "answer" in x[0].lower() else 1, x[0]))
        return preferred[0]
    if others:
        return others[0]
    radios: List[Tuple[str, str]] = []
    radio_name = "answer_answer_language"
    for im in re.finditer(r"<input\b([^>]*)>", page, re.I):
        attrs = im.group(1)
        if _html_attr(attrs, "type").lower() != "radio":
            continue
        name = _html_attr(attrs, "name")
        value = _html_attr(attrs, "value")
        if "language" in name.lower() and value:
            radio_name = name
            radios.append((value, value))
    if radios and _is_prog_lang_options(radios):
        return radio_name, radios
    return "answer_answer_language", []


def pick_language(options: List[Tuple[str, str]], suffix: str, explicit: Optional[str] = None) -> str:
    if not options:
        die("题目页没有语言选项，可能未登录或没有提交表单")
    if explicit:
        want = norm_lang(explicit)
        for value, label in options:
            if want in (norm_lang(value), norm_lang(label)) or want == norm_lang(value):
                return value
            if want in norm_lang(label) or want in norm_lang(value):
                return value
        names = ", ".join(f"{v} ({l})" if l != v else v for v, l in options)
        die(f"找不到语言 {explicit!r}。可选: {names}")
    prefer = EXT_LANG_PREFER.get(suffix.lower(), [])
    ranked: List[Tuple[int, str]] = []
    for value, label in options:
        token = norm_lang(value) or norm_lang(label)
        score = 10_000
        for i, pref in enumerate(prefer):
            if pref == token or token.startswith(pref) or pref in token:
                score = i
                break
        ranked.append((score, value))
    ranked.sort(key=lambda x: x[0])
    return ranked[0][1]


def canonical_problem_url(url: str) -> str:
    parsed = urlparse(url)
    path = re.sub(r"/statement/[^/]+/?$", "", parsed.path or "")
    path = re.sub(r"/(?:statistics|hack)/?$", "", path)
    path = path.rstrip("/") or "/"
    return urlunparse((parsed.scheme, parsed.netloc, path, "", "", ""))


def problem_page_candidates(url: str, site: str, contest_id: str, problem_id: str) -> List[str]:
    base = canonical_problem_url(url)
    if not re.search(r"/problem/\d+$", base):
        if contest_id:
            base = f"{site.rstrip('/')}/contest/{contest_id}/problem/{problem_id}"
        else:
            base = f"{site.rstrip('/')}/problem/{problem_id}"
    out: List[str] = []
    for item in (
        f"{base}/statement/zh_cn",
        f"{base}/statement/default",
        f"{base}/statement/en",
        base + "?tab=submit-answer",
        f"{base}/submit",
        base + "?tab=submit",
        base,
        base + "?locale=en",
        f"{site.rstrip('/')}/problem/{problem_id}?tab=submit-answer",
        f"{site.rstrip('/')}/problem/{problem_id}/submit",
        f"{site.rstrip('/')}/problem/{problem_id}",
    ):
        if item not in out:
            out.append(item)
    return out


def iter_submit_hrefs(page: str, current_url: str) -> List[str]:
    found: List[str] = []

    def add(href: str) -> None:
        href = htmlmod.unescape(href or "").strip()
        if not href or href.startswith("javascript:"):
            return
        if href.startswith("#"):
            href = current_url.split("#")[0]
        else:
            href = urljoin(current_url, href).split("#")[0]
        if href not in found:
            found.append(href)

    for href in re.findall(r'href=["\']([^"\']*tab-submit-answer[^"\']*)["\']', page or "", re.I):
        add(href)
    for href in re.findall(r'href=["\']([^"\']+/submit(?:\?[^"\']*)?)["\']', page or "", re.I):
        add(href)
    for href, inner in re.findall(
        r'<a\b[^>]*href=["\']([^"\']+)["\'][^>]*>(.*?)</a>',
        page or "",
        re.I | re.S,
    ):
        text = strip_html(inner).strip().lower()
        if text in ("submit", "提交", "submit!"):
            add(href)
    return found


def extract_form_action(page: str, current_url: str) -> str:
    for m in re.finditer(r"<form\b([^>]*)>(.*?)</form>", page or "", re.I | re.S):
        attrs, body = m.group(1), m.group(2)
        if "submit-answer" not in body and "answer_answer" not in body:
            continue
        action = _html_attr(attrs, "action")
        if not action:
            return current_url.split("#")[0]
        return urljoin(current_url, action).split("#")[0]
    return ""


def parse_contest_problems(page: str, site: str, contest_id: str) -> Dict[str, dict]:
    problems: Dict[str, dict] = {}
    row_re = re.compile(
        r"<tr\b[^>]*>\s*"
        r"<td\b[^>]*>\s*([A-Za-z]{1,2})\s*</td>\s*"
        r"<td\b[^>]*>\s*<a\b[^>]*href=[\"']([^\"']+)[\"'][^>]*>(.*?)</a>",
        re.I | re.S,
    )
    for letter, href, title_html in row_re.findall(page):
        href = htmlmod.unescape(href)
        m = re.search(rf"/contest/{contest_id}/problem/(\d+)", href)
        if not m:
            continue
        pid = m.group(1)
        url = canonical_problem_url(urljoin(site + "/", href))
        problems[letter.upper()] = {
            "id": pid,
            "title": strip_html(title_html) or pid,
            "url": url,
        }

    if problems:
        return problems

    link_re = re.compile(
        rf'href=["\']([^"\']*/contest/{contest_id}/problem/(\d+)[^"\']*)["\'][^>]*>(.*?)</a>',
        re.I | re.S,
    )
    seen = set()
    letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    idx = 0
    for href, pid, title_html in link_re.findall(page):
        if pid in seen:
            continue
        seen.add(pid)
        if idx >= len(letters):
            letter = f"P{idx + 1}"
        else:
            letter = letters[idx]
        idx += 1
        problems[letter] = {
            "id": pid,
            "title": strip_html(title_html) or pid,
            "url": canonical_problem_url(urljoin(site + "/", htmlmod.unescape(href))),
        }
    return problems


def parse_contest_name(page: str) -> str:
    m = re.search(r"<title>(.*?)</title>", page, re.I | re.S)
    if m:
        title = strip_html(m.group(1))
        title = re.sub(r"\s*[-|].*$", "", title).strip()
        if title:
            return title
    m = re.search(r"<h1\b[^>]*>(.*?)</h1>", page, re.I | re.S)
    if m:
        return strip_html(m.group(1))
    return ""


def _uoj_status_text(html: str) -> str:
    m = re.search(
        r'class=["\'][^"\']*uoj-status[^"\']*["\'][^>]*>(.*?)</(?:a|span|div|td|b)',
        html or "",
        re.I | re.S,
    )
    if m:
        return strip_html(m.group(1))
    return ""


def parse_submission_rows(page: str) -> List[dict]:
    rows = []
    seen = set()
    for tr in re.findall(r"<tr\b[^>]*>(.*?)</tr>", page, re.I | re.S):
        sid_m = re.search(r"/submission/(\d+)", tr)
        if not sid_m:
            continue
        sid = sid_m.group(1)
        if sid in seen:
            continue
        seen.add(sid)
        links = [(htmlmod.unescape(h), strip_html(t)) for h, t in re.findall(
            r'<a\b[^>]*href=["\']([^"\']+)["\'][^>]*>(.*?)</a>', tr, re.I | re.S
        )]
        problem = ""
        problem_id = ""
        contest_id = ""
        submitter = ""
        for href, text in links:
            if not contest_id:
                cm = re.search(r"/contest/(\d+)", href)
                if cm:
                    contest_id = cm.group(1)
            if not problem_id:
                pm = re.search(r"/problem/(\d+)", href)
                if pm:
                    problem_id = pm.group(1)
                    problem = text
            if not submitter:
                um = re.search(r"/user/profile/([^/?#'\"]+)", href)
                if um:
                    submitter = htmlmod.unescape(um.group(1))
        cells = [strip_html(td) for td in re.findall(r"<td\b[^>]*>(.*?)</td>", tr, re.I | re.S)]
        status = _uoj_status_text(tr)
        if not status:
            for cell in cells:
                low = cell.lower()
                if any(k in low for k in (
                    "accept", "wrong", "error", "limit", "judg", "wait", "compil",
                    "runtime", "point", "score", "正确", "错误", "超限", "评测", "等待",
                )):
                    status = cell
                    break
        if not status and len(cells) >= 5:
            status = cells[4] if len(cells) > 4 else cells[-1]
        rows.append({
            "id": sid,
            "problem": problem,
            "problem_id": problem_id,
            "contest_id": contest_id,
            "submitter": submitter,
            "status": status or "?",
            "cells": cells,
            "submit_ts": _parse_submit_clock(cells),
            "url_path": f"/submission/{sid}",
        })
    return rows


def _contest_problem_ids(contest: dict) -> set:
    ids = set()
    for item in (contest.get("problems") or {}).values():
        pid = str((item or {}).get("id") or "")
        if pid:
            ids.add(pid)
    return ids


def _contest_problem_label(contest: dict, row: dict) -> str:
    pid = str(row.get("problem_id") or "")
    for letter, item in (contest.get("problems") or {}).items():
        if str((item or {}).get("id") or "") == pid:
            title = str((item or {}).get("title") or "").strip()
            return f"{letter}. {title}" if title else str(letter)
    return str(row.get("problem") or pid or "")


def _submission_row_matches(
    row: dict,
    contest: dict,
    problem_id: Optional[str] = None,
) -> bool:
    username = str(contest.get("username") or "")
    submitter = str(row.get("submitter") or "")
    if username and submitter and submitter != username:
        return False
    cid = str(contest.get("contest_id") or "")
    row_cid = str(row.get("contest_id") or "")
    if cid and row_cid and row_cid != cid:
        return False
    want = str(problem_id or "")
    row_pid = str(row.get("problem_id") or "")
    if want:
        return (not row_pid) or row_pid == want
    known = _contest_problem_ids(contest)
    if known and row_pid:
        return row_pid in known
    return True


def _parse_submit_clock(cells: List[str]) -> Optional[float]:
    for cell in cells or []:
        m = re.search(r"(20\d{2}-\d{2}-\d{2}\s+\d{2}:\d{2}(?::\d{2})?)", cell)
        if not m:
            continue
        text = m.group(1)
        for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M"):
            try:
                return time.mktime(time.strptime(text, fmt))
            except ValueError:
                continue
    return None


def parse_submission_status(page: str) -> dict:
    text = strip_html(page)
    status = _uoj_status_text(page)
    scoped = re.search(
        r'class=["\'][^"\']*(?:uoj-status|submission-status|verdict)[^"\']*["\'][^>]*>(.*?)</',
        page,
        re.I | re.S,
    )
    blob = strip_html(scoped.group(1)) if scoped else (status or page)
    fail_re = (
        r"(Wrong Answer|Time Limit Exceeded|Memory Limit Exceeded|Runtime Error|"
        r"Compile Error|Compilation Error|Output Limit Exceeded|"
        r"Dangerous Syscall|System Error|Partially Correct|"
        r"答案错误|时间超限|内存超限|运行错误|编译错误|输出超限)"
    )
    fail = re.search(fail_re, blob, re.I)
    if not fail:
        for sm in re.finditer(
            r'class=["\'][^"\']*uoj-status[^"\']*["\'][^>]*>(.*?)</',
            page or "",
            re.I | re.S,
        ):
            fail = re.search(fail_re, strip_html(sm.group(1)), re.I)
            if fail:
                break
    if fail:
        status = strip_html(fail.group(1))
    elif not status or _test_pending(status):
        ac = None
        for sm in re.finditer(
            r'class=["\'][^"\']*uoj-status[^"\']*["\'][^>]*>(.*?)</',
            page or "",
            re.I | re.S,
        ):
            piece = strip_html(sm.group(1))
            if re.search(r"(Accepted|正确)", piece, re.I) and not _test_pending(piece):
                ac = piece
                break
        if ac:
            status = ac
        elif not status:
            pend = re.search(
                r"(Judging|Waiting|Compiling|Pending|评测中|等待评测|编译中)",
                blob,
                re.I,
            )
            if pend:
                status = strip_html(pend.group(1))
    score_m = re.search(r"\b(\d{1,3})\s*(?:/|&nbsp;/&nbsp;|/)\s*100\b", text)
    if not score_m:
        score_m = re.search(r"(?:score|分数|得分)\s*[:：]?\s*(\d{1,3})\b", text, re.I)
    time_m = re.search(r"(\d+(?:\.\d+)?)\s*ms", text, re.I)
    mem_m = re.search(r"(\d+(?:\.\d+)?)\s*(?:KB|KiB|MB|MiB)", text, re.I)
    score = score_m.group(1) if score_m else ""
    low = (status or "").lower()
    failed = bool(fail)
    pending = (not status) or any(h in low for h in PENDING_HINTS)
    if failed or any(
        v in low for v in ("accepted", "正确", "wrong", "error", "exceeded", "编译错误", "答案")
    ):
        pending = False
    if "compile error" in low or "compilation error" in low:
        pending = False
    if (
        not failed
        and pending
        and score == "100"
        and re.search(r"\b100\s*/\s*100\b", text)
    ):
        pending = False
        status = "Accepted"
    return {
        "status": status or "Judging",
        "score": score,
        "time": time_m.group(0) if time_m else "",
        "memory": mem_m.group(0) if mem_m else "",
        "pending": pending,
    }


TEST_VERDICT_RE = (
    r"(Compile Error|Compilation Error|Accepted|Wrong Answer|"
    r"Time Limit Exceeded|Memory Limit Exceeded|Runtime Error|"
    r"Output Limit Exceeded|Dangerous Syscall|System Error|"
    r"Partially Correct|Skipped|Judging|Waiting|Compiling|Pending|"
    r"编译错误|答案错误|时间超限|内存超限|运行错误|输出超限|正确|评测中|等待评测|编译中)"
)


def _cell_time(text: str) -> str:
    m = re.search(r"(\d+(?:\.\d+)?)\s*ms", text or "", re.I)
    return m.group(0) if m else ""


def _cell_memory(text: str) -> str:
    m = re.search(r"(\d+(?:\.\d+)?)\s*(?:KB|KiB|MB|MiB)", text or "", re.I)
    return m.group(0) if m else ""


def _test_pending(status: str) -> bool:
    low = (status or "").lower()
    if not status:
        return True
    return any(
        h in low
        for h in ("waiting", "judging", "pending", "compiling", "评测中", "等待评测", "编译中")
    )


def _split_submission_html(page: str) -> Tuple[str, str]:
    m = re.search(
        r'(id=["\'](?:details|status-details|testdata)["\']|>\s*Testdata\s*<|测试点详情)',
        page or "",
        re.I,
    )
    if m:
        return page[: m.start()], page[m.start() :]
    m = re.search(r"<tr\b[^>]*>[\s\S]{0,80}#\s*1\b", page or "", re.I)
    if m:
        return page[: m.start()], page[m.start() :]
    return page or "", page or ""


def parse_submission_tests(page: str, sid: str = "") -> List[dict]:
    tests: List[dict] = []
    seen = set()
    sid = str(sid or "").lstrip("#")

    def valid_idx(idx: str) -> bool:
        if not str(idx).isdigit():
            return False
        n = int(idx)
        if n < 1 or n > 999:
            return False
        if sid and str(n) == sid:
            return False
        return True

    def add(idx: str, status: str, time_s: str, mem_s: str) -> None:
        if not valid_idx(idx):
            return
        idx = str(int(idx))
        status = (status or "").strip()
        item = {
            "id": idx,
            "status": status or "Judging",
            "time": time_s or "",
            "memory": mem_s or "",
            "pending": _test_pending(status),
        }
        if idx in seen:
            for old in tests:
                if old["id"] == idx:
                    if status and not _test_pending(status):
                        old.update(item)
                    elif not old.get("time") and time_s:
                        old.update(item)
                    break
            return
        seen.add(idx)
        tests.append(item)

    for tr in re.findall(r"<tr\b[^>]*>(.*?)</tr>", page or "", re.I | re.S):
        if re.search(r"/submission/\d+", tr):
            continue
        raw_cells = re.findall(r"<t[dh]\b[^>]*>(.*?)</t[dh]>", tr, re.I | re.S)
        cells = [strip_html(td) for td in raw_cells]
        joined = " ".join(cells)
        if re.search(r"subtask", joined, re.I) and not re.search(r"#\s*\d{1,3}\b", joined):
            continue
        idx = ""
        for cell in cells[:3]:
            if re.search(r"subtask", cell, re.I):
                continue
            m = re.search(
                r"^(?:#|test(?:\s*case)?|测试点?)?\s*(\d{1,3})$",
                cell,
                re.I,
            )
            if m and valid_idx(m.group(1)):
                idx = m.group(1)
                break
        if not idx:
            continue
        status = _uoj_status_text(tr)
        if not status:
            m = re.search(TEST_VERDICT_RE, joined, re.I)
            if m:
                status = m.group(1)
        if not status and not _cell_time(joined):
            continue
        add(idx, status, _cell_time(joined), _cell_memory(joined))

    if not tests:
        text = strip_html(page or "")
        for m in re.finditer(
            rf"(?:#|测试点)\s*(\d{{1,3}})\b\s*[:.\s]+{TEST_VERDICT_RE}"
            r"(?:\s+(\d+(?:\.\d+)?\s*ms))?"
            r"(?:\s+(\d+(?:\.\d+)?\s*(?:KB|KiB|MB|MiB)))?",
            text,
            re.I,
        ):
            add(m.group(1), m.group(2), m.group(3) or "", m.group(4) or "")
        prog = re.search(
            r"(?:Judging(?:\s+on)?\s+test|评测(?:中)?(?:到)?(?:第)?(?:测试点)?)\s*#?\s*(\d{1,3})\b",
            text,
            re.I,
        )
        if prog and valid_idx(prog.group(1)) and prog.group(1) not in seen:
            add(prog.group(1), "Judging", "", "")
    tests.sort(key=lambda t: int(t["id"]) if str(t["id"]).isdigit() else 10**9)
    return tests


def _is_ac_status(status: str) -> bool:
    low = (status or "").lower()
    return ("accepted" in low or "正确" in low) and "wrong" not in low


def parse_submission_detail(page: str, sid: str = "") -> dict:
    head, details = _split_submission_html(page)
    overall = parse_submission_status(head)
    tests = parse_submission_tests(details, sid=sid)
    if not tests:
        tests = parse_submission_tests(page, sid=sid)
    current = tests[-1] if tests else None
    tests_pending = bool(tests) and any(t.get("pending") for t in tests)
    tests_done = bool(tests) and not tests_pending
    pending = bool(overall.get("pending"))
    if tests_pending:
        pending = True
    if tests_done:
        pending = False
        if overall.get("pending") or _test_pending(overall.get("status") or ""):
            fails = [t for t in tests if not _is_ac_status(t.get("status") or "")]
            if fails:
                overall = dict(overall)
                overall["status"] = fails[0]["status"]
                overall["pending"] = False
                if fails[0].get("time"):
                    overall["time"] = fails[0]["time"]
                if fails[0].get("memory"):
                    overall["memory"] = fails[0]["memory"]
            else:
                overall = dict(overall)
                overall["status"] = "Accepted"
                overall["pending"] = False
    return {
        "overall": overall,
        "tests": tests,
        "current": current,
        "pending": pending,
        "judged": len([t for t in tests if not t.get("pending")]),
    }


def md5_hex(s: str) -> str:
    return hashlib.md5(s.encode("utf-8")).hexdigest()


def hmac_md5_hex(key: str, data: str) -> str:
    return hmac.new(key.encode("utf-8"), data.encode("utf-8"), hashlib.md5).hexdigest()


def make_client(cfg: dict, contest: Optional[dict] = None, debug: bool = False) -> Client:
    site = (contest or {}).get("site") or cfg.get("site") or DEFAULT_SITE
    cookie = cfg.get("cookie") or ""
    ua = cfg.get("user_agent") or DEFAULT_UA
    if not cookie:
        die(
            f"尚未登录。先运行: {Path(sys.argv[0]).name} login\n"
            f"配置文件: {global_config_path()}"
        )
    return Client(site, cookie=cookie, user_agent=ua, debug=debug)


def require_contest() -> Tuple[Path, dict]:
    path = find_contest_file()
    if path:
        return path, load_json(path)
    cfg = load_global()
    cached = cfg.get("contest")
    if isinstance(cached, dict) and cached.get("problems"):
        return global_config_path(), cached
    try:
        uid = input("比赛 UID: ").strip()
    except EOFError:
        uid = ""
    if not uid:
        die("需要比赛 UID。先执行: python3 submit 1234")
    data = bind_contest(uid)
    return Path.cwd() / CONTEST_FILE, data


def copy_self_to(dest_dir: Path) -> Optional[Path]:
    src = Path(__file__).resolve()
    dest = dest_dir / "submit"
    if dest.resolve() == src:
        return dest
    data = src.read_bytes()
    dest.write_bytes(data)
    try:
        dest.chmod(dest.stat().st_mode | 0o111)
    except OSError:
        pass
    return dest


def _cookies_to_header(cookies) -> str:
    pairs = []
    for item in cookies or []:
        name = value = None
        if isinstance(item, dict):
            name, value = item.get("name"), item.get("value")
        else:
            name = getattr(item, "name", None)
            value = getattr(item, "value", None)
        if name and value is not None:
            pairs.append(f"{name}={value}")
    return "; ".join(pairs)


def _wait_html_logged_in(get_html_url, timeout: int = 900) -> Tuple[str, str]:
    deadline = time.time() + timeout
    last_html, last_url = "", ""
    while time.time() < deadline:
        try:
            last_html, last_url = get_html_url()
        except Exception as exc:
            die(f"登录窗口已关闭或浏览器退出 ({exc})")
        if looks_logged_in(last_html, last_url):
            return last_html, last_url
        time.sleep(0.7)
    die("等待登录超时（15 分钟）。请重新执行 ./submit login")
    raise AssertionError


def _which(cmd: str) -> Optional[str]:
    from shutil import which
    return which(cmd)


def _linux_display_ok() -> bool:
    if os.name == "nt":
        return True
    return bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))


def _chrome_like_options(binary: Optional[str] = None, profile: Optional[Path] = None):
    from selenium.webdriver.chrome.options import Options
    opts = Options()
    for arg in (
        "--no-sandbox",
        "--disable-dev-shm-usage",
        "--disable-gpu",
        "--disable-software-rasterizer",
        "--disable-extensions",
        "--window-size=1100,820",
        "--disable-blink-features=AutomationControlled",
        "--remote-allow-origins=*",
    ):
        opts.add_argument(arg)
    if profile:
        opts.add_argument(f"--user-data-dir={str(profile)}")
    if binary:
        opts.binary_location = binary
    try:
        opts.add_experimental_option("excludeSwitches", ["enable-automation"])
    except Exception:
        pass
    return opts


def _selenium_try_chrome(binary: Optional[str] = None) -> object:
    from selenium import webdriver
    profile = xdg_config_dir() / "browser-profile-chrome"
    profile.mkdir(parents=True, exist_ok=True)
    opts = _chrome_like_options(binary=binary, profile=profile)
    return webdriver.Chrome(options=opts)


def _selenium_try_firefox(binary: Optional[str] = None) -> object:
    from selenium import webdriver
    from selenium.webdriver.firefox.options import Options as FirefoxOptions
    opts = FirefoxOptions()
    if binary:
        opts.binary_location = binary
    return webdriver.Firefox(options=opts)


def _login_selenium(site: str) -> Optional[Tuple[str, str, str]]:
    try:
        from selenium import webdriver
    except ImportError:
        return None

    if not _linux_display_ok():
        warn("当前没有图形界面（DISPLAY 为空）。请在虚拟机桌面终端运行，不要用纯 SSH。")
        return None

    attempts = []
    chrome_bin = (
        _which("google-chrome-stable")
        or _which("google-chrome")
        or _which("chromium")
        or _which("chromium-browser")
    )
    firefox_bin = _which("firefox") or _which("firefox-esr")
    if chrome_bin:
        attempts.append(("Chrome/Chromium", lambda b=chrome_bin: _selenium_try_chrome(b)))
    attempts.append(("Chrome for Testing", lambda: _selenium_try_chrome(None)))
    if firefox_bin:
        attempts.append(("Firefox", lambda b=firefox_bin: _selenium_try_firefox(b)))
    else:
        attempts.append(("Firefox", lambda: _selenium_try_firefox(None)))

    last_err = None
    driver = None
    used = ""
    for name, factory in attempts:
        try:
            info(f"正在启动 {name} ...")
            driver = factory()
            used = name
            break
        except Exception as exc:
            last_err = exc
            warn(f"{name} 启动失败: {exc}")
            driver = None

    if driver is None:
        warn(f"未能启动浏览器: {last_err}")
        warn("Linux 虚拟机请安装 Firefox 后再试:")
        warn("  sudo apt install firefox")
        return None

    info(f"已弹出 {used} 窗口，请在窗口里登录 QOJ（Cloudflare 也在窗口里完成）")
    info("登录成功后窗口会自动关闭")
    try:
        try:
            driver.set_window_size(1100, 820)
        except Exception:
            pass
        driver.get(site.rstrip("/") + "/login")
        html, url = _wait_html_logged_in(
            lambda: (driver.page_source, driver.current_url)
        )
        ua = driver.execute_script("return navigator.userAgent") or DEFAULT_UA
        cookie = _cookies_to_header(driver.get_cookies())
        return cookie, ua, html
    finally:
        try:
            driver.quit()
        except Exception:
            pass


def _login_playwright(site: str) -> Optional[Tuple[str, str, str]]:
    try:
        from playwright.sync_api import sync_playwright
    except ImportError:
        return None

    profile = str(xdg_config_dir() / "playwright-profile")
    Path(profile).mkdir(parents=True, exist_ok=True)
    info("已弹出浏览器窗口，请在窗口里登录 QOJ（Cloudflare 验证也在窗口里完成）")
    info("登录成功后窗口会自动关闭")
    try:
        with sync_playwright() as p:
            context = p.chromium.launch_persistent_context(
                profile,
                headless=False,
                viewport={"width": 1100, "height": 800},
            )
            page = context.pages[0] if context.pages else context.new_page()
            page.goto(site.rstrip("/") + "/login", wait_until="domcontentloaded")
            html, url = _wait_html_logged_in(
                lambda: (page.content(), page.url)
            )
            ua = page.evaluate("navigator.userAgent") or DEFAULT_UA
            cookie = _cookies_to_header(context.cookies())
            context.close()
            return cookie, ua, html
    except Exception as exc:
        warn(f"Playwright 登录失败: {exc}")
        return None


def _login_webview(site: str) -> Optional[Tuple[str, str, str]]:
    try:
        import webview
    except ImportError:
        return None

    result: dict = {}
    storage = xdg_config_dir() / "webview"
    storage.mkdir(parents=True, exist_ok=True)

    def on_ready():
        window = webview.windows[0]

        def watcher():
            try:
                html, url = _wait_html_logged_in(
                    lambda: (
                        window.evaluate_js(
                            "document.documentElement ? document.documentElement.outerHTML : ''"
                        )
                        or "",
                        window.get_current_url() or "",
                    )
                )
                ua = window.evaluate_js("navigator.userAgent") or DEFAULT_UA
                cookies = []
                try:
                    cookies = window.get_cookies() or []
                except Exception:
                    pass
                result["html"] = html
                result["url"] = url
                result["ua"] = ua
                result["cookie"] = _cookies_to_header(cookies)
            except SystemExit as exc:
                result["error"] = str(exc)
            except Exception as exc:
                result["error"] = str(exc)
            try:
                window.destroy()
            except Exception:
                pass

        threading.Thread(target=watcher, daemon=True).start()

    info("已弹出登录窗口，请在窗口里登录 QOJ")
    info("登录成功后窗口会自动关闭")
    webview.create_window(
        "QOJ 登录",
        site.rstrip("/") + "/login",
        width=1100,
        height=820,
    )
    try:
        webview.start(
            on_ready,
            private_mode=False,
            storage_path=str(storage),
        )
    except TypeError:
        webview.start(on_ready)
    if result.get("error") and not result.get("cookie"):
        warn(result["error"])
        return None
    if not result.get("cookie"):
        return None
    return result["cookie"], result.get("ua") or DEFAULT_UA, result.get("html") or ""


def _free_port() -> int:
    sock = socket.socket()
    sock.bind(("127.0.0.1", 0))
    port = sock.getsockname()[1]
    sock.close()
    return port


def _recvn(sock: socket.socket, n: int) -> bytes:
    buf = b""
    while len(buf) < n:
        chunk = sock.recv(n - len(buf))
        if not chunk:
            raise ConnectionError("CDP 连接已断开")
        buf += chunk
    return buf


def _ws_connect(ws_url: str, timeout: int = 8) -> socket.socket:
    parsed = urlparse(ws_url)
    host = parsed.hostname or "127.0.0.1"
    port = parsed.port or (443 if parsed.scheme == "wss" else 80)
    path = parsed.path or "/"
    if parsed.query:
        path += "?" + parsed.query
    sock = socket.create_connection((host, port), timeout=timeout)
    key = base64.b64encode(os.urandom(16)).decode("ascii")
    req = (
        f"GET {path} HTTP/1.1\r\n"
        f"Host: {host}:{port}\r\n"
        "Upgrade: websocket\r\n"
        "Connection: Upgrade\r\n"
        f"Sec-WebSocket-Key: {key}\r\n"
        "Sec-WebSocket-Version: 13\r\n"
        "\r\n"
    )
    sock.sendall(req.encode("ascii"))
    data = b""
    while b"\r\n\r\n" not in data:
        chunk = sock.recv(4096)
        if not chunk:
            break
        data += chunk
    if b"101" not in data.split(b"\r\n", 1)[0]:
        sock.close()
        raise ConnectionError("WebSocket 握手失败")
    return sock


def _ws_send(sock: socket.socket, text: str) -> None:
    payload = text.encode("utf-8")
    header = bytearray([0x81])
    n = len(payload)
    mask_bit = 0x80
    if n < 126:
        header.append(mask_bit | n)
    elif n < 65536:
        header.append(mask_bit | 126)
        header += struct.pack("!H", n)
    else:
        header.append(mask_bit | 127)
        header += struct.pack("!Q", n)
    mask = os.urandom(4)
    header += mask
    masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
    sock.sendall(header + masked)


def _ws_recv(sock: socket.socket) -> str:
    hdr = _recvn(sock, 2)
    opcode = hdr[0] & 0x0F
    n = hdr[1] & 0x7F
    masked = bool(hdr[1] & 0x80)
    if n == 126:
        n = struct.unpack("!H", _recvn(sock, 2))[0]
    elif n == 127:
        n = struct.unpack("!Q", _recvn(sock, 8))[0]
    mask = _recvn(sock, 4) if masked else b""
    payload = _recvn(sock, n)
    if masked:
        payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
    if opcode == 0x8:
        raise ConnectionError("CDP WebSocket 已关闭")
    if opcode == 0x9:
        return _ws_recv(sock)
    return payload.decode("utf-8", errors="replace")


def _cdp_rpc(sock: socket.socket, msg_id: int, method: str, params: Optional[dict] = None) -> dict:
    body: dict = {"id": msg_id, "method": method}
    if params:
        body["params"] = params
    _ws_send(sock, json.dumps(body))
    while True:
        raw = _ws_recv(sock)
        try:
            data = json.loads(raw)
        except json.JSONDecodeError:
            continue
        if data.get("id") == msg_id:
            return data


def _cdp_http_json(port: int, path: str):
    with urlopen(f"http://127.0.0.1:{port}{path}", timeout=3) as resp:
        return json.loads(resp.read().decode("utf-8"))


def _cdp_harvest(port: int) -> Tuple[str, str, str]:
    targets = _cdp_http_json(port, "/json/list")
    page = None
    for item in targets:
        if item.get("type") == "page" and "qoj" in (item.get("url") or "").lower():
            page = item
            break
    if page is None:
        for item in targets:
            if item.get("type") == "page" and item.get("webSocketDebuggerUrl"):
                page = item
                break
    if not page or not page.get("webSocketDebuggerUrl"):
        raise RuntimeError("没有可用的页面调试端口")
    sock = _ws_connect(page["webSocketDebuggerUrl"])
    try:
        cookies = []
        for method, params in (
            ("Network.getAllCookies", None),
            ("Storage.getCookies", None),
        ):
            ret = _cdp_rpc(sock, 1, method, params)
            result = ret.get("result") or {}
            cookies = result.get("cookies") or []
            if cookies:
                break
        ua_ret = _cdp_rpc(
            sock,
            2,
            "Runtime.evaluate",
            {"expression": "navigator.userAgent", "returnByValue": True},
        )
        ua = (
            ((ua_ret.get("result") or {}).get("result") or {}).get("value")
            or DEFAULT_UA
        )
        html_ret = _cdp_rpc(
            sock,
            3,
            "Runtime.evaluate",
            {
                "expression": "document.documentElement ? document.documentElement.outerHTML : ''",
                "returnByValue": True,
            },
        )
        html = (
            ((html_ret.get("result") or {}).get("result") or {}).get("value") or ""
        )
        return _cookies_to_header(cookies), str(ua), str(html)
    finally:
        try:
            sock.close()
        except Exception:
            pass


def _firefox_sqlite_cookies(profile: Path) -> Dict[str, str]:
    src = profile / "cookies.sqlite"
    if not src.is_file():
        return {}
    fd, tmp = tempfile.mkstemp(suffix=".sqlite")
    os.close(fd)
    tmp_path = Path(tmp)
    extras = []
    try:
        shutil.copy2(src, tmp_path)
        for suffix in ("-wal", "-shm"):
            side = Path(str(src) + suffix)
            if side.is_file():
                dest = Path(str(tmp_path) + suffix)
                shutil.copy2(side, dest)
                extras.append(dest)
        con = sqlite3.connect(str(tmp_path))
        try:
            rows = con.execute("SELECT host, name, value FROM moz_cookies").fetchall()
        finally:
            con.close()
        out: Dict[str, str] = {}
        preferred: Dict[str, str] = {}
        for host, name, value in rows:
            if not name or value is None:
                continue
            host_s = str(host or "")
            if "qoj.ac" not in host_s:
                continue
            host_key = host_s.lstrip(".")
            if host_key == "qoj.ac":
                preferred[str(name)] = str(value)
            elif str(name) not in preferred:
                out[str(name)] = str(value)
        out.update(preferred)
        return out
    except Exception:
        return {}
    finally:
        for path in [tmp_path, *extras]:
            try:
                path.unlink()
            except OSError:
                pass


def _firefox_user_agent(binary: str, profile: Path) -> str:
    for name in ("user.js", "prefs.js"):
        path = profile / name
        if not path.is_file():
            continue
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        m = re.search(r'user_pref\("general\.useragent\.override",\s*"([^"]+)"\)', text)
        if m:
            return m.group(1)
    try:
        out = subprocess.check_output(
            [binary, "--version"],
            timeout=5,
            text=True,
            stderr=subprocess.DEVNULL,
        )
        m = re.search(r"Firefox\s+(\d+)", out, re.I)
        if m:
            ver = m.group(1)
            return (
                f"Mozilla/5.0 (X11; Linux x86_64; rv:{ver}.0) "
                f"Gecko/20100101 Firefox/{ver}.0"
            )
    except Exception:
        pass
    return "Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0"


