def short_verdict(value: str) -> str:
    text = strip_html(value).strip()
    low = re.sub(r"[_\s]+", " ", text.lower())
    aliases = {
        "accepted": "AC", "accept": "AC", "ok": "AC", "正确": "AC", "答案正确": "AC",
        "wrong answer": "WA", "答案错误": "WA",
        "time limit exceeded": "TLE", "时间超限": "TLE",
        "memory limit exceeded": "MLE", "内存超限": "MLE",
        "runtime error": "RE", "运行错误": "RE",
        "compilation error": "CE", "compile error": "CE", "编译错误": "CE",
        "output limit exceeded": "OLE", "输出超限": "OLE",
        "judgment failed": "JE", "system error": "JE",
        "dangerous syscall": "DGS", "restricted function": "RF",
        "partially correct": "PC", "partial": "PC", "rejected": "REJECT",
        "reject": "REJECT", "skipped": "SKIPPED", "challenged": "HACKED",
        "compiling": "COMPILING", "running": "JUDGING", "judging": "JUDGING",
        "testing": "JUDGING", "pending": "PENDING", "waiting": "PENDING",
        "in queue": "PENDING", "queued": "PENDING", "waiting for judge": "PENDING",
        "等待评测": "PENDING", "等待": "PENDING", "评测中": "JUDGING", "评测": "JUDGING",
        "编译中": "COMPILING", "judgement failed": "JE", "judgement error": "JE",
        "presentation error": "PE", "no output": "NO_OUTPUT", "cancelled": "CANCELLED",
    }
    for key, result in aliases.items():
        if re.match(re.escape(key) + r"(?:$|[\s(:：.\[!])", low):
            return result
    m = re.match(r"^(AC|WA|TLE|MLE|RE|CE|OLE|JE|PC|RF|DGS|PE)\b", text, re.I)
    return m.group(1).upper() if m else "UNKNOWN"


def validate_submission_page(status: int, url: str, page: str) -> None:
    if re.search(r"/(?:login|enter)(?:[/?#]|$)", url):
        raise OSError("登录已失效，请运行 ./submit login")
    if _is_cloudflare_block(page):
        raise OSError("提交列表被 Cloudflare 拦截，请重新登录")
    if status != 200:
        raise OSError(f"提交列表 HTTP {status}")
    if not re.search(r"<table\b", page, re.I):
        raise OSError("未找到提交列表，无法确认是否存在提交记录")


def fetch_all_contest_submissions(client: Client, contest: dict, limit: int = 0) -> List[dict]:
    cf = is_codeforces(contest.get("site") or "")
    base = str(contest["contest_url"]).rstrip("/") + ("/my" if cf else "/submissions")
    username = str(contest.get("username") or "")
    if not cf and not username:
        raise OSError("无法确定当前账号，请运行 ./submit login")
    first = base if cf else base + "?" + urlencode({"submitter": username})
    queue, visited, seen, rows = [first], set(), set(), []
    parser = parse_cf_submission_rows if cf else parse_submission_rows
    while queue:
        url = queue.pop(0)
        if url in visited:
            continue
        visited.add(url)
        status, final, page = client.get(url, retries=1, fatal=False)
        validate_submission_page(status, final, page)
        for row in parser(page):
            if not _submission_row_matches(row, contest):
                continue
            if row["id"] not in seen:
                seen.add(row["id"])
                rows.append(row)
        if limit and len(rows) >= limit:
            break
        # Follow only pagination links for this contest's submissions endpoint.
        for href in re.findall(r'href=["\']([^"\']+)["\']', page, re.I):
            target = urljoin(final, htmlmod.unescape(href)).split("#")[0]
            parsed, root = urlparse(target), urlparse(base)
            if parsed.netloc != root.netloc or parsed.scheme != root.scheme:
                continue
            query = dict(parse_qsl(parsed.query))
            path_ok = parsed.path == root.path or bool(re.fullmatch(re.escape(root.path) + r"/page/\d+", parsed.path))
            page_link = "page" in query or bool(re.search(r"/page/\d+$", parsed.path))
            if path_ok and page_link and set(query) <= {"page", "locale", "submitter"}:
                if not cf:
                    query["submitter"] = username
                    target = urlunparse(parsed._replace(query=urlencode(query)))
                if target not in visited and target not in queue:
                    queue.append(target)
    rows.sort(key=lambda row: int(row["id"]), reverse=True)
    return rows[:limit] if limit else rows


