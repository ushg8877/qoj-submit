def color_enabled() -> bool:
    if os.environ.get("NO_COLOR"):
        return False
    if os.environ.get("FORCE_COLOR"):
        return True
    return sys.stdout.isatty()


def paint(text: str, code: str) -> str:
    if not color_enabled():
        return text
    return f"\033[{code}m{text}\033[0m"


def info(msg: str) -> None:
    print(paint("[i] ", "36") + msg, flush=True)


def ok(msg: str) -> None:
    print(paint("[ok] ", "32") + msg, flush=True)


def warn(msg: str) -> None:
    print(paint("[!] ", "33") + msg, flush=True)


def die(msg: str, code: int = 1) -> None:
    print(paint("[x] ", "31") + msg, file=sys.stderr, flush=True)
    raise SystemExit(code)


def verdict_color(text: str) -> str:
    low = text.lower()
    if any(x in low for x in ("accepted", "正确", "ac")) and "not" not in low:
        return paint(text, "32;1")
    if any(x in low for x in ("waiting", "judging", "pending", "等待", "评测", "排队")):
        return paint(text, "33")
    return paint(text, "31")


def xdg_config_dir() -> Path:
    if os.name == "nt":
        base = os.environ.get("APPDATA") or str(Path.home() / "AppData" / "Roaming")
        return Path(base) / APP_NAME
    xdg = os.environ.get("XDG_CONFIG_HOME")
    if xdg:
        return Path(xdg) / APP_NAME
    return Path.home() / ".config" / APP_NAME


def global_config_path() -> Path:
    return xdg_config_dir() / "config.json"


def find_contest_file(start: Optional[Path] = None) -> Optional[Path]:
    cur = (start or Path.cwd()).resolve()
    for path in [cur, *cur.parents]:
        candidate = path / CONTEST_FILE
        if candidate.is_file():
            return candidate
        if path.parent == path:
            break
    return None


def load_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        die(f"找不到配置文件: {path}")
    except json.JSONDecodeError as exc:
        die(f"配置文件不是合法 JSON: {path} ({exc})")
    return {}


def save_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def load_global() -> dict:
    path = global_config_path()
    if not path.is_file():
        return {}
    return load_json(path)


def save_global(data: dict) -> None:
    save_json(global_config_path(), data)


def strip_html(text: str) -> str:
    text = re.sub(r"<[^>]+>", " ", text)
    text = htmlmod.unescape(text)
    return re.sub(r"\s+", " ", text).strip()


def norm_lang(text: str) -> str:
    text = htmlmod.unescape(text).lower()
    text = re.sub(r"\([^)]*\)", "", text)
    text = text.replace("g++", "c++")
    return re.sub(r"[^a-z0-9+]+", "", text)


