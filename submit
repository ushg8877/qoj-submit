def _login_webview(site: str) -> Optional[Tuple[str, str, str]]:
    try:
        import webview
    except ImportError:
        return None

    result: dict = {}
    storage = xdg_config_dir() / "webview"
    storage.mkdir(parents=True, exist_ok=True)

    def on_ready():
        window = webview.windows[0]

        def watcher():
            try:
                html, url = _wait_html_logged_in(
                    lambda: (
                        window.evaluate_js(
                            "document.documentElement ? document.documentElement.outerHTML : ''"
                        )
                        or "",
                        window.get_current_url() or "",
                    )
                )
                ua = window.evaluate_js("navigator.userAgent") or DEFAULT_UA
                cookies = []
                try:
                    cookies = window.get_cookies() or []
                except Exception:
                    pass
                result["html"] = html
                result["url"] = url
                result["ua"] = ua
                result["cookie"] = _cookies_to_header(cookies)
            except SystemExit as exc:
                result["error"] = str(exc)
            except Exception as exc:
                result["error"] = str(exc)
            try:
                window.destroy()
            except Exception:
                pass

        threading.Thread(target=watcher, daemon=True).start()

    info("已弹出登录窗口，请在窗口里登录 QOJ")
    info("登录成功后窗口会自动关闭")
    webview.create_window(
        "QOJ 登录",
        site.rstrip("/") + "/",
        width=1100,
        height=820,
    )
    try:
        webview.start(
            on_ready,
            private_mode=False,
            storage_path=str(storage),
        )
    except TypeError:
        webview.start(on_ready)
    if result.get("error") and not result.get("cookie"):
        warn(result["error"])
        return None
    if not result.get("cookie"):
        return None
    return result["cookie"], result.get("ua") or DEFAULT_UA, result.get("html") or ""


def _free_port() -> int:
    sock = socket.socket()
    sock.bind(("127.0.0.1", 0))
    port = sock.getsockname()[1]
    sock.close()
    return port


def _recvn(sock: socket.socket, n: int) -> bytes:
    buf = b""
    while len(buf) < n:
        chunk = sock.recv(n - len(buf))
        if not chunk:
            raise ConnectionError("CDP 连接已断开")
        buf += chunk
    return buf


def _ws_connect(ws_url: str, timeout: int = 8) -> socket.socket:
    parsed = urlparse(ws_url)
    host = parsed.hostname or "127.0.0.1"
    port = parsed.port or (443 if parsed.scheme == "wss" else 80)
    path = parsed.path or "/"
    if parsed.query:
        path += "?" + parsed.query
    sock = socket.create_connection((host, port), timeout=timeout)
    key = base64.b64encode(os.urandom(16)).decode("ascii")
    req = (
        f"GET {path} HTTP/1.1\r\n"
        f"Host: {host}:{port}\r\n"
        "Upgrade: websocket\r\n"
        "Connection: Upgrade\r\n"
        f"Sec-WebSocket-Key: {key}\r\n"
        "Sec-WebSocket-Version: 13\r\n"
        "\r\n"
    )
    sock.sendall(req.encode("ascii"))
    data = b""
    while b"\r\n\r\n" not in data:
        chunk = sock.recv(4096)
        if not chunk:
            break
        data += chunk
    if b"101" not in data.split(b"\r\n", 1)[0]:
        sock.close()
        raise ConnectionError("WebSocket 握手失败")
    return sock


def _ws_send(sock: socket.socket, text: str) -> None:
    payload = text.encode("utf-8")
    header = bytearray([0x81])
    n = len(payload)
    mask_bit = 0x80
    if n < 126:
        header.append(mask_bit | n)
    elif n < 65536:
        header.append(mask_bit | 126)
        header += struct.pack("!H", n)
    else:
        header.append(mask_bit | 127)
        header += struct.pack("!Q", n)
    mask = os.urandom(4)
    header += mask
    masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
    sock.sendall(header + masked)


def _ws_recv(sock: socket.socket) -> str:
    hdr = _recvn(sock, 2)
    opcode = hdr[0] & 0x0F
    n = hdr[1] & 0x7F
    masked = bool(hdr[1] & 0x80)
    if n == 126:
        n = struct.unpack("!H", _recvn(sock, 2))[0]
    elif n == 127:
        n = struct.unpack("!Q", _recvn(sock, 8))[0]
    mask = _recvn(sock, 4) if masked else b""
    payload = _recvn(sock, n)
    if masked:
        payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
    if opcode == 0x8:
        raise ConnectionError("CDP WebSocket 已关闭")
    if opcode == 0x9:
        return _ws_recv(sock)
    return payload.decode("utf-8", errors="replace")


def _cdp_rpc(sock: socket.socket, msg_id: int, method: str, params: Optional[dict] = None) -> dict:
    body: dict = {"id": msg_id, "method": method}
    if params:
        body["params"] = params
    _ws_send(sock, json.dumps(body))
    while True:
        raw = _ws_recv(sock)
        try:
            data = json.loads(raw)
        except json.JSONDecodeError:
            continue
        if data.get("id") == msg_id:
            return data


def _cdp_http_json(port: int, path: str):
    with urlopen(f"http://127.0.0.1:{port}{path}", timeout=3) as resp:
        return json.loads(resp.read().decode("utf-8"))


def _cdp_harvest(port: int) -> Tuple[str, str, str]:
    targets = _cdp_http_json(port, "/json/list")
    page = None
    for item in targets:
        if item.get("type") == "page" and "qoj" in (item.get("url") or "").lower():
            page = item
            break
    if page is None:
        for item in targets:
            if item.get("type") == "page" and item.get("webSocketDebuggerUrl"):
                page = item
                break
    if not page or not page.get("webSocketDebuggerUrl"):
        raise RuntimeError("没有可用的页面调试端口")
    sock = _ws_connect(page["webSocketDebuggerUrl"])
    try:
        cookies = []
        for method, params in (
            ("Network.getAllCookies", None),
            ("Storage.getCookies", None),
        ):
            ret = _cdp_rpc(sock, 1, method, params)
            result = ret.get("result") or {}
            cookies = result.get("cookies") or []
            if cookies:
                break
        ua_ret = _cdp_rpc(
            sock,
            2,
            "Runtime.evaluate",
            {"expression": "navigator.userAgent", "returnByValue": True},
        )
        ua = (
            ((ua_ret.get("result") or {}).get("result") or {}).get("value")
            or DEFAULT_UA
        )
        html_ret = _cdp_rpc(
            sock,
            3,
            "Runtime.evaluate",
            {
                "expression": "document.documentElement ? document.documentElement.outerHTML : ''",
                "returnByValue": True,
            },
        )
        html = (
            ((html_ret.get("result") or {}).get("result") or {}).get("value") or ""
        )
        return _cookies_to_header(cookies), str(ua), str(html)
    finally:
        try:
            sock.close()
        except Exception:
            pass


def _read_firefox_session(path: Path) -> dict:
    raw = path.read_bytes()
    if len(raw) > 64 * 1024 * 1024:
        raise ValueError("Firefox session file too large")
    if raw.startswith(b"mozLz40\0"):
        if len(raw) < 12:
            raise ValueError("Truncated Firefox session")
        size = struct.unpack("<I", raw[8:12])[0]
        if size > 64 * 1024 * 1024:
            raise ValueError("Firefox session too large")
        block, out, i = raw[12:], bytearray(), 0

        def length(initial: int) -> int:
            nonlocal i
            n = initial
            if n == 15:
                while True:
                    if i >= len(block):
                        raise ValueError("Truncated LZ4 length")
                    v = block[i]
                    i += 1
                    n += v
                    if v != 255:
                        break
            return n

        while i < len(block):
            token = block[i]
            i += 1
            n = length(token >> 4)
            if i + n > len(block) or len(out) + n > size:
                raise ValueError("Invalid LZ4 literals")
            out.extend(block[i:i+n])
            i += n
            if i == len(block):
                break
            if i + 2 > len(block):
                raise ValueError("Truncated LZ4 offset")
            offset = block[i] | (block[i+1] << 8)
            i += 2
            n = length(token & 15) + 4
            if not offset or offset > len(out) or len(out) + n > size:
                raise ValueError("Invalid LZ4 match")
            # Repeat the referenced bytes, including overlapping matches.
            pattern = bytes(out[-offset:])
            out.extend((pattern * ((n + offset - 1) // offset))[:n])
        if len(out) != size:
            raise ValueError("Invalid LZ4 output size")
        raw = bytes(out)
    result = json.loads(raw)
    if not isinstance(result, dict):
        raise ValueError("Invalid Firefox session object")
    return result


def _firefox_session_cookies(profile: Path, needles: List[str]) -> Dict[str, str]:
    paths = [profile / rel for rel in (
        "sessionstore-backups/recovery.jsonlz4", "sessionstore.jsonlz4",
        "sessionstore.js", "sessionstore-backups/recovery.baklz4",
        "sessionstore-backups/previous.jsonlz4",
    )]
    paths = sorted((p for p in paths if p.is_file()),
                   key=lambda p: p.stat().st_mtime, reverse=True)
    for path in paths:
        try:
            session = _read_firefox_session(path)
        except (OSError, ValueError, UnicodeError):
            continue
        out: Dict[str, str] = {}
        containers = [session] + list(session.get("windows") or [])
        for container in containers:
            if not isinstance(container, dict) or container.get("isPrivate"):
                continue
            for item in container.get("cookies") or []:
                if not isinstance(item, dict):
                    continue
                host = str(item.get("host") or "").lower().lstrip(".")
                if not any(host == n or host.endswith("." + n) for n in needles):
                    continue
                # Container/private cookies cannot be replayed as the default session.
                attributes = item.get("originAttributes") or {}
                if isinstance(attributes, dict):
                    if any(attributes.values()):
                        continue
                elif attributes:
                    continue
                expiry = item.get("expiry", 0)
                try:
                    if expiry and float(expiry) < time.time():
                        continue
                except (TypeError, ValueError):
                    continue
                if item.get("name") and item.get("value") is not None:
                    out[str(item["name"])] = str(item["value"])
        return out
    return {}


def _firefox_sqlite_cookies(profile: Path, host_needles: Optional[List[str]] = None) -> Dict[str, str]:
    src = profile / "cookies.sqlite"
    needles = [n.lower() for n in (host_needles or ["qoj.ac"]) if n]
    session_cookies = _firefox_session_cookies(profile, needles)
    if not src.is_file():
        return session_cookies
    rows: List[tuple] = []
    try:
        con = sqlite3.connect(f"file:{src}?mode=ro", uri=True, timeout=8)
        try:
            rows = con.execute("SELECT host, name, value FROM moz_cookies WHERE (expiry = 0 OR expiry > strftime('%s', 'now')) AND originAttributes = ''").fetchall()
        finally:
            con.close()
    except sqlite3.Error:
        rows = []
    if not rows:
        fd, tmp = tempfile.mkstemp(suffix=".sqlite")
        os.close(fd)
        tmp_path = Path(tmp)
        extras = []
        try:
            shutil.copy2(src, tmp_path)
            for suffix in ("-wal", "-shm"):
                side = Path(str(src) + suffix)
                if side.is_file():
                    dest = Path(str(tmp_path) + suffix)
                    shutil.copy2(side, dest)
                    extras.append(dest)
            con = sqlite3.connect(str(tmp_path), timeout=8)
            try:
                rows = con.execute("SELECT host, name, value FROM moz_cookies WHERE (expiry = 0 OR expiry > strftime('%s', 'now')) AND originAttributes = ''").fetchall()
            finally:
                con.close()
        except Exception:
            rows = []
        finally:
            for path in [tmp_path, *extras]:
                try:
                    path.unlink()
                except OSError:
                    pass
    out: Dict[str, str] = {}
    preferred: Dict[str, str] = {}

    def keep(dst: Dict[str, str], name: str, value: str) -> None:
        old = dst.get(name, "")
        if old and (not value or len(value) < len(old)):
            return
        dst[name] = value

    for host, name, value in rows:
        if not name or value is None:
            continue
        host_s = str(host or "").lower()
        if not any(host_s.lstrip(".") == n or host_s.lstrip(".").endswith("." + n) for n in needles):
            continue
        host_key = host_s.lstrip(".")
        prefer = any(host_key == n or host_key.endswith("." + n) for n in needles)
        if prefer:
            keep(preferred, str(name), str(value))
        elif str(name) not in preferred:
            keep(out, str(name), str(value))
    out.update(preferred)
    session_cookies.update(out)
    return session_cookies


def _firefox_user_agent(binary: str, profile: Path) -> str:
    for name in ("user.js", "prefs.js"):
        path = profile / name
        if not path.is_file():
            continue
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        m = re.search(r'user_pref\("general\.useragent\.override",\s*"([^"]+)"\)', text)
        if m:
            return m.group(1)
    try:
        out = subprocess.check_output(
            [binary, "--version"],
            timeout=5,
            text=True,
            stderr=subprocess.DEVNULL,
        )
        m = re.search(r"Firefox\s+(\d+)", out, re.I)
        if m:
            ver = m.group(1)
            os_token = "X11; Ubuntu; Linux x86_64" if Path("/etc/os-release").is_file() and "ubuntu" in Path("/etc/os-release").read_text(encoding="utf-8", errors="replace").lower() else "X11; Linux x86_64"
            return (
                f"Mozilla/5.0 ({os_token}; rv:{ver}.0) "
                f"Gecko/20100101 Firefox/{ver}.0"
            )
    except Exception:
        pass
    return "Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0"


def _session_ready(cookie_header: str, html: str = "", site: str = "") -> bool:
    if html and _is_cloudflare_block(html):
