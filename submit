def _login_webview(site: str) -> Optional[Tuple[str, str, str]]:
    try:
        import webview
    except ImportError:
        return None

    result: dict = {}
    storage = xdg_config_dir() / "webview"
    storage.mkdir(parents=True, exist_ok=True)

    def on_ready():
        window = webview.windows[0]

        def watcher():
            try:
                html, url = _wait_html_logged_in(
                    lambda: (
                        window.evaluate_js(
                            "document.documentElement ? document.documentElement.outerHTML : ''"
                        )
                        or "",
                        window.get_current_url() or "",
                    )
                )
                ua = window.evaluate_js("navigator.userAgent") or DEFAULT_UA
                cookies = []
                try:
                    cookies = window.get_cookies() or []
                except Exception:
                    pass
                result["html"] = html
                result["url"] = url
                result["ua"] = ua
                result["cookie"] = _cookies_to_header(cookies)
            except SystemExit as exc:
                result["error"] = str(exc)
            except Exception as exc:
                result["error"] = str(exc)
            try:
                window.destroy()
            except Exception:
                pass

        threading.Thread(target=watcher, daemon=True).start()

    info("已弹出登录窗口，请在窗口里登录 QOJ")
    info("登录成功后窗口会自动关闭")
    webview.create_window(
        "QOJ 登录",
        site.rstrip("/") + "/login",
        width=1100,
        height=820,
    )
    try:
        webview.start(
            on_ready,
            private_mode=False,
            storage_path=str(storage),
        )
    except TypeError:
        webview.start(on_ready)
    if result.get("error") and not result.get("cookie"):
        warn(result["error"])
        return None
    if not result.get("cookie"):
        return None
    return result["cookie"], result.get("ua") or DEFAULT_UA, result.get("html") or ""


def _free_port() -> int:
    sock = socket.socket()
    sock.bind(("127.0.0.1", 0))
    port = sock.getsockname()[1]
    sock.close()
    return port


def _recvn(sock: socket.socket, n: int) -> bytes:
    buf = b""
    while len(buf) < n:
        chunk = sock.recv(n - len(buf))
        if not chunk:
            raise ConnectionError("CDP 连接已断开")
        buf += chunk
    return buf


def _ws_connect(ws_url: str, timeout: int = 8) -> socket.socket:
    parsed = urlparse(ws_url)
    host = parsed.hostname or "127.0.0.1"
    port = parsed.port or (443 if parsed.scheme == "wss" else 80)
    path = parsed.path or "/"
    if parsed.query:
        path += "?" + parsed.query
    sock = socket.create_connection((host, port), timeout=timeout)
    key = base64.b64encode(os.urandom(16)).decode("ascii")
    req = (
        f"GET {path} HTTP/1.1\r\n"
        f"Host: {host}:{port}\r\n"
        "Upgrade: websocket\r\n"
        "Connection: Upgrade\r\n"
        f"Sec-WebSocket-Key: {key}\r\n"
        "Sec-WebSocket-Version: 13\r\n"
        "\r\n"
    )
    sock.sendall(req.encode("ascii"))
    data = b""
    while b"\r\n\r\n" not in data:
        chunk = sock.recv(4096)
        if not chunk:
            break
        data += chunk
    if b"101" not in data.split(b"\r\n", 1)[0]:
        sock.close()
        raise ConnectionError("WebSocket 握手失败")
    return sock


def _ws_send(sock: socket.socket, text: str) -> None:
    payload = text.encode("utf-8")
    header = bytearray([0x81])
    n = len(payload)
    mask_bit = 0x80
    if n < 126:
        header.append(mask_bit | n)
    elif n < 65536:
        header.append(mask_bit | 126)
        header += struct.pack("!H", n)
    else:
        header.append(mask_bit | 127)
        header += struct.pack("!Q", n)
    mask = os.urandom(4)
    header += mask
    masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
    sock.sendall(header + masked)


def _ws_recv(sock: socket.socket) -> str:
    hdr = _recvn(sock, 2)
    opcode = hdr[0] & 0x0F
    n = hdr[1] & 0x7F
    masked = bool(hdr[1] & 0x80)
    if n == 126:
        n = struct.unpack("!H", _recvn(sock, 2))[0]
    elif n == 127:
        n = struct.unpack("!Q", _recvn(sock, 8))[0]
    mask = _recvn(sock, 4) if masked else b""
    payload = _recvn(sock, n)
    if masked:
        payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
    if opcode == 0x8:
        raise ConnectionError("CDP WebSocket 已关闭")
    if opcode == 0x9:
        return _ws_recv(sock)
    return payload.decode("utf-8", errors="replace")


def _cdp_rpc(sock: socket.socket, msg_id: int, method: str, params: Optional[dict] = None) -> dict:
    body: dict = {"id": msg_id, "method": method}
    if params:
        body["params"] = params
    _ws_send(sock, json.dumps(body))
    while True:
        raw = _ws_recv(sock)
        try:
            data = json.loads(raw)
        except json.JSONDecodeError:
            continue
        if data.get("id") == msg_id:
            return data


def _cdp_http_json(port: int, path: str):
    with urlopen(f"http://127.0.0.1:{port}{path}", timeout=3) as resp:
        return json.loads(resp.read().decode("utf-8"))


def _cdp_harvest(port: int) -> Tuple[str, str, str]:
    targets = _cdp_http_json(port, "/json/list")
    page = None
    for item in targets:
        if item.get("type") == "page" and "qoj" in (item.get("url") or "").lower():
            page = item
            break
    if page is None:
        for item in targets:
            if item.get("type") == "page" and item.get("webSocketDebuggerUrl"):
                page = item
                break
    if not page or not page.get("webSocketDebuggerUrl"):
        raise RuntimeError("没有可用的页面调试端口")
    sock = _ws_connect(page["webSocketDebuggerUrl"])
    try:
        cookies = []
        for method, params in (
            ("Network.getAllCookies", None),
            ("Storage.getCookies", None),
        ):
            ret = _cdp_rpc(sock, 1, method, params)
            result = ret.get("result") or {}
            cookies = result.get("cookies") or []
            if cookies:
                break
        ua_ret = _cdp_rpc(
            sock,
            2,
            "Runtime.evaluate",
            {"expression": "navigator.userAgent", "returnByValue": True},
        )
        ua = (
            ((ua_ret.get("result") or {}).get("result") or {}).get("value")
            or DEFAULT_UA
        )
        html_ret = _cdp_rpc(
            sock,
            3,
            "Runtime.evaluate",
            {
                "expression": "document.documentElement ? document.documentElement.outerHTML : ''",
                "returnByValue": True,
            },
        )
        html = (
            ((html_ret.get("result") or {}).get("result") or {}).get("value") or ""
        )
        return _cookies_to_header(cookies), str(ua), str(html)
    finally:
        try:
            sock.close()
        except Exception:
            pass


def _firefox_sqlite_cookies(profile: Path, host_needles: Optional[List[str]] = None) -> Dict[str, str]:
    src = profile / "cookies.sqlite"
    if not src.is_file():
        return {}
    needles = [n.lower() for n in (host_needles or ["qoj.ac"]) if n]
    rows: List[tuple] = []
    try:
        con = sqlite3.connect(f"file:{src}?mode=ro", uri=True, timeout=8)
        try:
            rows = con.execute("SELECT host, name, value FROM moz_cookies").fetchall()
        finally:
            con.close()
    except sqlite3.Error:
        rows = []
    if not rows:
        fd, tmp = tempfile.mkstemp(suffix=".sqlite")
        os.close(fd)
        tmp_path = Path(tmp)
        extras = []
        try:
            shutil.copy2(src, tmp_path)
            for suffix in ("-wal", "-shm"):
                side = Path(str(src) + suffix)
                if side.is_file():
                    dest = Path(str(tmp_path) + suffix)
                    shutil.copy2(side, dest)
                    extras.append(dest)
            con = sqlite3.connect(str(tmp_path), timeout=8)
            try:
                rows = con.execute("SELECT host, name, value FROM moz_cookies").fetchall()
            finally:
                con.close()
        except Exception:
            rows = []
        finally:
            for path in [tmp_path, *extras]:
                try:
                    path.unlink()
                except OSError:
                    pass
    out: Dict[str, str] = {}
    preferred: Dict[str, str] = {}

    def keep(dst: Dict[str, str], name: str, value: str) -> None:
        old = dst.get(name, "")
        if old and (not value or len(value) < len(old)):
            return
        dst[name] = value

    for host, name, value in rows:
        if not name or value is None:
            continue
        host_s = str(host or "").lower()
        if not any(n in host_s for n in needles):
            continue
        host_key = host_s.lstrip(".")
        prefer = any(host_key == n or host_key.endswith("." + n) for n in needles)
        if prefer:
            keep(preferred, str(name), str(value))
        elif str(name) not in preferred:
            keep(out, str(name), str(value))
    out.update(preferred)
    return out


def _firefox_user_agent(binary: str, profile: Path) -> str:
    for name in ("user.js", "prefs.js"):
        path = profile / name
        if not path.is_file():
            continue
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        m = re.search(r'user_pref\("general\.useragent\.override",\s*"([^"]+)"\)', text)
        if m:
            return m.group(1)
    try:
        out = subprocess.check_output(
            [binary, "--version"],
            timeout=5,
            text=True,
            stderr=subprocess.DEVNULL,
        )
        m = re.search(r"Firefox\s+(\d+)", out, re.I)
        if m:
            ver = m.group(1)
            os_token = "X11; Ubuntu; Linux x86_64" if Path("/etc/os-release").is_file() and "ubuntu" in Path("/etc/os-release").read_text(encoding="utf-8", errors="replace").lower() else "X11; Linux x86_64"
            return (
                f"Mozilla/5.0 ({os_token}; rv:{ver}.0) "
                f"Gecko/20100101 Firefox/{ver}.0"
            )
    except Exception:
        pass
    return "Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0"


def _session_ready(cookie_header: str, html: str = "", site: str = "") -> bool:
    if html and _is_cloudflare_block(html):
        html = ""
    names = cookie_names(cookie_header)
    if is_codeforces(site):
        if html and looks_logged_in(html, url=site):
            return True
        return bool(_cf_cookie_logged_in(cookie_header))
    if names.get("UOJSESSID") and (
        names.get("uoj_username") or names.get("uoj_remember_token")
    ):
        return True
    return bool(names.get("UOJSESSID") and looks_logged_in(html))


QOJ_SESSION_COOKIE_NAMES = (
    "UOJSESSID",
    "uoj_username",
    "uoj_remember_token",
    "uoj_password",
)


def _clear_named_cookies_sqlite(db: Path, table: str, name_col: str, host_col: str) -> bool:
    if not db.is_file():
        return False
    try:
        con = sqlite3.connect(f"file:{db}?mode=rw", uri=True, timeout=5)
        try:
            placeholders = ",".join("?" * len(QOJ_SESSION_COOKIE_NAMES))
            con.execute(
                f"DELETE FROM {table} WHERE {name_col} IN ({placeholders})",
                QOJ_SESSION_COOKIE_NAMES,
            )
            con.execute(
                f"DELETE FROM {table} WHERE {host_col} LIKE ? AND {name_col} LIKE 'uoj%'",
                ("%qoj.ac%",),
            )
            con.execute(
                f"DELETE FROM {table} WHERE {host_col} LIKE ? AND {name_col} = 'UOJSESSID'",
                ("%qoj.ac%",),
            )
            con.commit()
            try:
                con.execute("PRAGMA wal_checkpoint(TRUNCATE)")
            except sqlite3.Error:
                pass
        finally:
            con.close()
        return True
    except sqlite3.Error:
        return False


def _clear_firefox_session_restore(profile: Path) -> None:
    if not profile.is_dir():
        return
    for name in (
        "sessionstore.jsonlz4",
        "sessionstore.js",
        "sessionCheckpoints.json",
        "recovery.jsonlz4",
        "recovery.baklz4",
    ):
        try:
            (profile / name).unlink(missing_ok=True)
        except OSError:
            pass
    bak = profile / "sessionstore-backups"
    if bak.is_dir():
        for p in bak.iterdir():
            try:
                if p.is_file():
                    p.unlink()
            except OSError:
                pass


def _clear_qoj_session_cookies(profile: Path) -> None:
    if not profile.is_dir():
        return
    _clear_named_cookies_sqlite(profile / "cookies.sqlite", "moz_cookies", "name", "host")
    _clear_firefox_session_restore(profile)
    for db in (
        profile / "Cookies",
        profile / "Default" / "Cookies",
        profile / "Default" / "Network" / "Cookies",
    ):
        _clear_named_cookies_sqlite(db, "cookies", "name", "host_key")


def _clear_host_session_cookies(profile: Path, host: str, keep: Tuple[str, ...] = ("cf_clearance",)) -> None:
    if not profile.is_dir() or not host:
        return
    like = f"%{host}%"
    keep_names = tuple(keep)
    targets = [
        (profile / "cookies.sqlite", "moz_cookies", "name", "host"),
        (profile / "Cookies", "cookies", "name", "host_key"),
        (profile / "Default" / "Cookies", "cookies", "name", "host_key"),
        (profile / "Default" / "Network" / "Cookies", "cookies", "name", "host_key"),
    ]
    for db, table, name_col, host_col in targets:
        if not db.is_file():
            continue
        try:
            con = sqlite3.connect(f"file:{db}?mode=rw", uri=True, timeout=5)
            try:
                if keep_names:
                    ph = ",".join("?" * len(keep_names))
                    con.execute(
                        f"DELETE FROM {table} WHERE {host_col} LIKE ? AND {name_col} NOT IN ({ph})",
                        (like, *keep_names),
                    )
                else:
                    con.execute(
                        f"DELETE FROM {table} WHERE {host_col} LIKE ?",
                        (like,),
                    )
                con.commit()
                try:
                    con.execute("PRAGMA wal_checkpoint(TRUNCATE)")
                except sqlite3.Error:
                    pass
            finally:
                con.close()
        except sqlite3.Error:
            continue


def _forget_saved_login(cfg: dict, site: Optional[str] = None) -> str:
    site = (site or cfg.get("site") or DEFAULT_SITE).rstrip("/")
    key = account_key(site)
    acc = get_account(cfg, site)
    old = str(acc.get("username") or cfg.get("username") or "")
    accounts = cfg.get("accounts")
    if isinstance(accounts, dict):
        accounts.pop(key, None)
        cfg["accounts"] = accounts
    if account_key(cfg.get("site") or "") == key or not is_codeforces(site):
        if not is_codeforces(site):
            cfg["cookie"] = ""
            cfg["username"] = ""
    save_global(cfg)
    _kill_stale_login_browsers()
    host = key or "qoj.ac"
    if is_codeforces(site):
        _clear_host_session_cookies(_firefox_profile_dir(), host)
        _clear_host_session_cookies(
            Path.home() / ".local" / "share" / "qoj-xcpc" / "chromium-profile", host
        )
    else:
        _clear_qoj_session_cookies(_firefox_profile_dir())
        _clear_qoj_session_cookies(Path.home() / ".local" / "share" / "qoj-xcpc" / "chromium-profile")
    return old


def _wait_debug_port(port: int, proc: subprocess.Popen, seconds: float = 20) -> bool:
    deadline = time.time() + seconds
    while time.time() < deadline:
        if proc.poll() is not None:
            return False
        try:
            _cdp_http_json(port, "/json/version")
            return True
        except Exception:
            time.sleep(0.25)
    return False


def _browser_binaries() -> List[Tuple[str, str]]:
    found: List[Tuple[str, str]] = []
    seen = set()
    firefox_paths = [
        "/usr/lib/firefox-esr/firefox",
        "/usr/lib/firefox/firefox",
        "/usr/bin/firefox-esr",
        "/usr/bin/firefox",
        _which("firefox-esr"),
        _which("firefox"),
    ]
    chrome_paths = [
        _which("chromium"),
        _which("chromium-browser"),
        _which("google-chrome-stable"),
        _which("google-chrome"),
        "/usr/bin/chromium",
        "/usr/bin/chromium-browser",
    ]
    ranked: List[Tuple[int, str, str]] = []
    for path in firefox_paths:
        if not path:
            continue
        p = str(Path(path))
        if not Path(p).exists() or p in seen:
            continue
        seen.add(p)
        snap = 1 if "snap" in str(Path(p).resolve()).lower() else 0
        ranked.append((snap, "firefox", p))
    ranked.sort()
    for _, kind, p in ranked:
        found.append((kind, p))
    for path in chrome_paths:
        if not path:
            continue
        p = str(Path(path))
        if Path(p).exists() and p not in seen:
            seen.add(p)
            found.append(("chromium", p))
    return found


def _firefox_profile_dir() -> Path:
    snap_common = Path.home() / "snap" / "firefox" / "common"
    if snap_common.is_dir():
        dest = snap_common / "qoj-submit-profile"
    else:
        dest = Path.home() / ".local" / "share" / "qoj-xcpc" / "firefox-profile"
    dest.mkdir(parents=True, exist_ok=True)
    return dest


def _firefox_profile_roots(binary: str = "") -> List[Path]:
    snap = Path.home() / "snap" / "firefox" / "common" / ".mozilla" / "firefox"
    native = Path.home() / ".mozilla" / "firefox"
    blob = (binary or "").lower()
    try:
        if binary:
            blob += " " + str(Path(binary).resolve()).lower()
    except OSError:
        pass
    if "snap" in blob or (snap / "profiles.ini").is_file():
        return [snap, native]
    return [native, snap]


def _parse_firefox_profiles_ini(root: Path) -> Optional[Path]:
    ini = root / "profiles.ini"
    if not ini.is_file():
        return None
    try:
        text = ini.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None
    sections: List[dict] = []
    cur: dict = {}
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("[") and line.endswith("]"):
            if cur:
                sections.append(cur)
            cur = {"_name": line[1:-1]}
            continue
        if "=" in line and cur:
            key, value = line.split("=", 1)
            cur[key.strip()] = value.strip()
    if cur:
        sections.append(cur)

    def resolve(path: str, relative: bool) -> Optional[Path]:
        dest = root / path if relative else Path(path)
        if dest.is_dir() and "qoj-submit-profile" not in str(dest):
            return dest
        return None

    for sec in sections:
        if sec.get("Default") == "1" and sec.get("Path"):
            found = resolve(sec["Path"], sec.get("IsRelative", "1") != "0")
            if found:
                return found
    for sec in sections:
        if str(sec.get("_name") or "").startswith("Install") and sec.get("Default"):
            found = resolve(sec["Default"], True)
            if found:
                return found
    for sec in sections:
        if sec.get("Path"):
            found = resolve(sec["Path"], sec.get("IsRelative", "1") != "0")
            if found:
                return found
    return None


def _iter_firefox_profiles(binary: str = "") -> List[Path]:
    seen = set()
    out: List[Path] = []
    for root in _firefox_profile_roots(binary):
        guessed = _parse_firefox_profiles_ini(root)
        if guessed and guessed not in seen:
            seen.add(guessed)
            out.append(guessed)
        if not root.is_dir():
            continue
        try:
            kids = list(root.iterdir())
        except OSError:
            continue
        for child in kids:
            if not child.is_dir() or "qoj-submit-profile" in child.name:
                continue
            if not (child / "cookies.sqlite").is_file():
                continue
            if child in seen:
                continue
            seen.add(child)
            out.append(child)
    return out


def _firefox_default_profile(binary: str = "", host: str = "") -> Optional[Path]:
    profiles = _iter_firefox_profiles(binary)
    if not profiles:
        return None
    needles = [host] if host else []
    if host and "codeforces" in host:
        needles = ["codeforces.com", "codeforces.org"]
    best = None
    best_score = -1
    for profile in profiles:
        names = _firefox_sqlite_cookies(profile, needles or None) if needles else {}
        score = 0
        if names.get("X-User") or names.get("X-User-Sha1"):
            score += 3
        if names.get("JSESSIONID"):
            score += 2
        if names.get("cf_clearance"):
            score += 1
        if score > best_score:
            best_score = score
            best = profile
    if best_score > 0:
        return best
    return profiles[0]


def _unlock_browser_profile(profile: Path) -> None:
    if not profile.is_dir():
        return
    for name in (
        "lock",
        "parent.lock",
        ".parentlock",
        "SingletonLock",
        "SingletonSocket",
        "SingletonCookie",
    ):
        path = profile / name
        try:
            if path.is_file() or path.is_symlink():
                path.unlink()
        except OSError:
            pass


def _proc_cmdline(pid: int) -> str:
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return ""
    return raw.replace(b"\0", b" ").decode("utf-8", "replace").strip()


def _proc_comm(pid: int) -> str:
    try:
        return Path(f"/proc/{pid}/comm").read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return ""


def _is_self_login_process(pid: int, me: int, my_exe: str) -> bool:
    if pid <= 1 or pid == me or pid == os.getppid():
        return True
    cmd = _proc_cmdline(pid)
    if not cmd:
        return False
    try:
        exe = os.readlink(f"/proc/{pid}/exe")
    except OSError:
        exe = ""
    blob = f"{exe} {cmd}".replace("\\", "/")
    if my_exe:
        try:
            if exe and Path(exe).resolve() == Path(my_exe).resolve() and "submit" in cmd:
                return True
        except OSError:
            pass
    if "qoj-xcpc/venv" in blob and "submit" in cmd:
        return True
    return False


def _is_stale_login_browser(pid: int) -> bool:
    comm = _proc_comm(pid)
    cmd = _proc_cmdline(pid)
    blob = f"{comm} {cmd}"
    if comm in ("geckodriver", "chromedriver") or "geckodriver" in cmd or "chromedriver" in cmd:
        return True
    if "qoj-submit-profile" in blob:
        return True
    if "qoj-xcpc/firefox-profile" in blob or "qoj-xcpc/chromium-profile" in blob:
        return True
    if "--marionette" in cmd:
        return True
    return False


def _kill_stale_login_browsers() -> None:
    if os.name == "nt" or not Path("/proc").is_dir():
        return
    warn("正在结束上次登录残留的 geckodriver / 独立配置 Firefox（不会关掉你日常用的 Firefox）")
    me = os.getpid()
    try:
        my_exe = os.readlink(f"/proc/{me}/exe")
    except OSError:
        my_exe = sys.executable
    targets: List[int] = []
    try:
        names = os.listdir("/proc")
    except OSError:
        return
    for name in names:
        if not name.isdigit():
            continue
        pid = int(name)
        if _is_self_login_process(pid, me, my_exe):
            continue
        if _is_stale_login_browser(pid):
            targets.append(pid)
    for pid in targets:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    if targets:
        time.sleep(0.8)
        for pid in targets:
            try:
                os.kill(pid, 0)
            except OSError:
                continue
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
        time.sleep(0.4)


def _start_ua_sniffer() -> Tuple[object, dict]:
    from http.server import BaseHTTPRequestHandler, HTTPServer

    captured = {"ua": ""}

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            captured["ua"] = self.headers.get("User-Agent") or captured["ua"]
            body = (
                "<html><body style='font-family:sans-serif;padding:2em'>"
                "<p>已记录浏览器 User-Agent。请回到登录标签页完成验证并登录。</p>"
                "</body></html>"
            ).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *_args):
            return

    httpd = HTTPServer(("127.0.0.1", 0), Handler)
    threading.Thread(target=httpd.serve_forever, daemon=True).start()
    return httpd, captured


def _start_real_browser(
    kind: str,
    binary: str,
    site: str,
    profile: Path,
    port: int,
    extra_url: str = "",
    isolated: bool = True,
) -> Tuple[subprocess.Popen, Path]:
    if isolated:
        profile.mkdir(parents=True, exist_ok=True)
        _unlock_browser_profile(profile)
    if is_codeforces(site):
        url = site.rstrip("/") + "/enter"
    else:
        url = site.rstrip("/") + "/logout"
    env = os.environ.copy()
    log_path = (profile / "launch.log") if isolated else Path(tempfile.gettempdir()) / "qoj-cf-firefox.log"
    if kind == "firefox" and not isolated:
        env.pop("MOZ_NO_REMOTE", None)
        cmd = [binary, "--new-window", url]
    elif kind == "firefox":
        env["MOZ_NO_REMOTE"] = "1"
        env["MOZ_DISABLE_AUTO_SAFE_MODE"] = "1"
        cmd = [binary, "-no-remote", "--profile", str(profile), url]
    else:
        cmd = [
            binary,
            f"--remote-debugging-port={port}",
            "--remote-debugging-address=127.0.0.1",
            f"--user-data-dir={profile}",
            "--no-first-run",
            "--no-default-browser-check",
            "--disable-dev-shm-usage",
            "--no-sandbox",
            "--new-window",
            url,
        ]
    if extra_url:
        cmd.append(extra_url)
    if is_codeforces(site):
        cmd.append(site.rstrip("/") + "/profile")
    logf = open(log_path, "wb")
    proc = subprocess.Popen(
        cmd,
        stdout=logf,
        stderr=subprocess.STDOUT,
        start_new_session=True,
        env=env,
    )
    return proc, log_path


def _login_real_browser(site: str) -> Optional[Tuple[str, str, str]]:
    if not _linux_display_ok():
        warn("当前没有图形界面。请在虚拟机桌面终端运行 python3 submit login")
        return None
    binaries = _browser_binaries()
    if not binaries:
        warn("没有找到 firefox / chromium / chrome，请先: sudo apt install firefox")
        return None

    info("正在关闭上次登录残留的 Firefox / geckodriver ...")
    _kill_stale_login_browsers()
    host = account_key(site) or "qoj.ac"
    needles = [host]
    if is_codeforces(site):
        needles = ["codeforces.com", "codeforces.org"]
    if not is_codeforces(site):
        _clear_qoj_session_cookies(_firefox_profile_dir())
        _clear_qoj_session_cookies(Path.home() / ".local" / "share" / "qoj-xcpc" / "chromium-profile")

    httpd, captured = _start_ua_sniffer()
    try:
        for kind, binary in binaries:
            port = _free_port()
            isolated = True
            if kind == "firefox" and is_codeforces(site):
                default_profile = _firefox_default_profile(binary, host)
                if default_profile:
                    profile = default_profile
                    isolated = False
                else:
                    profile = _firefox_profile_dir()
                    warn("没有找到日常 Firefox 配置，改用独立配置（可能被 Cloudflare 拦截）")
            elif kind == "firefox":
                profile = _firefox_profile_dir()
            else:
                profile = Path.home() / ".local" / "share" / "qoj-xcpc" / "chromium-profile"
            sniff_url = f"http://127.0.0.1:{httpd.server_address[1]}/"
            ff_ua = _firefox_user_agent(binary, profile) if kind == "firefox" else DEFAULT_UA
            info(f"正在打开普通 {kind}")
            info(f"  程序: {binary}")
            info(f"  配置: {profile}")
            if is_codeforces(site):
                info("会用你平时的 Firefox 打开 Codeforces。请在窗口里完成 Cloudflare，再点右上角 Enter 登录")
                info("不要关那个窗口，登录成功后脚本会自动继续（不会关掉你的 Firefox）")
                try:
                    import curl_cffi  # noqa: F401
                except ImportError:
                    warn(
                        "未安装 curl_cffi，命令行可能仍被 Cloudflare 拦截。请先:\n"
                        + _curl_cffi_install_hint()
                    )
            else:
                info("会先退出窗口里的旧账号。请在登录页登录要换的账号（含 Cloudflare）")
            try:
                proc, log_path = _start_real_browser(
                    kind, binary, site, profile, port, extra_url=sniff_url, isolated=isolated
                )
            except Exception as exc:
                warn(f"启动 {binary} 失败: {exc}")
                continue
            keep_browser = not isolated
            try:
                time.sleep(2.0)
                handed_off = keep_browser and proc.poll() is not None
                if proc.poll() is not None and not keep_browser:
                    tail = ""
                    try:
                        tail = log_path.read_text(encoding="utf-8", errors="replace")[-2000:]
                    except OSError:
                        pass
                    warn(f"{kind} 启动后立刻退出。日志:\n{tail or '(无)'}")
                    continue
                if handed_off:
                    info("已在现有 Firefox 中打开标签页")
                cdp_ok = False
                if kind != "firefox":
                    cdp_ok = _wait_debug_port(port, proc)
                deadline = time.time() + 900
                last_cookie, last_ua, last_html = "", captured.get("ua") or ff_ua, ""
                seen_logged_out = False
                names0 = _firefox_sqlite_cookies(profile, needles) if kind == "firefox" else {}
                if is_codeforces(site):
                    seen_logged_out = True
                elif not names0.get("UOJSESSID") and not names0.get("uoj_username"):
                    seen_logged_out = True
                last_hint = 0.0
                while time.time() < deadline:
                    if proc.poll() is not None and not keep_browser:
                        tail = ""
                        try:
                            tail = log_path.read_text(encoding="utf-8", errors="replace")[-1500:]
                        except OSError:
                            pass
                        warn(f"{kind} 窗口已关闭。{tail}")
                        break
                    cookie = ua = html = ""
                    if cdp_ok:
                        try:
                            cookie, ua, html = _cdp_harvest(port)
                        except Exception:
                            cdp_ok = _wait_debug_port(port, proc, seconds=1)
                    if not cookie and kind == "firefox":
                        names = _firefox_sqlite_cookies(profile, needles)
                        cookie = "; ".join(f"{k}={v}" for k, v in names.items())
                    ua = ua or captured.get("ua") or last_ua or ff_ua
                    if is_codeforces(site) and _cf_cookie_logged_in(cookie):
                        ok(f"已检测到登录 ({account_key(site) or site})")
                        return cookie, ua, html
                    if cookie and is_codeforces(site) and not html and kind == "firefox":
                        try:
                            probe = Client(site, cookie=cookie, user_agent=ua)
                            _, _, html = probe.get("/enter", timeout=8, retries=0, fatal=False)
                            if html and _is_cloudflare_block(html):
                                html = ""
                        except Exception:
                            html = ""
                    ready = bool(cookie) and _session_ready(cookie, html, site=site)
                    if ready and seen_logged_out:
                        last_cookie, last_ua, last_html = cookie, ua, html or last_html
                        ok(f"已检测到新的登录 ({account_key(site) or site})")
                        return cookie, ua, html
                    if ready and not seen_logged_out:
                        now = time.time()
                        if now - last_hint > 8:
                            info("窗口里还是旧账号。请点 Logout，再登录新账号")
                            last_hint = now
                    else:
                        seen_logged_out = True
                        if cookie:
                            last_cookie, last_ua, last_html = cookie, ua, html or last_html
                        if is_codeforces(site):
                            now = time.time()
                            if now - last_hint > 12:
                                names = cookie_names(cookie)
                                if not names:
                                    info(f"还没读到 Codeforces Cookie。当前配置: {profile}")
                                elif not names.get("X-User") and not names.get("X-User-Sha1"):
                                    info("已读到 Cookie，但还没有登录态。请在窗口右上角点 Enter 登录")
                                else:
                                    info("已读到登录 Cookie，正在确认…")
                                last_hint = now
                    time.sleep(1.2)
                if seen_logged_out and _session_ready(last_cookie, last_html, site=site):
                    return last_cookie, last_ua, last_html
            finally:
                if not keep_browser:
                    try:
                        proc.terminate()
                    except Exception:
                        pass
    finally:
        try:
            httpd.shutdown()
        except Exception:
            pass
    return None


def login_via_browser(site: str) -> Tuple[str, str, str]:
    got = _login_real_browser(site)
    if got:
        cookie, ua, html = got
        if is_codeforces(site):
            if looks_logged_in(html, url=site) or _cf_cookie_logged_in(cookie):
                info("已用普通浏览器完成登录")
                return cookie, ua, html
        elif cookie_names(cookie).get("UOJSESSID") or looks_logged_in(html):
            info("已用普通浏览器完成登录")
            return cookie, ua, html
    hint = "python3 submit login cf" if is_codeforces(site) else "python3 submit login"
    die(
        f"未能用普通 Firefox 登录。请关掉弹出窗口后重试:\n"
        f"  {hint}\n"
        "不要用带“自动化控制”提示的窗口。"
    )
    raise AssertionError


def _finalize_login(
    cfg: dict,
    site: str,
    cookie: str,
    ua: str,
    debug: bool,
    fallback_user: str = "",
) -> None:
    cookie = parse_cookie_input(cookie)
    names = cookie_names(cookie)
    client = Client(site, cookie=cookie, user_agent=ua, debug=debug)
    if is_codeforces(site):
        status, url, page = client.get("/enter", fatal=False)
        if _is_cloudflare_block(page):
            try:
                status, url, page = client.get("/", fatal=False)
            except Exception:
                pass
        logged = looks_logged_in(page, url) or _cf_cookie_logged_in(cookie)
        if not logged:
            die(
                "还没有登录 Codeforces。请在弹出窗口右上角点 Enter 登录后，再执行:\n"
                "  python3 submit login cf"
            )
        if _is_cloudflare_block(page) and logged:
            warn("命令行页面仍像 Cloudflare，但浏览器 Cookie 已是登录态，先保存会话")
        username = extract_cf_handle(page) or extract_cf_handle_from_url(url) or fallback_user or ""
        if not username:
            try:
                _, purl, ppage = client.get("/profile", fatal=False)
                username = (
                    extract_cf_handle(ppage)
                    or extract_cf_handle_from_url(purl)
                    or username
                )
            except Exception:
                pass
        if not username:
            username = _cf_handle_from_firefox_profile(
                _firefox_default_profile("", "codeforces.com")
            )
        save_account(cfg, site, client.cookie_header() or cookie, ua, username)
        ok(f"已登录 {username or '(未知用户)'} @ {site}")
        info(f"配置保存在 {global_config_path()}")
        return
    expect = names.get("uoj_username") or fallback_user or ""
    status, url, page = client.get("/")
    if not looks_logged_in(page, url, expect=expect):
        extra = "/enter" if is_codeforces(site) else "/login"
        status, url, page = client.get(extra)
        if not looks_logged_in(page, url, expect=expect):
            die(
                "浏览器里看起来已经登录，但命令行请求仍未带上会话。\n"
                "请再试一次 ./submit login，或确认弹出的窗口里确实登录成功。"
            )
    username = extract_username(page) or expect or get_account(cfg, site).get("username") or ""
    save_account(cfg, site, client.cookie_header() or cookie, ua, username)
    ok(f"已登录 {username or '(未知用户)'} @ {site}")
    info(f"配置保存在 {global_config_path()}")


def _read_multiline_cookie() -> str:
    print("Cookie（粘贴一行 header 或 JSON；输入空行结束）:")
    lines: List[str] = []
    while True:
        try:
            line = input()
        except EOFError:
            break
        if not line.strip() and lines:
            break
        if not line.strip() and not lines:
            return ""
        lines.append(line)
        blob = "\n".join(lines).strip()
        if blob.startswith("{") and blob.count("{") <= blob.count("}"):
            try:
                json.loads(blob)
                break
            except json.JSONDecodeError:
                continue
        if blob.startswith("[") and blob.count("[") <= blob.count("]"):
            try:
                json.loads(blob)
                break
            except json.JSONDecodeError:
                continue
    return "\n".join(lines).strip()


def _prompt_cookie_login(site: str) -> Tuple[str, str]:
    if is_codeforces(site):
        print(
            "Codeforces 请用你平时能打开的浏览器登录，再把 Cookie 贴进来\n"
            "（插件自带的 Firefox 会被 Cloudflare 卡住）。\n"
            "\n"
            "  1. 打开 https://codeforces.com 并登录\n"
            "  2. F12 → Network → 刷新 → 点开任意 codeforces.com 请求\n"
            "  3. 复制 Request Headers 里的整段 Cookie\n"
            "     不要用 document.cookie，会缺 HttpOnly（如 JSESSIONID）\n"
            "  4. 同一请求里再复制 User-Agent\n"
        )
    else:
        print("手动粘贴 Cookie。有 cf_clearance 时必须同时提供同一浏览器的 User-Agent。")
    cookie = _read_multiline_cookie()
    if not cookie:
        die("没有读到 Cookie")
    ua_in = input("User-Agent（与 Cookie 同一浏览器；直接回车则用已保存的）: ").strip()
    return cookie, ua_in


def cmd_login(args: argparse.Namespace) -> None:
    cfg = load_global()
    if getattr(args, "oj", None) or args.site:
        site = resolve_site(args.site or args.oj)
    else:
        site = (cfg.get("site") or DEFAULT_SITE).rstrip("/")
    info(f"登录 {oj_label(site)}  ({site})")
    ua = args.user_agent or get_account(cfg, site).get("user_agent") or cfg.get("user_agent") or DEFAULT_UA
    cookie = args.cookie
    if args.cookie_file:
        cookie = Path(args.cookie_file).read_text(encoding="utf-8").strip()

    want_browser = bool(getattr(args, "browser", False))
    if not cookie and not args.username and (want_browser or not args.manual):
        prev = get_account(cfg, site).get("username") or ""
        if prev:
            info(f"本地 {account_key(site)} 当前是 {prev}，先退出再登录新账号")
        _forget_saved_login(cfg, site)
        cookie, ua, html = login_via_browser(site)
        fallback = (
            extract_cf_handle(html)
            or extract_username(html)
            or cookie_names(cookie).get("uoj_username")
            or ""
        )
        _finalize_login(cfg, site, cookie, ua, args.debug, fallback_user=fallback)
        return

    if not cookie and not args.username:
        cookie, ua_in = _prompt_cookie_login(site)
        if ua_in:
            ua = ua_in
        elif is_codeforces(site) and ua == DEFAULT_UA:
            die("Codeforces 必须粘贴与 Cookie 同一浏览器的 User-Agent")
    if cookie:
        cookie = parse_cookie_input(cookie)
        names = cookie_names(cookie)
        if "cf_clearance" in names and ua == DEFAULT_UA:
            die(
                "Cookie 里有 cf_clearance，但 User-Agent 还是脚本默认值。\n"
                "请粘贴同一浏览器的 User-Agent，或加上 --user-agent"
            )
        if not is_codeforces(site) and "UOJSESSID" not in names and "uoj_remember_token" not in names:
            warn("没有看到 UOJSESSID / uoj_remember_token，登录可能失败")
        if is_codeforces(site) and "JSESSIONID" not in names:
            die(
                "这段 Cookie 里没有 JSESSIONID，还没带上 Codeforces 登录态。\n"
                "请用 F12 → Network → 点开任意 codeforces.com 请求 → Request Headers 里的 Cookie。\n"
                "不要从 Application/存储面板或 document.cookie 导出（会缺 HttpOnly）。"
            )
        _finalize_login(
            cfg,
            site,
            cookie,
            ua,
            args.debug,
            fallback_user=names.get("uoj_username") or "",
        )
        return

    if is_codeforces(site):
        die("Codeforces 请用窗口登录:  python3 submit login cf")

    username = args.username or input("用户名: ").strip()
    password = args.password or getpass.getpass("密码: ")
    if not username or not password:
        die("用户名和密码不能为空")
    client = Client(site, user_agent=ua, debug=args.debug)
    status, url, page = client.get("/login")
    token = extract_token(page)
    if not token:
        warn("没有解析到 CSRF token，仍尝试登录")
    hashed = md5_hex(password)
    fields = {
        "_token": token,
        "login": "",
        "username": username,
        "password": hashed,
    }
    status, url, resp = client.post_form("/login", fields, referer=urljoin(site, "/login"))
    if resp.strip() != "ok":
        fields["password"] = hmac_md5_hex(token, password)
        status, url, resp = client.post_form("/login", fields, referer=urljoin(site, "/login"))
    if resp.strip() != "ok":
        fields["password"] = password
        status, url, resp = client.post_form("/login", fields, referer=urljoin(site, "/login"))
    if resp.strip() != "ok":
        die(
            "用户名密码登录失败（QOJ 有 Cloudflare）。请改用窗口登录:\n"
            f"  python submit login\n服务器返回: {resp.strip()[:200]!r}"
        )
    status, url, home = client.get("/")
    handle = extract_username(home) or username
    cfg.update({
        "site": site,
        "cookie": client.cookie_header(),
        "user_agent": ua,
        "username": handle,
    })
    save_global(cfg)
    ok(f"已登录 {handle} @ {site}")
    info(f"配置保存在 {global_config_path()}")


