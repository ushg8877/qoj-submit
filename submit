def cmd_whoami(args: argparse.Namespace) -> None:
    if getattr(args, "timeout", 15) <= 0:
        die("--timeout 必须大于 0")
    if args.debug:
        print(f"DEBUG script={Path(__file__).resolve()} version={VERSION}", file=sys.stderr)
    cfg = load_global()
    site = (cfg.get("site") or DEFAULT_SITE).rstrip("/")
    acc = get_account(cfg, site)
    hint = "python3 submit login cf" if is_codeforces(site) else "python3 submit login"
    if not acc.get("cookie"):
        die(f"{account_key(site)} 未登录。请先: {hint}")
    username = acc.get("username") or cookie_names(acc["cookie"]).get("uoj_username") or ""
    if not getattr(args, "check", False):
        ok(f"{username or '(未知账号)'} @ {site}（本地记录，未联网验证）")
        info("验证登录是否有效: ./submit whoami --check")
        return
    client = Client(site, cookie=acc["cookie"],
                    user_agent=acc.get("user_agent") or cfg.get("user_agent") or DEFAULT_UA,
                    debug=args.debug)
    info("正在验证登录状态...")
    try:
        status, url, page = client.get("/", timeout=getattr(args, "timeout", 15), retries=1, fatal=False)
    except (TimeoutError, OSError) as exc:
        die(f"登录验证失败: {exc}。网络异常，无法判断 Cookie 是否有效")
    if _is_cloudflare_block(page) or status != 200:
        die(f"登录验证失败（HTTP {status} 或页面被拦截），无法判断 Cookie 是否有效")
    if not looks_logged_in(page, url, expect=username):
        die(f"未能确认登录状态，请在浏览器检查或重新运行: {hint}")
    username = extract_username(page) or extract_cf_handle_from_url(url) or username or "?"
    ok(f"{username} @ {site}（已联网验证）")


def parse_contest_ref(
    raw: str, cfg: dict, site_override: Optional[str] = None
) -> Tuple[str, str, str]:
    text = (raw or "").strip()
    m = re.search(r"(https?://[^/]+)/(contest|gym)/(\d+)", text)
    if m:
        return m.group(1).rstrip("/"), m.group(3), m.group(2)
    if re.fullmatch(r"\d+", text):
        if site_override:
            site = resolve_site(site_override, cfg)
        else:
            site = (cfg.get("site") or DEFAULT_SITE).rstrip("/")
        return site, text, "contest"
    die("请输入比赛 UID，例如 1234 或 https://codeforces.com/contest/2044")
    raise AssertionError


def bind_contest(
    raw: str,
    *,
    site: Optional[str] = None,
    kind: Optional[str] = None,
    template: bool = False,
    debug: bool = False,
    quiet: bool = False,
) -> dict:
    cfg = load_global()
    site, contest_id, parsed_kind = parse_contest_ref(raw, cfg, site)
    kind = kind or parsed_kind or "contest"
    if kind not in ("contest", "gym"):
        kind = "contest"
    if is_codeforces(site):
        contest_url = f"{site}/{kind}/{contest_id}"
    else:
        contest_url = f"{site}/contest/{contest_id}"
        kind = "contest"
    client = make_client(cfg, {"site": site}, debug=debug)
    page = ""
    url = contest_url
    problems: Dict[str, dict] = {}
    name = ""
    if is_codeforces(site):
        got = fetch_cf_contest_via_api(client, site, contest_id, kind)
        if got:
            name, problems = got
    if not problems:
        try:
            status, url, page = client.get(contest_url, timeout=10, retries=0, fatal=False)
        except (TimeoutError, OSError) as exc:
            die(f"打开比赛页超时: {exc}")
        expect = get_account(cfg, site).get("username") or ""
        if not looks_logged_in(page, url, expect=expect) and (
            "/login" in url or "/enter" in url
        ):
            hint = "python3 submit login cf" if is_codeforces(site) else "python3 submit login"
            die(f"未登录或 Cookie 失效，请先 {hint}")
        problems = parse_contest_problems(page, site, contest_id, kind)
        if not problems:
            hint = "python3 submit login cf" if is_codeforces(site) else "python3 submit login"
            die(f"没有解析到题目。请确认已经登录（{hint}），且比赛 UID 正确")
        name = parse_contest_name(page, site, contest_id)
    expect = get_account(cfg, site).get("username") or ""
    if not name or _is_junk_contest_name(name):
        name = f"Contest {contest_id}"
    username = extract_username(page) or expect
    data = {
        "site": site,
        "contest_id": contest_id,
        "contest_url": contest_url,
        "kind": kind,
        "name": name,
        "username": username,
        "problems": problems,
    }
    dest_dir = Path.cwd()
    contest_path = dest_dir / CONTEST_FILE
    save_json(contest_path, data)
    cfg["site"] = site
    cfg["contest"] = data
    save_global(cfg)
    copied = copy_self_to(dest_dir)
    if template:
        _write_templates(dest_dir, problems.keys())
    if not quiet:
        ok(f"已绑定比赛: {name}")
        info(f"UID: {contest_id}  {contest_url}")
        info(f"配置: {contest_path}")
        if copied:
            info(f"提交命令: {copied}")
        _print_problems(problems)
        print()
        info("接下来:  python3 submit a.cpp")
    return data


def cmd_init(args: argparse.Namespace) -> None:
    bind_contest(
        args.url,
        site=getattr(args, "site", None),
        template=bool(getattr(args, "template", False)),
        debug=bool(getattr(args, "debug", False)),
    )


def _page_title(page: str) -> str:
    m = re.search(r"<title>(.*?)</title>", page, re.I | re.S)
    return strip_html(m.group(1)) if m else ""


def _is_cloudflare_block(page: str) -> bool:
    """True only for a full-page Cloudflare interstitial, not CF scripts on a real QOJ page."""
    if looks_logged_in(page) or _cf_login_form(page) or re.search(
        r'id=["\']form-login["\']', page or "", re.I
    ):
        return False
    title = _page_title(page).lower()
    if "just a moment" in title or title.strip() == "attention required!":
        return True
    if re.search(r'id=["\'](?:challenge-running|challenge-error-title)["\']', page, re.I):
        return True
    head = strip_html(page)[:500].lower()
    if "checking your browser before accessing" in head:
        return True
    if "verify you are human" in head and "qoj" not in title and "codeforces" not in title:
        return True
    return False


def _has_submit_form(page: str) -> bool:
    if re.search(r"<textarea\b[^>]*name=[\"']answer_answer_editor[\"']", page, re.I):
        return True
    if re.search(r"<select\b[^>]*name=[\"'][^\"']*answer[^\"']*language[\"']", page, re.I):
        return True
    if re.search(r"<(?:input|button)\b[^>]*name=[\"']submit-answer[\"']", page, re.I):
        return True
    return False


def _fetch_problem_submit_page(
    client: Client,
    contest: dict,
    problem: dict,
    on_fetch=None,
) -> Tuple[str, int, str, str]:
    """Return (post_url, status, final_url, html). post_url is where the Submit form posts."""
    site = contest.get("site") or client.site
    contest_id = str(contest.get("contest_id") or "")
    pid = str(problem.get("id") or "")
    base = canonical_problem_url(problem.get("url") or "")
    if not re.search(r"/problem/\d+$", base):
        base = f"{site.rstrip('/')}/contest/{contest_id}/problem/{pid}"
    seen: set = set()
    queue = problem_page_candidates(base, site, contest_id, pid)
    last = (404, base, "")
    best_post = base
    best_page = ""
    best_final = base
    best_status = 404
    deadline = time.monotonic() + 30
    last_error = None
    while queue and len(seen) < 5:
        url = queue.pop(0)
        if url in seen:
            continue
        seen.add(url)
        if on_fetch:
            on_fetch(url)
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        try:
            status, final, page = client.get(url, timeout=min(15, remaining), retries=1, fatal=False)
        except (TimeoutError, OSError) as exc:
            last_error = exc
            continue
        last = (status, final, page)
        for extra in iter_submit_hrefs(page, final or url):
            if extra not in seen:
                queue.insert(0, extra)
        action = extract_form_action(page, final or url)
        if status == 200 and extract_token(page) and _has_submit_form(page):
            post_to = action or (final or url).split("#")[0]
            return post_to, status, final, page
        if not best_page and looks_logged_in(page, final):
            best_post = action or (final or url).split("#")[0]
            best_page = page
            best_final = final
            best_status = status
    if best_page:
        return best_post, best_status, best_final, best_page
    if last_error and not last[2]:
        raise last_error
    status, final, page = last
    return (final or base).split("#")[0], status, final, page


def _explain_missing_submit(
    status: int, url: str, page: str, contest_url: str, expect: str = ""
) -> str:
    title = _page_title(page)
    snippet = re.sub(r"\s+", " ", strip_html(page))[:240]
    lines = [f"打不开提交页 (HTTP {status}, {url})"]
    if title:
        lines.append(f"页面标题: {title}")
    if _is_cloudflare_block(page):
        lines.append("原因: Cloudflare 拦截。请重新: python3 submit login")
    elif "/login" in (url or "") or re.search(r'id=["\']form-login["\']', page, re.I):
        lines.append("原因: 未登录或 Cookie 已过期。请先: python3 submit login")
    elif not looks_logged_in(page, url, expect=expect):
        lines.append("原因: 页面看起来未登录。请: python3 submit whoami")
    else:
        lines.append("题目页没有提交表单。请用浏览器打开题目，确认能看到 Submit。")
        lines.append(f"  {url}")
    if snippet:
        lines.append(f"页面摘要: {snippet}")
    return "\n".join(lines)


