def _is_junk_contest_name(name: str) -> bool:
    text = re.sub(r"\s+", " ", (name or "").strip())
    if not text:
        return True
    if len(text) > 100:
        return True
    low = text.lower()
    if low in _JUNK_CONTEST_NAMES:
        return True
    if low.startswith("submit "):
        return True
    if re.match(r"^[a-z]{1,2}\d*\.\s+", low):
        return True
    if re.search(
        r"function\s*\(|\{\s*|\$\(|javascript:|data-page-url|"
        r"virtual contest is a way|clone this contest|sidebar-caption",
        low,
    ):
        return True
    return False


def contest_display_name(contest: dict) -> str:
    name = str(contest.get("name") or "").strip()
    if name and not _is_junk_contest_name(name):
        return name
    cid = contest.get("contest_id")
    if cid:
        return f"Contest {cid}"
    return name or "Contest"


def parse_contest_name(page: str, site: str = "", contest_id: str = "") -> str:
    cf = is_codeforces(site) or bool(re.search(r"\bcodeforces\b", page[:2000] or "", re.I))
    m = re.search(r"<title>(.*?)</title>", page, re.I | re.S)
    if m:
        title = strip_html(m.group(1))
        if cf or re.search(r"\bcodeforces\b", title, re.I):
            parts = [p.strip() for p in re.split(r"\s*[-–—|]\s*", title) if p.strip()]
            for part in parts:
                if not _is_junk_contest_name(part):
                    return part
        title = re.sub(r"\s*[-|].*$", "", title).strip()
        if title and not _is_junk_contest_name(title):
            return title
    if contest_id:
        cid = re.escape(str(contest_id))
        for m in re.finditer(
            rf'href=["\'][^"\']*/(?:contest|gym)/{cid}(?:/?|[?#][^"\']*)?["\'][^>]*>\s*([^<]{{1,80}})\s*</a>',
            page or "",
            re.I,
        ):
            name = strip_html(m.group(1)).strip()
            if name and not _is_junk_contest_name(name):
                return name
    m = re.search(r"<h1\b[^>]*>([^<]{1,80})</h1>", page, re.I)
    if m:
        name = strip_html(m.group(1)).strip()
        if name and not _is_junk_contest_name(name):
            return name
    return ""


def _uoj_status_text(html: str) -> str:
    m = re.search(
        r'class=["\'][^"\']*uoj-status[^"\']*["\'][^>]*>(.*?)</(?:a|span|div|td|b)',
        html or "",
        re.I | re.S,
    )
    if m:
        return strip_html(m.group(1))
    return ""


def parse_submission_rows(page: str) -> List[dict]:
    rows = []
    seen = set()
    for tr in re.findall(r"<tr\b[^>]*>(.*?)</tr>", page, re.I | re.S):
        sid_m = re.search(r"/submission/(\d+)", tr)
        if not sid_m:
            continue
        sid = sid_m.group(1)
        if sid in seen:
            continue
        seen.add(sid)
        links = [(htmlmod.unescape(h), strip_html(t)) for h, t in re.findall(
            r'<a\b[^>]*href=["\']([^"\']+)["\'][^>]*>(.*?)</a>', tr, re.I | re.S
        )]
        problem = ""
        problem_id = ""
        contest_id = ""
        submitter = ""
        for href, text in links:
            if not contest_id:
                cm = re.search(r"/contest/(\d+)", href)
                if cm:
                    contest_id = cm.group(1)
            if not problem_id:
                pm = re.search(r"/problem/(\d+)", href)
                if pm:
                    problem_id = pm.group(1)
                    problem = text
            if not submitter:
                um = re.search(r"/user/profile/([^/?#'\"]+)", href)
                if um:
                    submitter = htmlmod.unescape(um.group(1))
        cells = [strip_html(td) for td in re.findall(r"<td\b[^>]*>(.*?)</td>", tr, re.I | re.S)]
        status = _uoj_status_text(tr)
        if not status:
            for cell in cells:
                low = cell.lower()
                if any(k in low for k in (
                    "accept", "wrong", "error", "limit", "judg", "wait", "compil",
                    "runtime", "point", "score", "正确", "错误", "超限", "评测", "等待",
                )):
                    status = cell
                    break
        if not status and len(cells) >= 5:
            status = cells[4] if len(cells) > 4 else cells[-1]
        rows.append({
            "id": sid,
            "problem": problem,
            "problem_id": problem_id,
            "contest_id": contest_id,
            "submitter": submitter,
            "status": status or "?",
            "cells": cells,
            "submit_ts": _parse_submit_clock(cells),
            "url_path": f"/submission/{sid}",
        })
    return rows


def _contest_problem_ids(contest: dict) -> set:
    ids = set()
    for item in (contest.get("problems") or {}).values():
        pid = str((item or {}).get("id") or "")
        if pid:
            ids.add(pid)
    return ids


def _contest_problem_label(contest: dict, row: dict) -> str:
    pid = str(row.get("problem_id") or "")
    for letter, item in (contest.get("problems") or {}).items():
        if str((item or {}).get("id") or "") == pid:
            title = str((item or {}).get("title") or "").strip()
            return f"{letter}. {title}" if title else str(letter)
    return str(row.get("problem") or pid or "")


def _submission_row_matches(
    row: dict,
    contest: dict,
    problem_id: Optional[str] = None,
) -> bool:
    username = str(contest.get("username") or "")
    submitter = str(row.get("submitter") or "")
    if username and submitter and submitter != username:
        return False
    cid = str(contest.get("contest_id") or "")
    row_cid = str(row.get("contest_id") or "")
    if cid and row_cid and row_cid != cid:
        return False
    want = str(problem_id or "")
    row_pid = str(row.get("problem_id") or "")
    if want:
        return (not row_pid) or row_pid == want
    known = _contest_problem_ids(contest)
    if known and row_pid:
        return row_pid in known
    return True


def _parse_submit_clock(cells: List[str]) -> Optional[float]:
    for cell in cells or []:
        m = re.search(r"(20\d{2}-\d{2}-\d{2}\s+\d{2}:\d{2}(?::\d{2})?)", cell)
        if not m:
            continue
        text = m.group(1)
        for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M"):
            try:
                return time.mktime(time.strptime(text, fmt))
            except ValueError:
                continue
    return None


def parse_submission_status(page: str) -> dict:
    text = strip_html(page)
    status = _uoj_status_text(page)
    scoped = re.search(
        r'class=["\'][^"\']*(?:uoj-status|submission-status|verdict)[^"\']*["\'][^>]*>(.*?)</',
        page,
        re.I | re.S,
    )
    blob = strip_html(scoped.group(1)) if scoped else (status or page)
    fail_re = (
        r"(Wrong Answer|Time Limit Exceeded|Memory Limit Exceeded|Runtime Error|"
        r"Compile Error|Compilation Error|Output Limit Exceeded|"
        r"Dangerous Syscall|System Error|Partially Correct|"
        r"答案错误|时间超限|内存超限|运行错误|编译错误|输出超限)"
    )
    fail = re.search(fail_re, blob, re.I)
    if not fail:
        for sm in re.finditer(
            r'class=["\'][^"\']*uoj-status[^"\']*["\'][^>]*>(.*?)</',
            page or "",
            re.I | re.S,
        ):
            fail = re.search(fail_re, strip_html(sm.group(1)), re.I)
            if fail:
                break
    if fail:
        status = strip_html(fail.group(1))
    elif not status or _test_pending(status):
        ac = None
        for sm in re.finditer(
            r'class=["\'][^"\']*uoj-status[^"\']*["\'][^>]*>(.*?)</',
            page or "",
            re.I | re.S,
        ):
            piece = strip_html(sm.group(1))
            if re.search(r"(Accepted|正确)", piece, re.I) and not _test_pending(piece):
                ac = piece
                break
        if ac:
            status = ac
        elif not status:
            pend = re.search(
                r"(Judging|Waiting|Compiling|Pending|评测中|等待评测|编译中)",
                blob,
                re.I,
            )
            if pend:
                status = strip_html(pend.group(1))
    score_m = re.search(r"\b(\d{1,3})\s*(?:/|&nbsp;/&nbsp;|/)\s*100\b", text)
    if not score_m:
        score_m = re.search(r"(?:score|分数|得分)\s*[:：]?\s*(\d{1,3})\b", text, re.I)
    time_m = re.search(r"(\d+(?:\.\d+)?)\s*ms", text, re.I)
    mem_m = re.search(r"(\d+(?:\.\d+)?)\s*(?:KB|KiB|MB|MiB)", text, re.I)
    score = score_m.group(1) if score_m else ""
    low = (status or "").lower()
    failed = bool(fail)
    pending = (not status) or any(h in low for h in PENDING_HINTS)
    if failed or any(
        v in low for v in ("accepted", "正确", "wrong", "error", "exceeded", "编译错误", "答案")
    ):
        pending = False
    if "compile error" in low or "compilation error" in low:
        pending = False
    if (
        not failed
        and pending
        and score == "100"
        and re.search(r"\b100\s*/\s*100\b", text)
    ):
        pending = False
        status = "Accepted"
    return {
        "status": status or "Judging",
        "score": score,
        "time": time_m.group(0) if time_m else "",
        "memory": mem_m.group(0) if mem_m else "",
        "pending": pending,
    }


TEST_VERDICT_RE = (
    r"(Compile Error|Compilation Error|Accepted|Wrong Answer|"
    r"Time Limit Exceeded|Memory Limit Exceeded|Runtime Error|"
    r"Output Limit Exceeded|Dangerous Syscall|System Error|"
    r"Partially Correct|Skipped|Judging|Waiting|Compiling|Pending|"
    r"编译错误|答案错误|时间超限|内存超限|运行错误|输出超限|正确|评测中|等待评测|编译中)"
)


def _cell_time(text: str) -> str:
    m = re.search(r"(\d+(?:\.\d+)?)\s*ms", text or "", re.I)
    return m.group(0) if m else ""


def _cell_memory(text: str) -> str:
    m = re.search(r"(\d+(?:\.\d+)?)\s*(?:KB|KiB|MB|MiB)", text or "", re.I)
    return m.group(0) if m else ""


def _test_pending(status: str) -> bool:
    low = (status or "").lower()
    if not status:
        return True
    return any(
        h in low
        for h in ("waiting", "judging", "pending", "compiling", "评测中", "等待评测", "编译中")
    )


def _split_submission_html(page: str) -> Tuple[str, str]:
    m = re.search(
        r'(id=["\'](?:details|status-details|testdata)["\']|>\s*Testdata\s*<|测试点详情)',
        page or "",
        re.I,
    )
    if m:
        return page[: m.start()], page[m.start() :]
    m = re.search(r"<tr\b[^>]*>[\s\S]{0,80}#\s*1\b", page or "", re.I)
    if m:
        return page[: m.start()], page[m.start() :]
    return page or "", page or ""


def parse_submission_tests(page: str, sid: str = "") -> List[dict]:
    tests: List[dict] = []
    seen = set()
    sid = str(sid or "").lstrip("#")

    def valid_idx(idx: str) -> bool:
        if not str(idx).isdigit():
            return False
        n = int(idx)
        if n < 1 or n > 999:
            return False
        if sid and str(n) == sid:
            return False
        return True

    def add(idx: str, status: str, time_s: str, mem_s: str) -> None:
        if not valid_idx(idx):
            return
        idx = str(int(idx))
        status = (status or "").strip()
        item = {
            "id": idx,
            "status": status or "Judging",
            "time": time_s or "",
            "memory": mem_s or "",
            "pending": _test_pending(status),
        }
        if idx in seen:
            for old in tests:
                if old["id"] == idx:
                    if status and not _test_pending(status):
                        old.update(item)
                    elif not old.get("time") and time_s:
                        old.update(item)
                    break
            return
        seen.add(idx)
        tests.append(item)

    for tr in re.findall(r"<tr\b[^>]*>(.*?)</tr>", page or "", re.I | re.S):
        if re.search(r"/submission/\d+", tr):
            continue
        raw_cells = re.findall(r"<t[dh]\b[^>]*>(.*?)</t[dh]>", tr, re.I | re.S)
        cells = [strip_html(td) for td in raw_cells]
        joined = " ".join(cells)
        if re.search(r"subtask", joined, re.I) and not re.search(r"#\s*\d{1,3}\b", joined):
            continue
        idx = ""
        for cell in cells[:3]:
            if re.search(r"subtask", cell, re.I):
                continue
            m = re.search(
                r"^(?:#|test(?:\s*case)?|测试点?)?\s*(\d{1,3})$",
                cell,
                re.I,
            )
            if m and valid_idx(m.group(1)):
                idx = m.group(1)
                break
        if not idx:
            continue
        status = _uoj_status_text(tr)
        if not status:
            m = re.search(TEST_VERDICT_RE, joined, re.I)
            if m:
                status = m.group(1)
        if not status and not _cell_time(joined):
            continue
        add(idx, status, _cell_time(joined), _cell_memory(joined))

    if not tests:
        text = strip_html(page or "")
        for m in re.finditer(
            rf"(?:#|测试点)\s*(\d{{1,3}})\b\s*[:.\s]+{TEST_VERDICT_RE}"
            r"(?:\s+(\d+(?:\.\d+)?\s*ms))?"
            r"(?:\s+(\d+(?:\.\d+)?\s*(?:KB|KiB|MB|MiB)))?",
            text,
            re.I,
        ):
            add(m.group(1), m.group(2), m.group(3) or "", m.group(4) or "")
        prog = re.search(
            r"(?:Judging(?:\s+on)?\s+test|评测(?:中)?(?:到)?(?:第)?(?:测试点)?)\s*#?\s*(\d{1,3})\b",
            text,
            re.I,
        )
        if prog and valid_idx(prog.group(1)) and prog.group(1) not in seen:
            add(prog.group(1), "Judging", "", "")
    tests.sort(key=lambda t: int(t["id"]) if str(t["id"]).isdigit() else 10**9)
    return tests


def _is_ac_status(status: str) -> bool:
    low = (status or "").lower()
    return ("accepted" in low or "正确" in low) and "wrong" not in low


def parse_submission_detail(page: str, sid: str = "") -> dict:
    head, details = _split_submission_html(page)
    overall = parse_submission_status(head)
    tests = parse_submission_tests(details, sid=sid)
    if not tests:
        tests = parse_submission_tests(page, sid=sid)
    current = tests[-1] if tests else None
    tests_pending = bool(tests) and any(t.get("pending") for t in tests)
    tests_done = bool(tests) and not tests_pending
    pending = bool(overall.get("pending"))
    if tests_pending:
        pending = True
    if tests_done:
        pending = False
        if overall.get("pending") or _test_pending(overall.get("status") or ""):
            fails = [t for t in tests if not _is_ac_status(t.get("status") or "")]
            if fails:
                overall = dict(overall)
                overall["status"] = fails[0]["status"]
                overall["pending"] = False
                if fails[0].get("time"):
                    overall["time"] = fails[0]["time"]
                if fails[0].get("memory"):
                    overall["memory"] = fails[0]["memory"]
            else:
                overall = dict(overall)
                overall["status"] = "Accepted"
                overall["pending"] = False
    return {
        "overall": overall,
        "tests": tests,
        "current": current,
        "pending": pending,
        "judged": len([t for t in tests if not t.get("pending")]),
    }


def md5_hex(s: str) -> str:
    return hashlib.md5(s.encode("utf-8")).hexdigest()


def hmac_md5_hex(key: str, data: str) -> str:
    return hmac.new(key.encode("utf-8"), data.encode("utf-8"), hashlib.md5).hexdigest()


def make_client(cfg: dict, contest: Optional[dict] = None, debug: bool = False) -> Client:
    site = (contest or {}).get("site") or cfg.get("site") or DEFAULT_SITE
    acc = get_account(cfg, site)
    cookie = acc.get("cookie") or ""
    ua = acc.get("user_agent") or cfg.get("user_agent") or DEFAULT_UA
    if not cookie:
        hint = "python3 submit login cf" if is_codeforces(str(site)) else "python3 submit login"
        die(
            f"尚未登录 {site}。先运行: {hint}\n"
            f"配置文件: {global_config_path()}"
        )
    return Client(site, cookie=cookie, user_agent=ua, debug=debug)


def require_contest() -> Tuple[Path, dict]:
    path = find_contest_file()
    if path:
        return path, load_json(path)
    cfg = load_global()
    cached = cfg.get("contest")
    if isinstance(cached, dict) and cached.get("problems"):
        return global_config_path(), cached
    try:
